---
import OfferNotes from "./OfferNotes.astro";
import SalutationSelect from "./SalutationSelect.astro";
import {
  OFFER_BANK_LINES,
  OFFER_DEFAULT_INTRO,
  OFFER_HOURLY_INTRO,
  OFFER_UNIT_LABELS,
  OFFER_UNITS,
  offerBilling,
  type OfferBilling,
  type OfferUnit,
} from "../lib/quote";

interface ComposerLine {
  label: string;
  quantity: string;
  unit: OfferUnit;
  price: string;
}

interface Props {
  customerName: string;
  title?: string;
  validUntil: string;
  hidden?: Array<{ name: string; value: string }>;
  billing?: OfferBilling;
  lines?: ComposerLine[];
  intro?: string;
  salutation?: string;
  action?: string;
}

const {
  customerName,
  title = "",
  validUntil,
  hidden = [],
  intro = "",
  salutation = "hallo_name",
  action = "/api/admin/angebot",
} = Astro.props;
const billing = offerBilling(Astro.props.billing);
const festLines: ComposerLine[] = Astro.props.lines && billing === "fest"
  ? Astro.props.lines
  : [{ label: "Stundenlohn", quantity: "", unit: "stunde", price: "" }];
const hourLines: ComposerLine[] = [
  { label: "Arbeitslohn", quantity: "", unit: "stunde", price: "" },
  { label: "Material", quantity: "1", unit: "pauschal", price: "" },
  { label: "Anfahrt", quantity: "1", unit: "pauschal", price: "" },
];
const visible = billing === "stunden" ? (Astro.props.lines ?? hourLines) : festLines;
const festSnapshot = billing === "fest" ? visible : festLines;
---

<form
  id="offer-form"
  method="POST"
  action={action}
  class="grid gap-4"
  data-fest-lines={JSON.stringify(festSnapshot)}
  data-hour-lines={JSON.stringify(hourLines)}
>
  {hidden.map((field) => <input type="hidden" name={field.name} value={field.value} />)}
  <fieldset>
    <legend class="label">Art</legend>
    <div class="mt-2 flex flex-wrap gap-2">
      <label class="cursor-pointer rounded-full border border-ink-200 bg-white px-3 py-1.5 text-xs font-semibold text-ink-800 has-[:checked]:border-ink-900 has-[:checked]:bg-ink-900 has-[:checked]:text-white dark:border-white/10 dark:bg-white/5 dark:text-ink-100 dark:has-[:checked]:border-white dark:has-[:checked]:bg-white dark:has-[:checked]:text-ink-900">
        <input class="sr-only" type="radio" name="billing" value="fest" checked={billing === "fest"} />
        Festpreis
      </label>
      <label class="cursor-pointer rounded-full border border-ink-200 bg-white px-3 py-1.5 text-xs font-semibold text-ink-800 has-[:checked]:border-ink-900 has-[:checked]:bg-ink-900 has-[:checked]:text-white dark:border-white/10 dark:bg-white/5 dark:text-ink-100 dark:has-[:checked]:border-white dark:has-[:checked]:bg-white dark:has-[:checked]:text-ink-900">
        <input class="sr-only" type="radio" name="billing" value="stunden" checked={billing === "stunden"} />
        Nach Stunden
      </label>
    </div>
  </fieldset>
  <p id="offer-billing-hint" class:list={["text-sm text-ink-600 dark:text-ink-300", billing !== "stunden" && "hidden"]}>
    Material, Anfahrt und weitere Positionen sind feste Beträge. Der Arbeitslohn kommt aus Stunden mal Stundensatz dazu.
  </p>
  <div>
    <label class="label" for="offer-title">Betreff</label>
    <input class="input" id="offer-title" name="title" required minlength="3" maxlength="120" value={title} />
  </div>
  <div class="flex flex-wrap gap-2">
    <button type="button" data-preset="stunde" class="rounded-full border border-ink-200 bg-white px-3 py-1.5 text-xs font-semibold text-ink-800 dark:border-white/10 dark:bg-white/5 dark:text-ink-100">Arbeitslohn</button>
    <button type="button" data-preset="km" class="rounded-full border border-ink-200 bg-white px-3 py-1.5 text-xs font-semibold text-ink-800 dark:border-white/10 dark:bg-white/5 dark:text-ink-100">Preis pro km</button>
    <button type="button" data-preset="anfahrt" class="rounded-full border border-ink-200 bg-white px-3 py-1.5 text-xs font-semibold text-ink-800 dark:border-white/10 dark:bg-white/5 dark:text-ink-100">Anfahrt</button>
    <button type="button" data-preset="material" class="rounded-full border border-ink-200 bg-white px-3 py-1.5 text-xs font-semibold text-ink-800 dark:border-white/10 dark:bg-white/5 dark:text-ink-100">Material</button>
    <button type="button" id="offer-add" class="rounded-full border border-ink-200 bg-white px-3 py-1.5 text-xs font-semibold text-ink-800 dark:border-white/10 dark:bg-white/5 dark:text-ink-100">Weitere Position</button>
  </div>
  <div id="offer-lines" class="grid gap-3">
    {visible.map((line) => (
      <div data-line class="grid gap-2 rounded-2xl border border-ink-200 p-3 sm:grid-cols-12 dark:border-white/10">
        <div class="sm:col-span-4">
          <label class="label">Position</label>
          <input class="input" name="line_label" maxlength="120" value={line.label} />
        </div>
        <div class="sm:col-span-2">
          <label class="label" data-qty-label>{line.unit === "stunde" ? "Stunden" : "Menge"}</label>
          <input class="input" name="line_qty" data-qty inputmode="decimal" value={line.quantity} placeholder={line.unit === "stunde" ? "2" : ""} />
        </div>
        <div class="sm:col-span-2">
          <label class="label">Einheit</label>
          <select class="input" name="line_unit" data-unit>
            {OFFER_UNITS.map((unit) => <option value={unit} selected={unit === line.unit}>{OFFER_UNIT_LABELS[unit]}</option>)}
          </select>
        </div>
        <div class="sm:col-span-2">
          <label class="label" data-price-label>{line.unit === "stunde" ? "Stundensatz" : "Einzelpreis"}</label>
          <input class="input" name="line_price" data-price inputmode="decimal" value={line.price} placeholder={line.unit === "stunde" ? "45,00" : ""} />
        </div>
        <div class="flex items-end justify-between gap-2 sm:col-span-2">
          <p data-line-total class="pb-2 text-sm font-semibold text-ink-900 dark:text-ink-50">–</p>
          <button type="button" data-remove class="pb-2 text-xs font-semibold text-ink-500">Entfernen</button>
        </div>
      </div>
    ))}
  </div>
  <p class="text-sm text-ink-800 dark:text-ink-100"><span id="offer-total-label">{billing === "stunden" ? "Summe" : "Festpreis"}</span> <strong id="offer-total">0,00 €</strong></p>
  <OfferNotes validUntil={validUntil} billing={billing} />
  <p class="text-sm text-ink-800 dark:text-ink-100">{OFFER_BANK_LINES.join(" · ")}</p>
  <div class="grid gap-3 sm:grid-cols-2">
    <div>
      <label class="label" for="offer-until">Gültig bis</label>
      <input class="input" id="offer-until" name="valid_until" type="date" required value={validUntil} />
    </div>
    <SalutationSelect name={customerName} id="salutation-offer" selected={salutation} />
  </div>
  <div>
    <label class="label" for="offer-intro">Anschreiben</label>
    <textarea
      class="input"
      id="offer-intro"
      name="intro"
      maxlength="2000"
      rows="3"
      placeholder={billing === "stunden" ? OFFER_HOURLY_INTRO : OFFER_DEFAULT_INTRO}
      data-placeholder-fest={OFFER_DEFAULT_INTRO}
      data-placeholder-stunden={OFFER_HOURLY_INTRO}
    >{intro}</textarea>
  </div>
  <div class="flex flex-wrap gap-2">
    <slot name="actions">
      <button type="submit" class="btn-primary">Angebot als PDF senden</button>
      <button type="submit" name="preview" value="1" formtarget="_blank" class="rounded-full border border-ink-200 bg-white px-4 py-2 text-sm font-semibold text-ink-800 dark:border-white/10 dark:bg-white/5 dark:text-ink-100">PDF ansehen</button>
    </slot>
  </div>
</form>
<template id="offer-line-template">
  <div data-line class="grid gap-2 rounded-2xl border border-ink-200 p-3 sm:grid-cols-12 dark:border-white/10">
    <div class="sm:col-span-4">
      <label class="label">Position</label>
      <input class="input" name="line_label" maxlength="120" />
    </div>
    <div class="sm:col-span-2">
      <label class="label" data-qty-label>Menge</label>
      <input class="input" name="line_qty" data-qty inputmode="decimal" />
    </div>
    <div class="sm:col-span-2">
      <label class="label">Einheit</label>
      <select class="input" name="line_unit" data-unit>
        {OFFER_UNITS.map((unit) => <option value={unit}>{OFFER_UNIT_LABELS[unit]}</option>)}
      </select>
    </div>
    <div class="sm:col-span-2">
      <label class="label" data-price-label>Einzelpreis</label>
      <input class="input" name="line_price" data-price inputmode="decimal" />
    </div>
    <div class="flex items-end justify-between gap-2 sm:col-span-2">
      <p data-line-total class="pb-2 text-sm font-semibold text-ink-900 dark:text-ink-50">–</p>
      <button type="button" data-remove class="pb-2 text-xs font-semibold text-ink-500">Entfernen</button>
    </div>
  </div>
</template>

<script data-astro-rerun>
  const form = document.getElementById("offer-form");
  const root = document.getElementById("offer-lines");
  const template = document.getElementById("offer-line-template");
  const total = document.getElementById("offer-total");
  const totalLabel = document.getElementById("offer-total-label");
  const hint = document.getElementById("offer-billing-hint");
  if (form instanceof HTMLFormElement && root && template instanceof HTMLTemplateElement && total && form.dataset.ready !== "1") {
    form.dataset.ready = "1";
    const presets = {
      stunde: ["Arbeitslohn", "stunde", "", ""],
      km: ["Preis pro km", "km", "", ""],
      anfahrt: ["Anfahrt", "pauschal", "1", ""],
      material: ["Material", "pauschal", "1", ""],
    };
    const readSet = (raw) => {
      try {
        const parsed = JSON.parse(raw || "[]");
        return Array.isArray(parsed) ? parsed : [];
      } catch {
        return [];
      }
    };
    const festSet = readSet(form.dataset.festLines);
    const hourSet = readSet(form.dataset.hourLines);
    const centsOf = (raw) => {
      const cleaned = String(raw || "").trim().replace(/\s/g, "").replace("€", "");
      if (!/^\d{1,6}([.,]\d{1,2})?$/.test(cleaned)) return 0;
      return Math.round(Number(cleaned.replace(",", ".")) * 100);
    };
    const qtyOf = (raw) => {
      const cleaned = String(raw || "").trim().replace(/\s/g, "").replace(",", ".");
      if (!/^\d{1,5}(\.\d{1,2})?$/.test(cleaned)) return 0;
      return Number(cleaned);
    };
    const money = (cents) => (cents / 100).toLocaleString("de-DE", { style: "currency", currency: "EUR" });
    const paintRow = (row) => {
      const unit = row.querySelector("[data-unit]")?.value;
      const qtyLabel = row.querySelector("[data-qty-label]");
      const priceLabel = row.querySelector("[data-price-label]");
      const qty = row.querySelector("[data-qty]");
      const price = row.querySelector("[data-price]");
      if (qtyLabel) qtyLabel.textContent = unit === "stunde" ? "Stunden" : "Menge";
      if (priceLabel) priceLabel.textContent = unit === "stunde" ? "Stundensatz" : "Einzelpreis";
      if (qty instanceof HTMLInputElement) qty.placeholder = unit === "stunde" ? "2" : "";
      if (price instanceof HTMLInputElement) price.placeholder = unit === "stunde" ? "45,00" : "";
    };
    const refresh = () => {
      let sum = 0;
      root.querySelectorAll("[data-line]").forEach((row) => {
        paintRow(row);
        const qty = qtyOf(row.querySelector("[data-qty]")?.value);
        const price = centsOf(row.querySelector("[data-price]")?.value);
        const line = Math.round(qty * price);
        if (qty > 0 && price > 0) sum += line;
        const out = row.querySelector("[data-line-total]");
        if (out) out.textContent = qty > 0 && price > 0 ? money(line) : "–";
      });
      total.textContent = money(sum);
    };
    const bind = (row) => {
      row.querySelector("[data-remove]")?.addEventListener("click", () => {
        if (root.querySelectorAll("[data-line]").length <= 1) return;
        row.remove();
        refresh();
      });
      row.addEventListener("input", refresh);
      row.querySelector("[data-unit]")?.addEventListener("change", refresh);
    };
    const fill = (node, values) => {
      const label = node.querySelector("[name='line_label']");
      const unit = node.querySelector("[data-unit]");
      const qty = node.querySelector("[data-qty]");
      const price = node.querySelector("[data-price]");
      if (label instanceof HTMLInputElement) label.value = values[0] || "";
      if (unit instanceof HTMLSelectElement) unit.value = values[1] || "pauschal";
      if (qty instanceof HTMLInputElement) qty.value = values[2] || "";
      if (price instanceof HTMLInputElement) price.value = values[3] || "";
    };
    const addLine = (preset) => {
      if (root.querySelectorAll("[data-line]").length >= 12) return;
      const node = template.content.firstElementChild?.cloneNode(true);
      if (!(node instanceof HTMLElement)) return;
      fill(node, presets[preset] || ["", "pauschal", "", ""]);
      root.appendChild(node);
      bind(node);
      refresh();
    };
    const pricesEmpty = () => [...root.querySelectorAll("[data-price]")].every((input) => input instanceof HTMLInputElement && input.value.trim() === "");
    const replaceLines = (rows) => {
      root.replaceChildren();
      rows.forEach((row) => {
        const node = template.content.firstElementChild?.cloneNode(true);
        if (!(node instanceof HTMLElement)) return;
        fill(node, [row.label, row.unit, row.quantity, row.price]);
        root.appendChild(node);
        bind(node);
      });
      refresh();
    };
    const selectedBilling = () => form.querySelector("input[name='billing']:checked")?.value === "stunden" ? "stunden" : "fest";
    const applyBilling = (mode, replace) => {
      if (totalLabel) totalLabel.textContent = mode === "stunden" ? "Summe" : "Festpreis";
      hint?.classList.toggle("hidden", mode !== "stunden");
      const intro = document.getElementById("offer-intro");
      if (intro instanceof HTMLTextAreaElement) {
        intro.placeholder = mode === "stunden" ? intro.dataset.placeholderStunden || "" : intro.dataset.placeholderFest || "";
      }
      if (replace && pricesEmpty()) replaceLines(mode === "stunden" ? hourSet : festSet);
      else refresh();
    };
    root.querySelectorAll("[data-line]").forEach(bind);
    document.getElementById("offer-add")?.addEventListener("click", () => addLine(""));
    form.querySelectorAll("[data-preset]").forEach((button) => {
      button.addEventListener("click", () => addLine(button.getAttribute("data-preset") || ""));
    });
    form.querySelectorAll("input[name='billing']").forEach((input) => {
      input.addEventListener("change", () => applyBilling(selectedBilling(), true));
    });
    applyBilling(selectedBilling(), false);
  }
</script>
