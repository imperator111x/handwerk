---
import type { CustomerListItem } from "../lib/customers";
import type { TimesheetLine } from "../lib/timesheet";

interface Props {
  customers: CustomerListItem[];
  customerId?: number | null;
  customerName?: string;
  street?: string;
  postalCode?: string;
  city?: string;
  employeeName: string;
  workDate: string;
  note?: string;
  lines?: TimesheetLine[];
  hidden?: Array<{ name: string; value: string }>;
  submitLabel: string;
}

const {
  customers,
  customerId = null,
  customerName = "",
  street = "",
  postalCode = "",
  city = "",
  employeeName,
  workDate,
  note = "",
  hidden = [],
  submitLabel,
} = Astro.props;
const lines = Astro.props.lines?.length
  ? Astro.props.lines
  : [{ start: "", end: "", breakMinutes: 0, task: "" }];
---

<form id="timesheet-form" method="POST" action="/api/admin/stundenzettel" class="grid gap-4">
  {hidden.map((field) => <input type="hidden" name={field.name} value={field.value} />)}
  <div class="grid gap-4 sm:grid-cols-2">
    <div>
      <label class="label" for="timesheet-customer">Kunde aus der Kartei</label>
      <select class="input" id="timesheet-customer" name="customer_id">
        <option value="">Ohne Kartei</option>
        {customers.map((customer) => (
          <option
            value={customer.id}
            selected={customer.id === customerId}
            data-name={customer.name}
            data-street={customer.street ?? ""}
            data-postal={customer.postal_code ?? ""}
            data-city={customer.city ?? ""}
          >
            {customer.name}
          </option>
        ))}
      </select>
    </div>
    <div>
      <label class="label" for="timesheet-date">Arbeitstag</label>
      <input class="input" id="timesheet-date" name="work_date" type="date" required value={workDate} />
    </div>
  </div>
  <div class="grid gap-4 sm:grid-cols-2">
    <div>
      <label class="label" for="customer_name">Name auf dem Zettel</label>
      <input class="input" id="customer_name" name="customer_name" required minlength="2" maxlength="120" value={customerName} />
    </div>
    <div>
      <label class="label" for="employee_name">Mitarbeiter</label>
      <input class="input" id="employee_name" name="employee_name" required minlength="2" maxlength="80" value={employeeName} />
    </div>
  </div>
  <div class="grid gap-4 sm:grid-cols-3">
    <div class="sm:col-span-1">
      <label class="label" for="street">Straße</label>
      <input class="input" id="street" name="street" maxlength="120" value={street} />
    </div>
    <div>
      <label class="label" for="postal_code">PLZ</label>
      <input class="input" id="postal_code" name="postal_code" maxlength="12" value={postalCode} />
    </div>
    <div>
      <label class="label" for="city">Ort</label>
      <input class="input" id="city" name="city" maxlength="80" value={city} />
    </div>
  </div>
  <div id="timesheet-lines" class="grid gap-3">
    {lines.map((line) => (
      <div data-time-line class="grid gap-2 rounded-2xl border border-ink-200 p-3 sm:grid-cols-12 dark:border-white/10">
        <div class="sm:col-span-2">
          <label class="label">Beginn</label>
          <input class="input" name="line_start" type="time" required value={line.start} />
        </div>
        <div class="sm:col-span-2">
          <label class="label">Ende</label>
          <input class="input" name="line_end" type="time" required value={line.end} />
        </div>
        <div class="sm:col-span-2">
          <label class="label">Pause Min.</label>
          <input class="input" name="line_break" inputmode="numeric" min="0" max="600" value={line.breakMinutes ? String(line.breakMinutes) : ""} placeholder="0" />
        </div>
        <div class="sm:col-span-5">
          <label class="label">Tätigkeit</label>
          <input class="input" name="line_task" maxlength="160" required value={line.task} />
        </div>
        <div class="flex items-end sm:col-span-1">
          <button type="button" data-time-remove class="pb-2 text-xs font-semibold text-ink-500">Weg</button>
        </div>
      </div>
    ))}
  </div>
  <button type="button" id="timesheet-add" class="w-fit rounded-full border border-ink-200 bg-white px-3 py-1.5 text-xs font-semibold text-ink-800 dark:border-white/10 dark:bg-white/5 dark:text-ink-100">Weitere Zeit</button>
  <div>
    <label class="label" for="timesheet-note">Bemerkung</label>
    <textarea class="input" id="timesheet-note" name="note" maxlength="500" rows="2">{note}</textarea>
  </div>
  <button type="submit" class="btn-primary w-fit">{submitLabel}</button>
</form>
<template id="timesheet-line-template">
  <div data-time-line class="grid gap-2 rounded-2xl border border-ink-200 p-3 sm:grid-cols-12 dark:border-white/10">
    <div class="sm:col-span-2">
      <label class="label">Beginn</label>
      <input class="input" name="line_start" type="time" required />
    </div>
    <div class="sm:col-span-2">
      <label class="label">Ende</label>
      <input class="input" name="line_end" type="time" required />
    </div>
    <div class="sm:col-span-2">
      <label class="label">Pause Min.</label>
      <input class="input" name="line_break" inputmode="numeric" placeholder="0" />
    </div>
    <div class="sm:col-span-5">
      <label class="label">Tätigkeit</label>
      <input class="input" name="line_task" maxlength="160" required />
    </div>
    <div class="flex items-end sm:col-span-1">
      <button type="button" data-time-remove class="pb-2 text-xs font-semibold text-ink-500">Weg</button>
    </div>
  </div>
</template>

<script data-astro-rerun>
  const form = document.getElementById("timesheet-form");
  const root = document.getElementById("timesheet-lines");
  const template = document.getElementById("timesheet-line-template");
  const select = document.getElementById("timesheet-customer");
  if (form instanceof HTMLFormElement && root && template instanceof HTMLTemplateElement && form.dataset.ready !== "1") {
    form.dataset.ready = "1";
    const bind = (row) => {
      row.querySelector("[data-time-remove]")?.addEventListener("click", () => {
        if (root.querySelectorAll("[data-time-line]").length <= 1) return;
        row.remove();
      });
    };
    root.querySelectorAll("[data-time-line]").forEach(bind);
    document.getElementById("timesheet-add")?.addEventListener("click", () => {
      if (root.querySelectorAll("[data-time-line]").length >= 8) return;
      const node = template.content.firstElementChild?.cloneNode(true);
      if (!(node instanceof HTMLElement)) return;
      root.appendChild(node);
      bind(node);
    });
    select?.addEventListener("change", () => {
      if (!(select instanceof HTMLSelectElement)) return;
      const option = select.selectedOptions[0];
      if (!option || !option.value) return;
      const name = form.querySelector("#customer_name");
      const street = form.querySelector("#street");
      const postal = form.querySelector("#postal_code");
      const city = form.querySelector("#city");
      if (name instanceof HTMLInputElement) name.value = option.dataset.name || "";
      if (street instanceof HTMLInputElement) street.value = option.dataset.street || "";
      if (postal instanceof HTMLInputElement) postal.value = option.dataset.postal || "";
      if (city instanceof HTMLInputElement) city.value = option.dataset.city || "";
    });
  }
</script>
