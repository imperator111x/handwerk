---
import { OFFER_PAYMENT_TERMS, OFFER_SCOPE_NOTE, OFFER_TAX_NOTE, formatOfferDate } from "../lib/quote";

interface Props {
  validUntil: string;
}

const { validUntil } = Astro.props;
const untilLabel = /^\d{4}-\d{2}-\d{2}$/.test(validUntil) ? formatOfferDate(validUntil) : validUntil;
---

<div class="mt-3 space-y-3 text-sm text-ink-700 dark:text-ink-200" data-offer-notes>
  <p>{OFFER_TAX_NOTE}</p>
  <p>{OFFER_PAYMENT_TERMS}</p>
  <p>{OFFER_SCOPE_NOTE}</p>
  <p>Dieses Angebot ist gültig bis <span data-offer-until-label>{untilLabel}</span>.</p>
</div>

<script data-astro-rerun>
  const formatIso = (iso) => {
    if (!/^\d{4}-\d{2}-\d{2}$/.test(iso)) return "";
    const [year, month, day] = iso.split("-").map(Number);
    return new Intl.DateTimeFormat("de-DE", {
      timeZone: "UTC",
      day: "numeric",
      month: "long",
      year: "numeric",
    }).format(new Date(Date.UTC(year, month - 1, day)));
  };
  const bindNotes = () => {
    document.querySelectorAll("[data-offer-notes]").forEach((root) => {
      if (!(root instanceof HTMLElement) || root.dataset.bound === "1") return;
      const label = root.querySelector("[data-offer-until-label]");
      const input = root.closest("form")?.querySelector("input[name='valid_until']");
      if (!(label instanceof HTMLElement) || !(input instanceof HTMLInputElement)) return;
      root.dataset.bound = "1";
      const paint = () => {
        const next = formatIso(input.value);
        if (next) label.textContent = next;
      };
      input.addEventListener("input", paint);
      input.addEventListener("change", paint);
    });
  };
  if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", bindNotes, { once: true });
  else bindNotes();
</script>
