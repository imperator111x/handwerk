---
import { DUE_DAY_OPTIONS } from "../lib/billing";

interface CustomerFields {
  id?: number;
  name?: string;
  email?: string;
  phone?: string | null;
  street?: string | null;
  postal_code?: string | null;
  city?: string | null;
  notes?: string | null;
  default_due_days?: number | null;
  site_name?: string | null;
  site_street?: string | null;
  site_postal_code?: string | null;
  site_city?: string | null;
}

interface Props {
  customer?: CustomerFields;
  submitLabel: string;
}

const { customer, submitLabel } = Astro.props;
const dueDays = Number(customer?.default_due_days ?? 14);
---

<form method="POST" action="/api/admin/kunden" class="grid gap-4">
  {customer?.id ? <input type="hidden" name="id" value={customer.id} /> : null}
  <input type="hidden" name="action" value={customer?.id ? "update" : "create"} />
  <div class="grid gap-4 sm:grid-cols-2">
    <div>
      <label class="label" for="customer-name">Name</label>
      <input class="input" id="customer-name" name="name" required minlength="2" maxlength="120" value={customer?.name ?? ""} />
    </div>
    <div>
      <label class="label" for="customer-email">E-Mail</label>
      <input class="input" id="customer-email" name="email" type="email" required maxlength="200" value={customer?.email ?? ""} />
    </div>
    <div>
      <label class="label" for="customer-phone">Telefon</label>
      <input class="input" id="customer-phone" name="phone" maxlength="60" value={customer?.phone ?? ""} />
    </div>
    <div>
      <label class="label" for="customer-due">Standard-Zahlungsziel</label>
      <select class="input" id="customer-due" name="default_due_days">
        {DUE_DAY_OPTIONS.map((days) => (
          <option value={days} selected={dueDays === days}>
            {days === 0 ? "Sofort" : `${days} Tage`}
          </option>
        ))}
      </select>
    </div>
    <div>
      <label class="label" for="customer-street">Straße und Hausnummer</label>
      <input class="input" id="customer-street" name="street" maxlength="120" value={customer?.street ?? ""} />
    </div>
    <div>
      <label class="label" for="customer-postal">Postleitzahl</label>
      <input class="input" id="customer-postal" name="postal_code" maxlength="12" value={customer?.postal_code ?? ""} />
    </div>
    <div>
      <label class="label" for="customer-city">Ort</label>
      <input class="input" id="customer-city" name="city" maxlength="80" value={customer?.city ?? ""} />
    </div>
  </div>
  <div class="rounded-2xl border border-ink-200 p-4 dark:border-white/10">
    <p class="text-sm font-semibold text-ink-900 dark:text-ink-50">Baustelle / Leistungsort (optional)</p>
    <p class="mt-1 text-xs text-ink-500 dark:text-ink-400">Wird bei neuen Rechnungen vorausgefüllt, wenn gesetzt.</p>
    <div class="mt-3 grid gap-4 sm:grid-cols-2">
      <div class="sm:col-span-2">
        <label class="label" for="site-name">Bezeichnung</label>
        <input class="input" id="site-name" name="site_name" maxlength="120" value={customer?.site_name ?? ""} placeholder="z. B. Objekt Müller" />
      </div>
      <div class="sm:col-span-2">
        <label class="label" for="site-street">Straße</label>
        <input class="input" id="site-street" name="site_street" maxlength="120" value={customer?.site_street ?? ""} />
      </div>
      <div>
        <label class="label" for="site-postal">PLZ</label>
        <input class="input" id="site-postal" name="site_postal_code" maxlength="12" value={customer?.site_postal_code ?? ""} />
      </div>
      <div>
        <label class="label" for="site-city">Ort</label>
        <input class="input" id="site-city" name="site_city" maxlength="80" value={customer?.site_city ?? ""} />
      </div>
    </div>
  </div>
  <div>
    <label class="label" for="customer-notes">Notiz</label>
    <textarea class="input" id="customer-notes" name="notes" maxlength="2000" rows="3">{customer?.notes ?? ""}</textarea>
  </div>
  <div>
    <button type="submit" class="btn-primary">{submitLabel}</button>
  </div>
</form>
