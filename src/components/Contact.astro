---
import { siteConfig } from "../config/site";
import ObfuscatedEmail from "./ObfuscatedEmail.astro";
import { cfEnv } from "../lib/cf";

const turnstileSitekey = cfEnv()?.TURNSTILE_SITEKEY ?? "";
---

<section id="kontakt" class="section scroll-mt-24 bg-white dark:bg-ink-950">
  <div class="container-page">
    <div
      class="grid lg:grid-cols-12 gap-10 rounded-[2rem] border border-ink-200 bg-gradient-to-br from-brand-50/60 via-white to-white p-6 sm:p-10 lg:p-14 shadow-[var(--shadow-soft)] dark:border-white/10 dark:from-brand-500/10 dark:via-ink-900 dark:to-ink-900"
    >
      <div class="lg:col-span-5 space-y-6">
        <p class="section-eyebrow">Kontakt</p>
        <h2 class="section-title">Lassen Sie uns sprechen</h2>
        <p class="text-ink-700 text-lg dark:text-ink-200">
          Schreiben Sie uns, rufen Sie an oder nutzen Sie das Formular.
          Wir melden uns in der Regel innerhalb von 24 Stunden mit einem
          konkreten Vorschlag.
        </p>

        <ul class="space-y-4 pt-2">
          <li class="flex items-start gap-4">
            <span
              class="h-10 w-10 rounded-xl bg-white text-brand-600 inline-flex items-center justify-center shadow-sm flex-none dark:bg-ink-900 dark:text-brand-300"
              aria-hidden="true"
            >
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="h-5 w-5"
              >
                <path
                  d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.37 1.9.72 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.35 1.85.59 2.81.72A2 2 0 0 1 22 16.92z"
                />
              </svg>
            </span>
            <div>
              <p class="text-xs font-semibold uppercase tracking-widest text-ink-500 dark:text-ink-400">
                Telefon
              </p>
              <a
                href={siteConfig.contact.phoneHref}
                class="text-ink-900 font-semibold hover:text-brand-700 dark:text-ink-50 dark:hover:text-brand-200"
              >
                {siteConfig.contact.phone}
              </a>
            </div>
          </li>
          <li class="flex items-start gap-4">
            <span
              class="h-10 w-10 rounded-xl bg-white text-brand-600 inline-flex items-center justify-center shadow-sm flex-none dark:bg-ink-900 dark:text-brand-300"
              aria-hidden="true"
            >
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="h-5 w-5"
              >
                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" />
                <polyline points="22,6 12,13 2,6" />
              </svg>
            </span>
            <div>
              <p class="text-xs font-semibold uppercase tracking-widest text-ink-500 dark:text-ink-400">
                E-Mail
              </p>
              <ObfuscatedEmail class="text-ink-900 font-semibold hover:text-brand-700 dark:text-ink-50 dark:hover:text-brand-200" />
            </div>
          </li>
          <li class="flex items-start gap-4">
            <span
              class="h-10 w-10 rounded-xl bg-white text-brand-600 inline-flex items-center justify-center shadow-sm flex-none dark:bg-ink-900 dark:text-brand-300"
              aria-hidden="true"
            >
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="h-5 w-5"
              >
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" />
                <circle cx="12" cy="10" r="3" />
              </svg>
            </span>
            <div>
              <p class="text-xs font-semibold uppercase tracking-widest text-ink-500 dark:text-ink-400">
                Standort
              </p>
              <p class="text-ink-900 font-semibold dark:text-ink-50">
                {siteConfig.contact.address.zip}{" "}
                {siteConfig.contact.address.city}
              </p>
              <p class="text-sm text-ink-600 dark:text-ink-300">
                Einsatzgebiet: Hamburg, Norderstedt & Umland
              </p>
            </div>
          </li>
        </ul>

        <div class="rounded-2xl bg-white border border-ink-200 p-5 dark:border-white/10 dark:bg-white/5">
          <p class="text-xs font-semibold uppercase tracking-widest text-ink-500 mb-3 dark:text-ink-400">
            Öffnungszeiten
          </p>
          <ul class="space-y-1.5 text-sm text-ink-700 dark:text-ink-200">
            {
              siteConfig.contact.hours.map((h) => (
                <li class="flex justify-between gap-4">
                  <span class="font-medium text-ink-900 dark:text-ink-50">
                    {h.day}
                  </span>
                  <span class="text-ink-600 dark:text-ink-300 text-right">
                    {h.time}
                  </span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>

      <div class="lg:col-span-7">
        <form
          id="contact-form"
          method="POST"
          action="/api/contact"
          class="rounded-2xl bg-white border border-ink-200 p-6 sm:p-8 space-y-5 shadow-[var(--shadow-soft)] dark:border-white/10 dark:bg-ink-900"
          novalidate
        >
          <div class="grid sm:grid-cols-2 gap-4">
            <div>
              <label for="name" class="label">Name *</label>
              <input
                id="name"
                name="name"
                type="text"
                required
                autocomplete="name"
                class="input"
                placeholder="Max Mustermann"
              />
            </div>
            <div>
              <label for="email" class="label">E-Mail *</label>
              <input
                id="email"
                name="email"
                type="email"
                required
                autocomplete="email"
                class="input"
                placeholder="max@example.com"
              />
            </div>
          </div>
          <div class="grid sm:grid-cols-2 gap-4">
            <div>
              <label for="phone" class="label">Telefon</label>
              <input
                id="phone"
                name="phone"
                type="tel"
                autocomplete="tel"
                class="input"
                placeholder="+49 ..."
              />
            </div>
            <div>
              <label for="topic" class="label">Thema *</label>
              <select id="topic" name="topic" required class="input">
                <option value="">Bitte auswählen</option>
                <option value="reparatur">Reparatur</option>
                <option value="reinigung">Reinigung</option>
                <option value="wartung">Wartung</option>
                <option value="objektbetreuung">Objektbetreuung</option>
                <option value="sonstiges">Sonstiges</option>
              </select>
            </div>
          </div>
          <div>
            <label for="message" class="label">Nachricht *</label>
            <textarea
              id="message"
              name="message"
              rows="5"
              required
              class="input"
              placeholder="Beschreiben Sie Ihr Anliegen – wann, wo, worum geht es?"
            ></textarea>
          </div>

          <!-- Honeypot gegen Bots: Darf nicht ausgefüllt werden -->
          <div class="absolute left-[-9999px]" aria-hidden="true">
            <label for="website">Webseite</label>
            <input id="website" name="website" type="text" tabindex="-1" autocomplete="off" />
          </div>

          {
            turnstileSitekey && (
              <div
                id="contact-turnstile"
                data-sitekey={turnstileSitekey}
              />
            )
          }

          <label class="flex items-start gap-3 text-sm text-ink-700 dark:text-ink-200">
            <input
              type="checkbox"
              name="privacy"
              required
              class="mt-1 h-4 w-4 rounded border-ink-300 text-brand-600 focus:ring-brand-500 dark:border-white/20 dark:bg-ink-900"
            />
            <span>
              Ich habe die
              <a href="/datenschutz" class="text-brand-700 underline dark:text-brand-200">
                Datenschutzerklärung
              </a>
              gelesen und bin mit der Verarbeitung meiner Daten zur
              Bearbeitung meiner Anfrage einverstanden. *
            </span>
          </label>

          <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
            <p class="text-xs text-ink-500 dark:text-ink-400">
              Pflichtfelder sind mit * markiert
            </p>
            <button
              type="submit"
              id="contact-submit"
              class="btn-primary justify-center"
            >
              Anfrage senden
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="h-4 w-4"
                aria-hidden="true"
              >
                <line x1="22" y1="2" x2="11" y2="13" />
                <polygon points="22 2 15 22 11 13 2 9 22 2" />
              </svg>
            </button>
          </div>

          <div
            id="contact-status"
            role="status"
            aria-live="polite"
            class="hidden rounded-xl border px-4 py-3 text-sm"
          ></div>
        </form>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  const form = document.getElementById("contact-form");
  const status = document.getElementById("contact-status");
  const submit = document.getElementById("contact-submit");
  const turnstileContainer = document.getElementById("contact-turnstile");
  let contactWidgetId;

  function renderContactTurnstile() {
    if (!turnstileContainer || !window.turnstile || contactWidgetId) return;
    contactWidgetId = window.turnstile.render(turnstileContainer, {
      sitekey: turnstileContainer.dataset.sitekey,
      action: "contact",
      theme: "auto",
    });
  }

  if (turnstileContainer) {
    if (window.turnstile) renderContactTurnstile();
    else (window.__turnstileQueue = window.__turnstileQueue || []).push(renderContactTurnstile);
  }

  function setStatus(message, type) {
    if (!status) return;
    status.textContent = message;
    status.className =
      "rounded-xl border px-4 py-3 text-sm " +
      (type === "success"
        ? "border-emerald-200 bg-emerald-50 text-emerald-800 dark:border-emerald-400/30 dark:bg-emerald-500/10 dark:text-emerald-200"
        : type === "error"
          ? "border-rose-200 bg-rose-50 text-rose-800 dark:border-rose-400/30 dark:bg-rose-500/10 dark:text-rose-200"
          : "border-ink-200 bg-ink-50 text-ink-700 dark:border-white/10 dark:bg-white/5 dark:text-ink-200");
    status.classList.remove("hidden");
  }

  if (form) {
    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (!(form instanceof HTMLFormElement)) return;
      const data = new FormData(form);
      setStatus("Anfrage wird gesendet …", "info");
      if (submit) submit.setAttribute("disabled", "true");
      try {
        const res = await fetch("/api/contact", {
          method: "POST",
          body: data,
          headers: { Accept: "application/json" },
        });
        const payload = await res.json().catch(() => ({}));
        if (res.ok && payload.ok) {
          form.reset();
          setStatus(
            "Vielen Dank! Ihre Anfrage ist bei uns eingegangen – wir melden uns in Kürze.",
            "success",
          );
        } else {
          setStatus(
            payload.error ||
              "Leider ist ein Fehler aufgetreten. Bitte versuchen Sie es erneut oder rufen Sie uns direkt an.",
            "error",
          );
        }
      } catch (_) {
        setStatus(
          "Netzwerkfehler. Bitte prüfen Sie Ihre Verbindung und versuchen Sie es erneut.",
          "error",
        );
      } finally {
        if (contactWidgetId !== undefined && window.turnstile) {
          window.turnstile.reset(contactWidgetId);
        }
        if (submit) submit.removeAttribute("disabled");
      }
    });
  }
</script>
