---
import { INVOICE_PAYMENT_TERMS, INVOICE_RETENTION_NOTE } from "../lib/invoice";
import { OFFER_TAX_NOTE } from "../lib/quote";

interface Props {
  paymentTerms?: string;
}

const { paymentTerms = INVOICE_PAYMENT_TERMS } = Astro.props;
---

<div class="mt-3 space-y-3 text-sm text-ink-700 dark:text-ink-200">
  <p>{OFFER_TAX_NOTE}</p>
  <p>{paymentTerms}</p>
  <p>{INVOICE_RETENTION_NOTE}</p>
</div>
