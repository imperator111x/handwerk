<div
  id="cookie-notice"
  hidden
  class="fixed inset-x-0 bottom-0 z-50 p-4 pb-[max(1rem,env(safe-area-inset-bottom))] sm:p-6"
  role="region"
  aria-label="Cookie-Hinweis"
>
  <div
    class="mx-auto flex max-w-4xl flex-col gap-4 rounded-3xl border border-ink-200 bg-white p-5 shadow-[var(--shadow-soft)] sm:flex-row sm:items-center sm:justify-between dark:border-white/10 dark:bg-ink-900"
  >
    <p class="text-sm leading-relaxed text-ink-700 dark:text-ink-200">
      Wir setzen nur technisch nötige Cookies, damit die Website ausgeliefert
      und vor Missbrauch geschützt wird. Ihre Farbwahl und dieser Hinweis
      bleiben lokal im Browser. Tracking gibt es nicht.
    </p>
    <div class="flex shrink-0 items-center gap-3">
      <a
        href="/datenschutz#cookies"
        class="text-sm font-semibold text-brand-700 underline dark:text-brand-200"
      >
        Datenschutz
      </a>
      <button type="button" class="btn-primary" data-cookie-accept>
        Verstanden
      </button>
    </div>
  </div>
</div>

<script is:inline>
  (() => {
    const key = "zs-cookie-notice";
    const notice = document.getElementById("cookie-notice");
    if (!notice) return;

    const show = () => {
      notice.hidden = false;
    };
    const hide = () => {
      notice.hidden = true;
    };

    try {
      if (localStorage.getItem(key) !== "1") show();
    } catch {
      show();
    }

    notice.querySelector("[data-cookie-accept]")?.addEventListener("click", () => {
      try {
        localStorage.setItem(key, "1");
      } catch {
        /* Der Hinweis bleibt sonst beim nächsten Besuch sichtbar. */
      }
      hide();
    });

    document.addEventListener("click", (event) => {
      const target = event.target;
      if (!(target instanceof Element) || !target.closest("[data-open-cookie-notice]")) {
        return;
      }
      try {
        localStorage.removeItem(key);
      } catch {
        /* Anzeigen gelingt auch ohne Speicher. */
      }
      show();
    });
  })();
</script>
