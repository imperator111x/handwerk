<div
  id="cookie-notice"
  hidden
  class="fixed inset-x-0 bottom-0 z-50 p-4 pb-[max(1rem,env(safe-area-inset-bottom))] sm:p-6"
  role="region"
  aria-label="Cookie-Hinweis"
>
  <div
    class="mx-auto flex max-w-4xl flex-col gap-4 rounded-3xl border border-ink-200 bg-white p-5 shadow-[var(--shadow-soft)] sm:flex-row sm:items-center sm:justify-between dark:border-white/10 dark:bg-ink-900"
  >
    <p class="text-sm leading-relaxed text-ink-700 dark:text-ink-200">
      Beim Laden prüft ein unsichtbarer Bot-Check, ob ein Mensch die Seite
      aufruft. Wenn Sie zustimmen, zählen wir den Aufruf und die Herkunft,
      zum Beispiel Google oder direkt. Es gibt kein Werbeprofil.
    </p>
    <div class="flex shrink-0 flex-wrap items-center gap-3">
      <a
        href="/datenschutz#cookies"
        class="text-sm font-semibold text-brand-700 underline dark:text-brand-200"
      >
        Datenschutz
      </a>
      <button type="button" class="btn-secondary" data-cookie-choice="necessary">
        Nur nötige
      </button>
      <button type="button" class="btn-primary" data-cookie-choice="stats">
        Statistik erlauben
      </button>
    </div>
  </div>
</div>

<script is:inline>
  (() => {
    const key = "zs-cookie-notice";
    const notice = document.getElementById("cookie-notice");
    if (!notice) return;

    const show = () => {
      notice.hidden = false;
    };
    const hide = () => {
      notice.hidden = true;
    };

    try {
      const choice = localStorage.getItem(key);
      if (choice !== "stats" && choice !== "necessary") show();
    } catch {
      show();
    }

    notice.querySelectorAll("[data-cookie-choice]").forEach((button) => {
      button.addEventListener("click", () => {
        const choice = button.getAttribute("data-cookie-choice") === "stats" ? "stats" : "necessary";
        try {
          localStorage.setItem(key, choice);
        } catch {
          /* Der Hinweis bleibt sonst beim nächsten Besuch sichtbar. */
        }
        hide();
        if (choice === "stats") {
          window.dispatchEvent(new CustomEvent("cookie-stats"));
        }
      });
    });

    document.addEventListener("click", (event) => {
      const target = event.target;
      if (!(target instanceof Element) || !target.closest("[data-open-cookie-notice]")) {
        return;
      }
      try {
        localStorage.removeItem(key);
      } catch {
        /* Anzeigen gelingt auch ohne Speicher. */
      }
      show();
    });
  })();
</script>
