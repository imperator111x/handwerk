---
import { siteConfig } from "../config/site";
---

<a
  id="call-button"
  href={siteConfig.contact.phoneHref}
  class="fixed z-40 inline-flex items-center gap-2 rounded-full bg-brand-600 px-4 py-3 text-sm font-semibold text-white shadow-[var(--shadow-soft)] sm:hidden bottom-[max(1rem,env(safe-area-inset-bottom))] right-4"
>
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4" aria-hidden="true">
    <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.37 1.9.72 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.35 1.85.59 2.81.72A2 2 0 0 1 22 16.92z" />
  </svg>
  Anrufen
</a>
<script is:inline>
  (function () {
    var button = document.getElementById("call-button");
    var notice = document.getElementById("cookie-notice");
    if (!button || !notice) return;
    var sync = function () {
      button.hidden = !notice.hidden;
    };
    sync();
    new MutationObserver(sync).observe(notice, { attributes: true, attributeFilter: ["hidden"] });
  })();
</script>
