---
import Layout from "../layouts/Layout.astro";
import { getSession } from "../lib/auth";

export const prerender = false;

const existing = await getSession(Astro);
if (existing) {
  return Astro.redirect("/admin");
}

const url = Astro.url;
const next = url.searchParams.get("next") ?? "/admin";
const errorCode = url.searchParams.get("error");
const errorMessages: Record<string, string> = {
  credentials: "Benutzername oder Passwort ist falsch.",
  missing: "Bitte geben Sie Benutzername und Passwort ein.",
  invalid: "Die Anfrage konnte nicht verarbeitet werden.",
};
const errorMessage = errorCode ? errorMessages[errorCode] : undefined;
---

<Layout
  title="Anmelden"
  description="Interner Login für das Zeus-Service-Admin-Panel."
  noindex
  showHeader={false}
  showFooter={false}
>
  <section class="hero-gradient min-h-screen flex items-center justify-center py-16 px-5">
    <div class="w-full max-w-md space-y-8">
      <div class="text-center space-y-3">
        <a href="/" class="inline-flex items-center gap-2 text-brand-700 font-semibold">
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="h-4 w-4"
            aria-hidden="true"
          >
            <line x1="19" y1="12" x2="5" y2="12" />
            <polyline points="12 19 5 12 12 5" />
          </svg>
          Zurück zur Website
        </a>
        <h1 class="font-display text-3xl font-extrabold text-ink-900">
          Admin-Login
        </h1>
        <p class="text-ink-600 text-sm">
          Zugang für Zeus-Service-Administrator:innen.
        </p>
      </div>

      <form
        method="POST"
        action="/api/auth/login"
        class="rounded-3xl border border-ink-200 bg-white p-8 shadow-[var(--shadow-soft)] space-y-5"
      >
        {
          errorMessage && (
            <p class="rounded-xl border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-800">
              {errorMessage}
            </p>
          )
        }

        <div>
          <label for="username" class="label">Benutzername</label>
          <input
            id="username"
            name="username"
            type="text"
            required
            autocomplete="username"
            class="input"
          />
        </div>

        <div>
          <label for="password" class="label">Passwort</label>
          <input
            id="password"
            name="password"
            type="password"
            required
            autocomplete="current-password"
            class="input"
          />
        </div>

        <input type="hidden" name="next" value={next} />

        <button type="submit" class="btn-primary w-full justify-center">
          Anmelden
        </button>

        <p class="text-xs text-ink-500 text-center">
          Noch kein Zugang? Setzen Sie zuerst
          <code class="rounded bg-ink-100 px-1 py-0.5">ADMIN_PASSWORD_HASH</code>
          als Wrangler-Secret (siehe README).
        </p>
      </form>
    </div>
  </section>
</Layout>
