---
import TimesheetForm from "../../../components/TimesheetForm.astro";
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { requireSession } from "../../../lib/auth";
import { listCustomers } from "../../../lib/customers";
import { getDb, signatureNameForUser } from "../../../lib/db";
import { decodeHtmlEntities } from "../../../lib/html-entities";
import { berlinTodayIso } from "../../../lib/offers";

export const prerender = false;

const sessionOrRedirect = await requireSession(Astro);
if (sessionOrRedirect instanceof Response) return sessionOrRedirect;
const session = sessionOrRedirect;
const db = getDb(Astro);
const customers = db ? await listCustomers(db) : [];
const employeeName = db ? await signatureNameForUser(db, session.userId, session.username) : session.username;
const flag = Astro.url.searchParams.get("zettel");
---

<AdminLayout title="Neuer Stundenzettel" session={session}>
  <section class="rounded-3xl border border-ink-200 bg-white p-6 dark:border-white/10 dark:bg-ink-900">
    <a href="/admin/stundenzettel" class="text-sm text-ink-500 hover:text-brand-700 dark:text-ink-400">← Alle Stundenzettel</a>
    <h2 class="mt-3 font-display text-2xl font-bold text-ink-900 dark:text-ink-50">Neuer Stundenzettel</h2>
    <p class="mt-1 text-sm text-ink-600 dark:text-ink-300">
      Erst die Zeiten speichern. Unterschreiben geht danach auf dem Zettel, mit Stift auf dem Tablet.
    </p>
    {flag === "bad" && (
      <p class="mt-4 rounded-2xl border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-800 dark:border-rose-400/30 dark:bg-rose-500/10 dark:text-rose-100">
        Bitte Kunde, Mitarbeiter und mindestens eine Zeit mit Beginn, Ende und Tätigkeit prüfen. Das Ende muss nach dem Beginn liegen.
      </p>
    )}
    <div class="mt-5">
      <TimesheetForm
        customers={customers.map((customer) => ({ ...customer, name: decodeHtmlEntities(customer.name) }))}
        employeeName={employeeName}
        workDate={berlinTodayIso()}
        hidden={[{ name: "action", value: "create" }]}
        submitLabel="Stundenzettel anlegen"
      />
    </div>
  </section>
</AdminLayout>
