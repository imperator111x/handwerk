---
import SignaturePad from "../../../components/SignaturePad.astro";
import TimesheetForm from "../../../components/TimesheetForm.astro";
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { requireSession } from "../../../lib/auth";
import { listCustomers } from "../../../lib/customers";
import { getDb } from "../../../lib/db";
import { decodeHtmlEntities } from "../../../lib/html-entities";
import { formatDecimalHours, formatMinutes, readTimesheetLines, TIMESHEET_SIGN_NOTE, timesheetNumber } from "../../../lib/timesheet";
import { getTimesheet, workDateLabel } from "../../../lib/timesheets";
import { formatBerlin } from "../../../lib/time";

export const prerender = false;

const sessionOrRedirect = await requireSession(Astro);
if (sessionOrRedirect instanceof Response) return sessionOrRedirect;
const session = sessionOrRedirect;
const id = Number.parseInt(Astro.params.id ?? "", 10);
const db = getDb(Astro);
const row = db && Number.isFinite(id) ? await getTimesheet(db, id) : null;
if (!row) return Astro.redirect("/admin/stundenzettel?zettel=missing");
const customers = db && !row.signed_at ? await listCustomers(db) : [];
const lines = readTimesheetLines(row.lines_json);
const number = timesheetNumber(row.id, row.created_at);
const flag = Astro.url.searchParams.get("zettel");
const messages: Record<string, string> = {
  saved: "Gespeichert. Jetzt kann unterschrieben werden.",
  signed: "Der Stundenzettel ist unterschrieben und festgeschrieben.",
  sign: "Die Unterschrift ist unvollständig. Beim Mitarbeiter gehören Name und Stiftstrich zusammen. Beim Auftraggeber ebenso, wenn du ihn mit unterschreiben lässt.",
  bad: "Bitte die Zeiten prüfen. Das Ende muss nach dem Beginn liegen.",
  locked: "Dieser Stundenzettel ist schon festgeschrieben.",
};
---

<AdminLayout title={number} session={session}>
  <section class="rounded-3xl border border-ink-200 bg-white p-6 dark:border-white/10 dark:bg-ink-900">
    <a href="/admin/stundenzettel" class="text-sm text-ink-500 hover:text-brand-700 dark:text-ink-400">← Alle Stundenzettel</a>
    <div class="mt-3 flex flex-wrap items-start justify-between gap-3">
      <div>
        <p class="text-xs font-semibold uppercase tracking-wider text-ink-500 dark:text-ink-400">Stundenzettel</p>
        <h2 class="mt-1 font-display text-2xl font-bold text-ink-900 dark:text-ink-50">{number}</h2>
        <p class="mt-1 text-sm text-ink-600 dark:text-ink-300">
          {row.customer_name} · {workDateLabel(row.work_date)} · {formatMinutes(row.total_minutes)} ({formatDecimalHours(row.total_minutes)} Std.)
        </p>
      </div>
      <a href={`/api/admin/stundenzettel-pdf?id=${row.id}`} target="_blank" class="rounded-full border border-ink-200 bg-white px-4 py-2 text-sm font-semibold text-ink-800 dark:border-white/10 dark:bg-white/5 dark:text-ink-100">PDF</a>
    </div>
    {flag && messages[flag] && (
      <p class="mt-4 rounded-2xl border border-ink-200 bg-ink-50 px-4 py-3 text-sm text-ink-800 dark:border-white/10 dark:bg-white/5 dark:text-ink-100">{messages[flag]}</p>
    )}
    {row.signed_at ? (
      <div class="mt-5 grid gap-2 text-sm text-ink-700 dark:text-ink-200">
        <p>Festgeschrieben am {formatBerlin(row.signed_at)}.</p>
        <p>Mitarbeiter: {row.signer_name}</p>
        <p>{row.customer_signer_name ? `Auftraggeber: ${row.customer_signer_name}` : "Ohne Unterschrift des Auftraggebers."}</p>
        {row.content_hash && <p class="break-all text-xs text-ink-500 dark:text-ink-400">Prüfwert {row.content_hash}</p>}
        <p>{TIMESHEET_SIGN_NOTE}</p>
      </div>
    ) : (
      <div class="mt-5 grid gap-8">
        <TimesheetForm
          customers={customers.map((customer) => ({ ...customer, name: decodeHtmlEntities(customer.name) }))}
          customerId={row.customer_id}
          customerName={row.customer_name}
          street={row.street}
          postalCode={row.postal_code}
          city={row.city}
          employeeName={row.employee_name}
          workDate={row.work_date}
          note={row.note}
          lines={lines}
          hidden={[{ name: "action", value: "update" }, { name: "id", value: String(row.id) }]}
          submitLabel="Zeiten speichern"
        />
        <form method="POST" action="/api/admin/stundenzettel" class="grid gap-4 border-t border-ink-100 pt-6 dark:border-white/10">
          <input type="hidden" name="action" value="sign" />
          <input type="hidden" name="id" value={row.id} />
          <div>
            <h3 class="font-display text-xl font-bold text-ink-900 dark:text-ink-50">Unterschreiben</h3>
            <p class="mt-1 text-sm text-ink-600 dark:text-ink-300">
              Auf dem Tablet mit dem Stift in das weiße Feld schreiben. Es gilt der gespeicherte Stand, Änderungen oben zuerst speichern. Die Mitarbeiter-Unterschrift schreibt den Zettel fest. Die Unterschrift des Auftraggebers kann dazu, wenn die Person vor Ort ist.
            </p>
          </div>
          <SignaturePad name="employee" label="Unterschrift Mitarbeiter" hint="Pflicht. Name und Stiftstrich." required />
          <SignaturePad name="client" label="Unterschrift Auftraggeber" hint="Optional. Mit Stift im weißen Feld unterschreiben." />
          <p class="text-xs text-ink-500 dark:text-ink-400">{TIMESHEET_SIGN_NOTE}</p>
          <button type="submit" class="btn-primary w-fit">Unterschreiben und festschreiben</button>
        </form>
        <form method="POST" action="/api/admin/stundenzettel" onsubmit="return confirm('Diesen offenen Stundenzettel löschen?')">
          <input type="hidden" name="action" value="delete" />
          <input type="hidden" name="id" value={row.id} />
          <button type="submit" class="text-sm font-semibold text-rose-700 dark:text-rose-200">Zettel löschen</button>
        </form>
      </div>
    )}
  </section>
</AdminLayout>
