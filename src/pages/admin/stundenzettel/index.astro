---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { requireSession } from "../../../lib/auth";
import { getDb } from "../../../lib/db";
import { formatDecimalHours, formatMinutes, timesheetNumber } from "../../../lib/timesheet";
import { listTimesheets, workDateLabel } from "../../../lib/timesheets";

export const prerender = false;

const sessionOrRedirect = await requireSession(Astro);
if (sessionOrRedirect instanceof Response) return sessionOrRedirect;
const session = sessionOrRedirect;
const db = getDb(Astro);
const rows = db ? await listTimesheets(db) : [];
const flag = Astro.url.searchParams.get("zettel");
const messages: Record<string, string> = {
  deleted: "Der Stundenzettel ist gelöscht.",
  missing: "Der Stundenzettel wurde nicht gefunden.",
  locked: "Ein unterschriebener Stundenzettel bleibt bestehen.",
  db: "Die Datenbank ist nicht verbunden.",
};
---

<AdminLayout title="Stundenzettel" session={session}>
  <section class="rounded-3xl border border-ink-200 bg-white p-6 dark:border-white/10 dark:bg-ink-900">
    <div class="flex flex-wrap items-start justify-between gap-3">
      <div>
        <h2 class="font-display text-2xl font-bold text-ink-900 dark:text-ink-50">Stundenzettel</h2>
        <p class="mt-1 text-sm text-ink-600 dark:text-ink-300">
          Zeiten für einen Arbeitstag. Auf dem Tablet mit dem Stift unterschreiben, danach ist der Zettel festgeschrieben.
        </p>
      </div>
      <a href="/admin/stundenzettel/neu" class="btn-primary">Neuer Stundenzettel</a>
    </div>
    {flag && messages[flag] && (
      <p class="mt-4 rounded-2xl border border-ink-200 bg-ink-50 px-4 py-3 text-sm text-ink-800 dark:border-white/10 dark:bg-white/5 dark:text-ink-100">{messages[flag]}</p>
    )}
    {rows.length === 0 ? (
      <p class="mt-6 text-sm text-ink-500 dark:text-ink-400">Noch kein Stundenzettel.</p>
    ) : (
      <ul class="mt-6 divide-y divide-ink-100 dark:divide-white/10">
        {rows.map((row) => (
          <li class="flex flex-wrap items-center justify-between gap-3 py-3">
            <div>
              <a href={`/admin/stundenzettel/${row.id}`} class="font-semibold text-ink-900 underline dark:text-ink-50">
                {timesheetNumber(row.id, row.created_at)} · {row.customer_name}
              </a>
              <p class="text-sm text-ink-600 dark:text-ink-300">
                {workDateLabel(row.work_date)} · {row.employee_name} · {formatMinutes(row.total_minutes)} ({formatDecimalHours(row.total_minutes)} Std.)
              </p>
            </div>
            <span class:list={[
              "rounded-full px-3 py-1 text-xs font-semibold",
              row.signed_at
                ? "bg-emerald-50 text-emerald-800 dark:bg-emerald-500/10 dark:text-emerald-100"
                : "bg-amber-50 text-amber-900 dark:bg-amber-500/10 dark:text-amber-100",
            ]}>
              {row.signed_at ? "Unterschrieben" : "Offen"}
            </span>
          </li>
        ))}
      </ul>
    )}
  </section>
</AdminLayout>
