---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { requireSession } from "../../../lib/auth";
import { findUserById, getDb, listMailboxes, listUsers } from "../../../lib/db";
import { localPartFromName, mailboxAddress, mailboxOwnerLabel } from "../../../lib/mailbox";
import { formatUserSignature } from "../../../lib/user-name";

export const prerender = false;

const sessionOrRedirect = await requireSession(Astro);
if (sessionOrRedirect instanceof Response) return sessionOrRedirect;
const session = sessionOrRedirect;

const db = getDb(Astro);
const domain = Astro.locals.runtime?.env?.REPLY_DOMAIN || "zeus-service.de";
const isAdmin = session.role === "admin";
const mailboxes = db
  ? await listMailboxes(db, isAdmin ? undefined : session.userId ?? -1)
  : [];
const users = db && isAdmin ? await listUsers(db) : [];
const user = db && session.userId ? await findUserById(db, session.userId) : null;
const suggested = user ? localPartFromName(user.first_name, user.last_name) : null;

const flag = Astro.url.searchParams.get("mail");
const flags: Record<string, { kind: "ok" | "err"; text: string }> = {
  created: { kind: "ok", text: "Die Adresse ist angelegt." },
  assigned: { kind: "ok", text: "Die Zuordnung ist gespeichert." },
  exists: { kind: "err", text: "Diese Adresse gibt es schon." },
  bad_address: {
    kind: "err",
    text: "Die Adresse darf Buchstaben, Zahlen, Punkte und Bindestriche enthalten, zum Beispiel vor.nachname.",
  },
  bad_user: { kind: "err", text: "Der gewählte Benutzer wurde nicht gefunden." },
  forbidden: { kind: "err", text: "Dieses Postfach ist einem anderen Benutzer zugeordnet." },
  full: { kind: "err", text: "Es sind schon 30 Adressen angelegt." },
  not_found: { kind: "err", text: "Das Postfach wurde nicht gefunden." },
};
const message = flag ? flags[flag] : null;

const userLabel = (person: { first_name: string; last_name: string; username: string }) =>
  formatUserSignature(person.first_name, person.last_name, person.username);
---

<AdminLayout title="Postfach" session={session}>
  {message && (
    <p
      class:list={[
        "rounded-2xl border px-4 py-3 text-sm",
        message.kind === "ok"
          ? "border-emerald-200 bg-emerald-50 text-emerald-800 dark:border-emerald-400/30 dark:bg-emerald-500/10 dark:text-emerald-100"
          : "border-rose-200 bg-rose-50 text-rose-800 dark:border-rose-400/30 dark:bg-rose-500/10 dark:text-rose-100",
      ]}
    >
      {message.text}
    </p>
  )}

  <section class="grid gap-4 sm:grid-cols-2">
    {mailboxes.map((box) => (
      <article class="rounded-3xl border border-ink-200 bg-white p-5 dark:border-white/10 dark:bg-ink-900">
        <a href={`/admin/postfach/${box.id}`} class="block">
          <p class="text-xs font-semibold uppercase tracking-widest text-brand-600 dark:text-brand-300">Postfach öffnen</p>
          <h2 class="mt-1 font-display text-xl font-bold text-ink-900 dark:text-ink-50">
            {mailboxAddress(box.local_part, domain)}
          </h2>
          <p class="mt-1 text-sm text-ink-600 dark:text-ink-300">
            {box.display_name || box.local_part}
            {" · "}
            {mailboxOwnerLabel(box)}
            {" · "}
            {box.thread_count === 1 ? "1 Verlauf" : `${box.thread_count} Verläufe`}
          </p>
          <span class="mt-4 inline-flex rounded-full bg-brand-600 px-4 py-2 text-sm font-semibold text-white">Öffnen</span>
        </a>
        {isAdmin && (
          <form method="POST" action="/api/admin/postfach" class="mt-4 flex flex-wrap items-end gap-2 border-t border-ink-100 pt-4 dark:border-white/10">
            <input type="hidden" name="action" value="assign" />
            <input type="hidden" name="mailbox_id" value={box.id} />
            <input type="hidden" name="redirect" value="/admin/postfach" />
            <div class="min-w-0 flex-1">
              <label class="label" for={`owner-${box.id}`}>Benutzer</label>
              <select class="input" id={`owner-${box.id}`} name="user_id">
                <option value="" selected={box.user_id == null}>Nicht zugeordnet</option>
                {users.map((person) => (
                  <option value={person.id} selected={person.id === box.user_id}>
                    {userLabel(person)}
                  </option>
                ))}
              </select>
            </div>
            <button type="submit" class="btn-secondary">Zuordnen</button>
          </form>
        )}
      </article>
    ))}
    {mailboxes.length === 0 && (
      <p class="rounded-3xl border border-dashed border-ink-200 px-5 py-8 text-sm text-ink-500 dark:border-white/10 dark:text-ink-400 sm:col-span-2">
        Dir ist noch kein Postfach zugeordnet.
      </p>
    )}
  </section>

  <section class="rounded-3xl border border-ink-200 bg-white p-6 dark:border-white/10 dark:bg-ink-900">
    <h2 class="font-display text-xl font-bold text-ink-900 dark:text-ink-50">Neue Adresse</h2>
    <p class="mt-1 text-sm text-ink-600 dark:text-ink-300">
      Zum Beispiel info@{domain} oder vor.nachname@{domain}. Das Postfach öffnet sich danach wie ein Webmail.
    </p>
    <form method="POST" action="/api/admin/postfach" class="mt-5 grid gap-3 sm:grid-cols-2 lg:grid-cols-4 lg:items-end">
      <input type="hidden" name="action" value="create" />
      <input type="hidden" name="redirect" value="/admin/postfach" />
      <div>
        <label class="label" for="local_part">Adresse</label>
        <div class="flex items-center gap-2">
          <input class="input" id="local_part" name="local_part" required minlength="2" maxlength="64" placeholder="vor.nachname" />
          <span class="shrink-0 text-sm text-ink-500">@{domain}</span>
        </div>
      </div>
      <div>
        <label class="label" for="display_name">Anzeigename</label>
        <input class="input" id="display_name" name="display_name" maxlength="80" placeholder="Leon Lütcke" />
      </div>
      {isAdmin ? (
        <div>
          <label class="label" for="user_id">Benutzer</label>
          <select class="input" id="user_id" name="user_id">
            <option value="">Nicht zugeordnet</option>
            {users.map((person) => (
              <option value={person.id} selected={person.id === session.userId}>{userLabel(person)}</option>
            ))}
          </select>
        </div>
      ) : (
        <input type="hidden" name="user_id" value={session.userId ?? ""} />
      )}
      <button type="submit" class="btn-primary">Adresse anlegen</button>
    </form>
    {suggested && (
      <button type="button" class="mt-3 text-sm font-semibold text-brand-700 dark:text-brand-200" id="use-name" data-local={suggested}>
        Vorschlag aus dem Namen: {suggested}@{domain}
      </button>
    )}
  </section>
</AdminLayout>

<script>
  const button = document.getElementById("use-name");
  const field = document.getElementById("local_part");
  if (button instanceof HTMLButtonElement && field instanceof HTMLInputElement) {
    button.addEventListener("click", () => {
      field.value = button.dataset.local ?? "";
    });
  }
</script>
