---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { requireSession } from "../../../lib/auth";
import { findUserById, getDb, listMailboxes, listMailThreads } from "../../../lib/db";
import { localPartFromName, mailboxAddress } from "../../../lib/mailbox";

export const prerender = false;

const sessionOrRedirect = await requireSession(Astro);
if (sessionOrRedirect instanceof Response) return sessionOrRedirect;
const session = sessionOrRedirect;

const db = getDb(Astro);
const domain = Astro.locals.runtime?.env?.REPLY_DOMAIN || "zeus-service.de";
const mailboxes = db ? await listMailboxes(db) : [];
const threads = db ? await listMailThreads(db) : [];
const user = db && session.userId ? await findUserById(db, session.userId) : null;
const suggested = user ? localPartFromName(user.first_name, user.last_name) : null;

const flag = Astro.url.searchParams.get("mail");
const flags: Record<string, { kind: "ok" | "err"; text: string }> = {
  created: { kind: "ok", text: "Die Adresse ist angelegt. Eingehende Mails erscheinen in diesem Postfach." },
  exists: { kind: "err", text: "Diese Adresse gibt es schon." },
  bad_address: {
    kind: "err",
    text: "Die Adresse darf Buchstaben, Zahlen, Punkte und Bindestriche enthalten, zum Beispiel vor.nachname.",
  },
  full: { kind: "err", text: "Es sind schon 30 Adressen angelegt." },
};

const message = flag ? flags[flag] : null;
const formatDate = (ts: number) =>
  new Date(ts * 1000).toLocaleString("de-DE", { dateStyle: "medium", timeStyle: "short" });
---

<AdminLayout title="Postfach" session={session}>
  {message && (
    <p
      class:list={[
        "rounded-2xl border px-4 py-3 text-sm",
        message.kind === "ok"
          ? "border-emerald-200 bg-emerald-50 text-emerald-800 dark:border-emerald-400/30 dark:bg-emerald-500/10 dark:text-emerald-100"
          : "border-rose-200 bg-rose-50 text-rose-800 dark:border-rose-400/30 dark:bg-rose-500/10 dark:text-rose-100",
      ]}
    >
      {message.text}
    </p>
  )}

  <section class="rounded-3xl border border-ink-200 bg-white p-6 dark:border-white/10 dark:bg-ink-900">
    <div class="flex flex-wrap items-start justify-between gap-4">
      <div>
        <h2 class="font-display text-xl font-bold text-ink-900 dark:text-ink-50">Adressen</h2>
        <p class="mt-1 max-w-2xl text-sm text-ink-600 dark:text-ink-300">
          Von hier aus geht eine Mail an jede Empfängeradresse. Antworten kommen an die gewählte
          Adresse zurück, zum Beispiel info@{domain} oder vor.nachname@{domain}.
        </p>
      </div>
      <a href="/admin/postfach/neu" class="btn-primary">Neue Mail</a>
    </div>

    <ul class="mt-5 flex flex-wrap gap-2">
      {mailboxes.map((box) => (
        <li class="rounded-full border border-ink-200 px-3 py-1 text-sm text-ink-800 dark:border-white/10 dark:text-ink-100">
          <strong>{box.display_name || box.local_part}</strong>
          <span class="text-ink-500 dark:text-ink-400"> · {mailboxAddress(box.local_part, domain)}</span>
        </li>
      ))}
    </ul>

    <form method="POST" action="/api/admin/postfach" class="mt-6 grid gap-3 sm:grid-cols-[1fr_1fr_auto] sm:items-end">
      <input type="hidden" name="action" value="create" />
      <input type="hidden" name="redirect" value="/admin/postfach" />
      <div>
        <label class="label" for="local_part">Neue Adresse</label>
        <div class="flex items-center gap-2">
          <input class="input" id="local_part" name="local_part" required minlength="2" maxlength="64" placeholder="vor.nachname" />
          <span class="shrink-0 text-sm text-ink-500">@{domain}</span>
        </div>
      </div>
      <div>
        <label class="label" for="display_name">Anzeigename</label>
        <input class="input" id="display_name" name="display_name" maxlength="80" placeholder="Leon Lütcke" />
      </div>
      <button type="submit" class="btn-secondary">Adresse anlegen</button>
    </form>
    {suggested && (
      <button type="button" class="mt-3 text-sm font-semibold text-brand-700 dark:text-brand-200" id="use-name" data-local={suggested}>
        Vorschlag aus dem Namen: {suggested}@{domain}
      </button>
    )}
  </section>

  <section class="space-y-3">
    <h2 class="font-display text-lg font-bold text-ink-900 dark:text-ink-50">Verläufe</h2>
    {threads.length === 0 ? (
      <p class="rounded-2xl border border-dashed border-ink-200 px-5 py-8 text-sm text-ink-500 dark:border-white/10 dark:text-ink-400">
        Noch keine Mails. Neue Nachrichten an info@{domain} erscheinen hier.
      </p>
    ) : (
      threads.map((thread) => (
        <a
          href={`/admin/postfach/${thread.id}`}
          class="block rounded-2xl border border-ink-200 bg-white px-5 py-4 dark:border-white/10 dark:bg-ink-900"
        >
          <div class="flex flex-wrap items-baseline justify-between gap-2">
            <p class="font-semibold text-ink-900 dark:text-ink-50">{thread.subject || "(Ohne Betreff)"}</p>
            <p class="text-xs text-ink-500">{formatDate(thread.updated_at)}</p>
          </div>
          <p class="mt-1 text-sm text-ink-600 dark:text-ink-300">
            {thread.peer_name ? `${thread.peer_name} · ` : ""}{thread.peer_email}
            <span class="text-ink-400"> · {mailboxAddress(thread.local_part, domain)}</span>
          </p>
        </a>
      ))
    )}
  </section>
</AdminLayout>

<script>
  const button = document.getElementById("use-name");
  const field = document.getElementById("local_part");
  if (button instanceof HTMLButtonElement && field instanceof HTMLInputElement) {
    button.addEventListener("click", () => {
      field.value = button.dataset.local ?? "";
    });
  }
</script>
