---
import AdminLayout from "../../layouts/AdminLayout.astro";
import { requireSession } from "../../lib/auth";
import {
  countContactRequestsByStatus,
  getDb,
  listContactRequests,
  type ContactStatus,
} from "../../lib/db";
import { decodeHtmlEntities } from "../../lib/html-entities";
import { formatBerlin } from "../../lib/time";

export const prerender = false;

const sessionOrRedirect = await requireSession(Astro);
if (sessionOrRedirect instanceof Response) return sessionOrRedirect;
const session = sessionOrRedirect;

const db = getDb(Astro);
const statusFilter = (Astro.url.searchParams.get("status") ?? "all") as
  | ContactStatus
  | "all";

const entries = db ? await listContactRequests(db, { status: statusFilter }) : [];
const counts = db
  ? await countContactRequestsByStatus(db)
  : { new: 0, in_progress: 0, done: 0, archived: 0 };
const total = counts.new + counts.in_progress + counts.done + counts.archived;

const statusLabels: Record<ContactStatus | "all", string> = {
  all: "Alle",
  new: "Neu",
  in_progress: "In Bearbeitung",
  done: "Erledigt",
  archived: "Archiv",
};

const statusChipClasses: Record<ContactStatus, string> = {
  new: "bg-brand-50 text-brand-700 dark:bg-brand-500/15 dark:text-brand-200",
  in_progress: "bg-amber-50 text-amber-700 dark:bg-amber-500/15 dark:text-amber-200",
  done: "bg-emerald-50 text-emerald-700 dark:bg-emerald-500/15 dark:text-emerald-200",
  archived: "bg-ink-100 text-ink-600 dark:bg-white/10 dark:text-ink-300",
};

const nextStatus: Record<ContactStatus, ContactStatus> = {
  new: "in_progress",
  in_progress: "done",
  done: "archived",
  archived: "new",
};

const formatDate = (ts: number) => formatBerlin(ts);

const topicLabels: Record<string, string> = {
  reparatur: "Reparatur",
  reinigung: "Reinigung",
  wartung: "Wartung",
  gartenpflege: "Gartenpflege",
  winterdienst: "Winterdienst",
  objektbetreuung: "Objektbetreuung",
  sonstiges: "Sonstiges",
};

const tabs: Array<{ status: ContactStatus | "all"; count: number }> = [
  { status: "all", count: total },
  { status: "new", count: counts.new },
  { status: "in_progress", count: counts.in_progress },
  { status: "done", count: counts.done },
  { status: "archived", count: counts.archived },
];
---

<AdminLayout title="Anfragen" session={session}>
  {
    !db && (
      <section class="rounded-3xl border border-dashed border-amber-300 bg-amber-50/50 p-8 dark:border-amber-400/30 dark:bg-amber-500/5">
        <h2 class="font-display text-xl font-bold text-amber-900 dark:text-amber-200">
          D1-Datenbank nicht verbunden
        </h2>
        <p class="mt-2 text-sm text-amber-800 dark:text-amber-100 max-w-2xl">
          Es ist keine Cloudflare-D1-Datenbank an diesen Worker gebunden.
          Führe <code class="rounded bg-amber-100 px-1.5 py-0.5 dark:bg-amber-500/20">bash scripts/setup-cloudflare.sh</code>
          aus oder aktiviere den <code class="rounded bg-amber-100 px-1.5 py-0.5 dark:bg-amber-500/20">DB</code>-Block
          in <code class="rounded bg-amber-100 px-1.5 py-0.5 dark:bg-amber-500/20">wrangler.jsonc</code> manuell.
        </p>
      </section>
    )
  }

  {
    db && (
      <>
        <section class="flex flex-wrap items-center gap-2">
          <a href="/admin/sperren" class="text-sm font-medium text-ink-500 underline hover:text-brand-700 dark:text-ink-400">
            Gesperrte Absender
          </a>
          {tabs.map((tab) => {
            const active = tab.status === statusFilter;
            const href =
              tab.status === "all"
                ? "/admin/anfragen"
                : `/admin/anfragen?status=${tab.status}`;
            return (
              <a
                href={href}
                class={`inline-flex items-center gap-2 rounded-full border px-4 py-1.5 text-sm font-medium transition ${
                  active
                    ? "border-brand-500 bg-brand-500 text-white"
                    : "border-ink-200 bg-white text-ink-700 hover:bg-ink-100 dark:border-white/10 dark:bg-white/5 dark:text-ink-200 dark:hover:bg-white/10"
                }`}
              >
                {statusLabels[tab.status]}
                <span
                  class={`rounded-full px-2 py-0.5 text-xs ${
                    active
                      ? "bg-white/20"
                      : "bg-ink-100 text-ink-600 dark:bg-white/10 dark:text-ink-300"
                  }`}
                >
                  {tab.count}
                </span>
              </a>
            );
          })}
        </section>

        {entries.length === 0 ? (
          <section class="rounded-3xl border border-dashed border-ink-300 bg-white p-10 text-center dark:border-white/15 dark:bg-ink-900">
            <p class="text-sm text-ink-600 dark:text-ink-300">
              Keine Anfragen in dieser Ansicht.
            </p>
          </section>
        ) : (
          <section class="space-y-4">
            {entries.map((entry) => (
              <article class="rounded-2xl border border-ink-200 bg-white p-6 dark:border-white/10 dark:bg-ink-900">
                <header class="flex flex-wrap items-start justify-between gap-3">
                  <div>
                    <div class="flex flex-wrap items-center gap-2">
                      <h3 class="font-display text-lg font-semibold text-ink-900 dark:text-ink-50">
                        <a
                          href={`/admin/anfragen/${entry.id}`}
                          class="hover:text-brand-600 dark:hover:text-brand-300 transition-colors"
                        >
                          {decodeHtmlEntities(entry.name)}
                        </a>
                      </h3>
                      <span
                        class={`rounded-full px-2.5 py-0.5 text-xs font-semibold ${statusChipClasses[entry.status]}`}
                      >
                        {statusLabels[entry.status]}
                      </span>
                      <span class="rounded-full bg-ink-100 px-2.5 py-0.5 text-xs text-ink-700 dark:bg-white/10 dark:text-ink-200">
                        {topicLabels[entry.topic] ?? entry.topic}
                      </span>
                      {entry.last_reply_direction === "inbound" && (
                        <span class="rounded-full bg-brand-50 px-2.5 py-0.5 text-xs font-semibold text-brand-700 dark:bg-brand-500/15 dark:text-brand-200">
                          Kunde hat geantwortet
                        </span>
                      )}
                    </div>
                    <p class="mt-1 text-xs text-ink-500 dark:text-ink-400">
                      #{entry.id} · eingegangen {formatDate(entry.created_at)}
                      {entry.country && entry.country !== "unknown"
                        ? ` · ${entry.country}`
                        : ""}
                    </p>
                  </div>
                  <div class="flex flex-wrap items-center gap-2 text-sm">
                    <a
                      href={`mailto:${entry.email}`}
                      class="rounded-full border border-ink-200 bg-white px-3 py-1.5 font-medium text-ink-800 hover:bg-ink-100 dark:border-white/10 dark:bg-white/5 dark:text-ink-100 dark:hover:bg-white/10"
                    >
                      {entry.email}
                    </a>
                    {entry.phone && (
                      <a
                        href={`tel:${entry.phone}`}
                        class="rounded-full border border-ink-200 bg-white px-3 py-1.5 font-medium text-ink-800 hover:bg-ink-100 dark:border-white/10 dark:bg-white/5 dark:text-ink-100 dark:hover:bg-white/10"
                      >
                        {entry.phone}
                      </a>
                    )}
                  </div>
                </header>

                <p class="mt-4 whitespace-pre-line text-sm leading-relaxed text-ink-700 dark:text-ink-200">
                  {decodeHtmlEntities(entry.message)}
                </p>

                <div class="mt-4">
                  <a
                    href={`/admin/anfragen/${entry.id}`}
                    class="inline-flex items-center gap-1.5 text-sm font-semibold text-brand-700 hover:text-brand-800 dark:text-brand-300 dark:hover:text-brand-200"
                  >
                    Öffnen & antworten
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4">
                      <line x1="5" y1="12" x2="19" y2="12" />
                      <polyline points="12 5 19 12 12 19" />
                    </svg>
                  </a>
                </div>

                <footer class="mt-5 flex flex-wrap items-center justify-between gap-3 border-t border-ink-200/70 pt-4 dark:border-white/10">
                  <form
                    method="POST"
                    action="/api/admin/anfragen"
                    class="inline-flex items-center gap-2"
                  >
                    <input type="hidden" name="id" value={entry.id} />
                    <input type="hidden" name="action" value="status" />
                    <input
                      type="hidden"
                      name="status"
                      value={nextStatus[entry.status]}
                    />
                    <input
                      type="hidden"
                      name="redirect"
                      value={Astro.url.pathname + Astro.url.search}
                    />
                    <button
                      type="submit"
                      class="inline-flex items-center gap-1.5 rounded-full bg-brand-600 px-3 py-1.5 text-xs font-semibold text-white hover:bg-brand-700 dark:bg-brand-500 dark:text-ink-950 dark:hover:bg-brand-400"
                    >
                      Status → {statusLabels[nextStatus[entry.status]]}
                    </button>
                  </form>

                  <div class="inline-flex items-center gap-2">
                    {(["new", "in_progress", "done", "archived"] as ContactStatus[])
                      .filter((s) => s !== entry.status)
                      .map((s) => (
                        <form
                          method="POST"
                          action="/api/admin/anfragen"
                          class="inline"
                        >
                          <input type="hidden" name="id" value={entry.id} />
                          <input type="hidden" name="action" value="status" />
                          <input type="hidden" name="status" value={s} />
                          <input
                            type="hidden"
                            name="redirect"
                            value={Astro.url.pathname + Astro.url.search}
                          />
                          <button
                            type="submit"
                            class="rounded-full border border-ink-200 bg-white px-3 py-1.5 text-xs font-medium text-ink-700 hover:bg-ink-100 dark:border-white/10 dark:bg-white/5 dark:text-ink-200 dark:hover:bg-white/10"
                          >
                            {statusLabels[s]}
                          </button>
                        </form>
                      ))}
                    <form
                      method="POST"
                      action="/api/admin/anfragen"
                      onsubmit="return confirm('Diese Anfrage wirklich löschen?')"
                      class="inline"
                    >
                      <input type="hidden" name="id" value={entry.id} />
                      <input type="hidden" name="action" value="delete" />
                      <input
                        type="hidden"
                        name="redirect"
                        value={Astro.url.pathname + Astro.url.search}
                      />
                      <button
                        type="submit"
                        class="rounded-full border border-rose-200 bg-white px-3 py-1.5 text-xs font-medium text-rose-700 hover:bg-rose-50 dark:border-rose-400/30 dark:bg-rose-500/5 dark:text-rose-200 dark:hover:bg-rose-500/15"
                      >
                        Löschen
                      </button>
                    </form>
                  </div>
                </footer>
              </article>
            ))}
          </section>
        )}
      </>
    )
  }
</AdminLayout>
