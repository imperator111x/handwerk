---
import AdminLayout from "../../layouts/AdminLayout.astro";
import { requireSession } from "../../lib/auth";

export const prerender = false;

const sessionOrRedirect = await requireSession(Astro);
if (sessionOrRedirect instanceof Response) return sessionOrRedirect;
const session = sessionOrRedirect;
---

<AdminLayout title="Anfragen" session={session}>
  <section
    class="rounded-3xl border border-dashed border-ink-300 bg-white p-10 text-center space-y-4 dark:border-white/15 dark:bg-ink-900"
  >
    <div
      class="mx-auto h-14 w-14 rounded-2xl bg-brand-50 text-brand-600 inline-flex items-center justify-center dark:bg-brand-500/15 dark:text-brand-300"
      aria-hidden="true"
    >
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="h-7 w-7"
      >
        <path
          d="M22 12h-6l-2 3h-4l-2-3H2 M5.45 5.11L2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z"
        />
      </svg>
    </div>
    <h2 class="font-display text-2xl font-bold text-ink-900 dark:text-ink-50">
      Noch keine Anfragen gespeichert
    </h2>
    <p class="text-ink-600 max-w-xl mx-auto dark:text-ink-300">
      Sobald die D1-Datenbank verbunden ist, werden eingehende
      Kontaktanfragen hier gelistet, mit Status, Suche und Export-Funktion.
      Aktuell werden Anfragen nur im Worker-Log festgehalten.
    </p>
  </section>
</AdminLayout>
