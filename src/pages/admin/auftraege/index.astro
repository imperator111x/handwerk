---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { requireSession } from "../../../lib/auth";
import { cfEnv } from "../../../lib/cf";
import { getDb, listOpenPortalJobs } from "../../../lib/db";
import { decodeHtmlEntities } from "../../../lib/html-entities";
import {
  countJobsByStatus,
  filterAuftraege,
  JOB_STATUS_LABELS,
  JOB_STATUSES,
  jobStatusForQuote,
  nextJobActions,
  type JobStatus,
} from "../../../lib/jobs";
import {
  canOpenScan,
  fileHref,
  isPreviewImage,
  listFilesForRequests,
  refreshPendingFiles,
  type MailFileRow,
} from "../../../lib/mail-files";
import { listAllQuotes } from "../../../lib/offers";
import { formatEuro, formatOfferDate, offerNumber } from "../../../lib/quote";
import { formatBerlin } from "../../../lib/time";

export const prerender = false;

const sessionOrRedirect = await requireSession(Astro);
if (sessionOrRedirect instanceof Response) return sessionOrRedirect;
const session = sessionOrRedirect;

const db = getDb(Astro);
const env = cfEnv();
const standParam = Astro.url.searchParams.get("stand");
const stand: JobStatus | "alle" =
  standParam === "alle" || JOB_STATUSES.includes(standParam as JobStatus)
    ? (standParam as JobStatus | "alle")
    : "alle";
const notice = Astro.url.searchParams.get("auftrag");

const all = db ? await listAllQuotes(db) : [];
const counts = countJobsByStatus(all);
const rows = filterAuftraege(all, stand);
const portalJobs = db ? await listOpenPortalJobs(db) : [];
const requestIds = [
  ...portalJobs.map((job) => job.id),
  ...rows.map((quote) => quote.request_id).filter((id): id is number => Number.isInteger(id) && id > 0),
];
let files = db ? await listFilesForRequests(db, requestIds) : [];
if (env && files.some((file) => file.scan_status === "pending" || file.scan_status === "error")) {
  await refreshPendingFiles(env, files);
  files = db ? await listFilesForRequests(db, requestIds) : [];
}
const filesByRequest = new Map<number, MailFileRow[]>();
for (const file of files) {
  if (!file.request_id) continue;
  const list = filesByRequest.get(file.request_id) ?? [];
  list.push(file);
  filesByRequest.set(file.request_id, list);
}

const tabs: Array<{ id: JobStatus | "alle"; label: string }> = [
  { id: "alle", label: "Alle" },
  { id: "offen", label: "Offen" },
  { id: "in_arbeit", label: "In Arbeit" },
  { id: "fertig", label: "Fertig" },
  { id: "abgerechnet", label: "Abgerechnet" },
];

const notices: Record<string, string> = {
  saved: "Auftragsstatus gespeichert.",
  missing: "Auftrag nicht gefunden.",
};
const noticeText = notice ? notices[notice] : "";

const jobClass = (job: JobStatus) =>
  job === "in_arbeit"
    ? "bg-sky-50 text-sky-800 dark:bg-sky-500/15 dark:text-sky-100"
    : job === "fertig"
      ? "bg-amber-50 text-amber-800 dark:bg-amber-500/15 dark:text-amber-100"
      : job === "abgerechnet"
        ? "bg-emerald-50 text-emerald-800 dark:bg-emerald-500/15 dark:text-emerald-100"
        : "bg-ink-100 text-ink-700 dark:bg-white/10 dark:text-ink-200";

const previewImages = (requestId: number | null | undefined) => {
  if (!requestId) return [] as MailFileRow[];
  return (filesByRequest.get(requestId) ?? []).filter(
    (file) => canOpenScan(file.scan_status) && isPreviewImage(file.content_type),
  );
};
---

<AdminLayout title="Aufträge" session={session}>
  {portalJobs.length > 0 && (
    <section class="rounded-3xl border border-ink-200 bg-white p-6 dark:border-white/10 dark:bg-ink-900">
      <h2 class="font-display text-2xl font-bold text-ink-900 dark:text-ink-50">Aus dem Kundenportal</h2>
      <p class="mt-1 text-sm text-ink-600 dark:text-ink-300">
        Vom Kunden gemeldet – inkl. Fotos. Daraus kannst du ein Angebot machen.
      </p>
      <ul class="mt-6 divide-y divide-ink-100 dark:divide-white/10">
        {portalJobs.map((job) => {
          const images = previewImages(job.id);
          const pending = (filesByRequest.get(job.id) ?? []).some(
            (file) => file.scan_status === "pending" || file.scan_status === "error",
          );
          return (
            <li class="py-4">
              <div class="flex flex-wrap items-start justify-between gap-3">
                <div class="min-w-0">
                  <a href={`/admin/anfragen/${job.id}`} class="font-semibold text-ink-900 underline dark:text-ink-50">
                    {job.topic}
                  </a>
                  <p class="mt-1 text-sm text-ink-600 dark:text-ink-300">
                    {decodeHtmlEntities(job.name)} · {formatBerlin(job.created_at)}
                  </p>
                  <p class="mt-2 whitespace-pre-wrap text-sm text-ink-700 dark:text-ink-200">
                    {job.message.length > 280 ? `${job.message.slice(0, 280)}…` : job.message}
                  </p>
                </div>
                <span class="rounded-full bg-sky-50 px-2.5 py-1 text-xs font-semibold text-sky-800 dark:bg-sky-500/15 dark:text-sky-100">
                  Portal
                </span>
              </div>
              {images.length > 0 && (
                <div class="mt-3 flex flex-wrap gap-2">
                  {images.map((file) => (
                    <a href={fileHref(file.id)} data-astro-reload target="_blank" class="block">
                      <img
                        src={fileHref(file.id)}
                        alt={file.filename}
                        class="h-24 w-24 rounded-xl border border-ink-200 object-cover dark:border-white/10"
                      />
                    </a>
                  ))}
                </div>
              )}
              {pending && images.length === 0 && (
                <p class="mt-2 text-xs text-ink-500 dark:text-ink-400">Bilder werden noch geprüft.</p>
              )}
              <div class="mt-3">
                <a
                  href={`/admin/anfragen/${job.id}`}
                  class="rounded-full border border-ink-200 bg-white px-3 py-1.5 text-xs font-semibold text-ink-800 dark:border-white/10 dark:bg-white/5 dark:text-ink-100"
                >
                  Anfrage öffnen
                </a>
              </div>
            </li>
          );
        })}
      </ul>
    </section>
  )}

  <section class="rounded-3xl border border-ink-200 bg-white p-6 dark:border-white/10 dark:bg-ink-900">
    <h2 class="font-display text-2xl font-bold text-ink-900 dark:text-ink-50">Aufträge</h2>
    <p class="mt-1 text-sm text-ink-600 dark:text-ink-300">
      Angenommene Angebote mit Fortschritt: offen, in Arbeit, fertig, abgerechnet.
    </p>

    {noticeText && (
      <p class="mt-4 rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-800 dark:border-emerald-400/30 dark:bg-emerald-500/10 dark:text-emerald-100">
        {noticeText}
      </p>
    )}

    <div class="mt-5 flex flex-wrap gap-2">
      {tabs.map((tab) => (
        <a
          href={tab.id === "alle" ? "/admin/auftraege" : `/admin/auftraege?stand=${tab.id}`}
          class:list={[
            "rounded-full px-3 py-1.5 text-sm font-semibold",
            stand === tab.id
              ? "bg-brand-600 text-white dark:bg-brand-500 dark:text-ink-950"
              : "border border-ink-200 bg-white text-ink-700 dark:border-white/10 dark:bg-white/5 dark:text-ink-200",
          ]}
        >
          {tab.label} ({counts[tab.id]})
        </a>
      ))}
    </div>

    {rows.length === 0 ? (
      <p class="mt-6 text-sm text-ink-600 dark:text-ink-300">
        {stand === "alle" ? "Noch keine Aufträge. Nimm ein Angebot an, dann erscheint es hier." : "Keine Aufträge in diesem Stand."}
      </p>
    ) : (
      <ul class="mt-6 divide-y divide-ink-100 dark:divide-white/10">
        {rows.map((quote) => {
          const job = jobStatusForQuote(quote);
          const actions = nextJobActions(job);
          const name = decodeHtmlEntities(quote.customer_name || "Ohne Name");
          const images = previewImages(quote.request_id);
          return (
            <li class="py-4">
              <div class="flex flex-wrap items-start justify-between gap-3">
                <div class="min-w-0">
                  <a href={`/admin/angebote/${quote.id}`} class="font-semibold text-ink-900 underline dark:text-ink-50">
                    {offerNumber(quote.id, quote.created_at)} · {quote.title}
                  </a>
                  <p class="mt-1 text-sm text-ink-600 dark:text-ink-300">
                    {name}
                    {quote.customer_id ? (
                      <>
                        {" · "}
                        <a class="underline" href={`/admin/kunden/${quote.customer_id}`}>Kundenakte</a>
                      </>
                    ) : null}
                    {" · "}
                    {formatEuro(quote.price_cents)} · gültig bis {formatOfferDate(quote.valid_until)}
                  </p>
                </div>
                <span class:list={["rounded-full px-2.5 py-1 text-xs font-semibold", jobClass(job)]}>
                  {JOB_STATUS_LABELS[job]}
                </span>
              </div>
              {images.length > 0 && (
                <div class="mt-3 flex flex-wrap gap-2">
                  {images.map((file) => (
                    <a href={fileHref(file.id)} data-astro-reload target="_blank" class="block">
                      <img
                        src={fileHref(file.id)}
                        alt={file.filename}
                        class="h-20 w-20 rounded-xl border border-ink-200 object-cover dark:border-white/10"
                      />
                    </a>
                  ))}
                </div>
              )}
              <div class="mt-3 flex flex-wrap gap-2">
                {actions.map((next) => (
                  <form method="POST" action="/api/admin/angebote">
                    <input type="hidden" name="id" value={quote.id} />
                    <input type="hidden" name="action" value="job" />
                    <input type="hidden" name="job_status" value={next} />
                    <input type="hidden" name="redirect" value={stand === "alle" ? "/admin/auftraege?auftrag=saved" : `/admin/auftraege?stand=${stand}&auftrag=saved`} />
                    <button
                      type="submit"
                      class="rounded-full border border-ink-200 bg-white px-3 py-1.5 text-xs font-semibold text-ink-800 dark:border-white/10 dark:bg-white/5 dark:text-ink-100"
                    >
                      → {JOB_STATUS_LABELS[next]}
                    </button>
                  </form>
                ))}
                {job !== "abgerechnet" && (
                  <>
                    <a
                      href={`/admin/rechnungen/vorschau?angebot=${quote.id}`}
                      class="rounded-full border border-emerald-300 bg-emerald-50 px-3 py-1.5 text-xs font-semibold text-emerald-900 dark:border-emerald-400/40 dark:bg-emerald-500/15 dark:text-emerald-100"
                    >
                      PDF-Vorschau → Rechnung
                    </a>
                    <a
                      href={`/admin/rechnungen/neu?angebot=${quote.id}`}
                      class="rounded-full border border-ink-200 bg-white px-3 py-1.5 text-xs font-semibold text-ink-800 dark:border-white/10 dark:bg-white/5 dark:text-ink-100"
                    >
                      Bearbeiten
                    </a>
                    <a
                      href={`/admin/rechnungen/neu?angebot=${quote.id}&art=teil`}
                      class="rounded-full border border-ink-200 bg-white px-3 py-1.5 text-xs font-semibold text-ink-800 dark:border-white/10 dark:bg-white/5 dark:text-ink-100"
                    >
                      Teilrechnung
                    </a>
                  </>
                )}
              </div>
            </li>
          );
        })}
      </ul>
    )}
  </section>
</AdminLayout>
