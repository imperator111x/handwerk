---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { requireSession } from "../../../lib/auth";
import { formatAddress, formatSlot, getBookingForRequest, listOpenSlots } from "../../../lib/appointments";
import {
  getContactRequest,
  getDb,
  listReplies,
  type ContactReplyRow,
  type ContactStatus,
} from "../../../lib/db";
import { sanitizeMailHtml } from "../../../lib/mail-html";

export const prerender = false;

const sessionOrRedirect = await requireSession(Astro);
if (sessionOrRedirect instanceof Response) return sessionOrRedirect;
const session = sessionOrRedirect;

const idParam = Astro.params.id;
const id = Number.parseInt(idParam ?? "", 10);
if (!Number.isFinite(id) || id <= 0) {
  return Astro.redirect("/admin/anfragen");
}

const db = getDb(Astro);
const env = Astro.locals.runtime?.env;

const request = db ? await getContactRequest(db, id) : null;
if (!request) {
  return Astro.redirect("/admin/anfragen");
}

const replies: ContactReplyRow[] = db ? await listReplies(db, id) : [];
const booking = db ? await getBookingForRequest(db, id) : null;
const openSlotCount = db && !booking ? (await listOpenSlots(db)).length : 0;

const statusLabels: Record<ContactStatus, string> = {
  new: "Neu",
  in_progress: "In Bearbeitung",
  done: "Erledigt",
  archived: "Archiv",
};

const statusChipClasses: Record<ContactStatus, string> = {
  new: "bg-brand-50 text-brand-700 dark:bg-brand-500/15 dark:text-brand-200",
  in_progress: "bg-amber-50 text-amber-700 dark:bg-amber-500/15 dark:text-amber-200",
  done: "bg-emerald-50 text-emerald-700 dark:bg-emerald-500/15 dark:text-emerald-200",
  archived: "bg-ink-100 text-ink-600 dark:bg-white/10 dark:text-ink-300",
};

const topicLabels: Record<string, string> = {
  reparatur: "Reparatur",
  reinigung: "Reinigung",
  wartung: "Wartung",
  gartenpflege: "Gartenpflege",
  winterdienst: "Winterdienst",
  objektbetreuung: "Objektbetreuung",
  sonstiges: "Sonstiges",
};

const formatDate = (ts: number) =>
  new Date(ts * 1000).toLocaleString("de-DE", {
    dateStyle: "medium",
    timeStyle: "short",
  });

const siteName = env?.SITE_NAME ?? "Zeus-Service";
const defaultSubject = `Ihre Anfrage bei ${siteName} – ${topicLabels[request.topic] ?? request.topic}`;
const defaultBody = `vielen Dank für Ihre Anfrage. Gerne gehen wir auf Ihr Anliegen ein:

[hier den Antworttext einfügen]

Falls Sie weitere Fragen haben, melden Sie sich einfach – wir sind für Sie da.`;
const escapeEditor = (value: string) =>
  value.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
const defaultHtml = defaultBody
  .trim()
  .split(/\n{2,}/)
  .map((block) => `<p>${escapeEditor(block).replace(/\n/g, "<br>")}</p>`)
  .join("");

const replyFlag = Astro.url.searchParams.get("reply");
const replyFlags: Record<string, { kind: "ok" | "warn" | "err"; text: string }> = {
  sent: { kind: "ok", text: "Antwort gespeichert und per E-Mail verschickt." },
  saved_no_email: {
    kind: "warn",
    text: "Antwort gespeichert. E-Mail nicht verschickt – kein E-Mail-Transport verbunden.",
  },
  saved_email_failed: {
    kind: "err",
    text: "Antwort gespeichert, aber E-Mail-Versand ist fehlgeschlagen (Details in den Logs).",
  },
  bad_id: { kind: "err", text: "Ungültige Anfrage-ID." },
  bad_subject: { kind: "err", text: "Betreff muss zwischen 3 und 200 Zeichen haben." },
  bad_body: { kind: "err", text: "Die Nachricht ist zu kurz oder zu lang." },
  bad_file: {
    kind: "err",
    text: "Eine Datei ist zu groß oder nicht erlaubt. Bilder, PDF, Word, Excel und Text, je Datei und zusammen höchstens 3 MB.",
  },
  not_found: { kind: "err", text: "Anfrage nicht gefunden." },
  db_error: { kind: "err", text: "Fehler beim Speichern der Antwort." },
};
const replyFlagMsg = replyFlag ? replyFlags[replyFlag] : null;
const terminFlag = Astro.url.searchParams.get("termin");
const terminFlags: Record<string, string> = {
  sent: "Der Terminlink wurde per E-Mail verschickt.",
  saved: "Der Terminlink wurde gespeichert, aber nicht per E-Mail verschickt.",
  failed: "Der Terminlink konnte nicht per E-Mail verschickt werden.",
  no_slots: "Es gibt noch keine freien Termine. Tragen Sie zuerst welche unter Termine ein.",
  booked: "Für diese Anfrage ist bereits ein Termin gebucht.",
  cancelled: "Der Termin wurde storniert. Die Zeit ist wieder frei, der Kunde kann neu buchen.",
};

const redirectPath = Astro.url.pathname;
---

<AdminLayout title={`Anfrage #${request.id}`} session={session}>
  <nav class="text-sm">
    <a
      href="/admin/anfragen"
      class="inline-flex items-center gap-1.5 text-ink-600 hover:text-ink-900 dark:text-ink-300 dark:hover:text-ink-50"
    >
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4">
        <line x1="19" y1="12" x2="5" y2="12" />
        <polyline points="12 19 5 12 12 5" />
      </svg>
      Zurück zur Liste
    </a>
  </nav>

  {replyFlagMsg && (
    <div
      class={`rounded-xl border px-4 py-3 text-sm ${
        replyFlagMsg.kind === "ok"
          ? "border-emerald-200 bg-emerald-50 text-emerald-800 dark:border-emerald-400/20 dark:bg-emerald-500/10 dark:text-emerald-100"
          : replyFlagMsg.kind === "warn"
            ? "border-amber-200 bg-amber-50 text-amber-800 dark:border-amber-400/20 dark:bg-amber-500/10 dark:text-amber-100"
            : "border-rose-200 bg-rose-50 text-rose-800 dark:border-rose-400/20 dark:bg-rose-500/10 dark:text-rose-100"
      }`}
    >
      {replyFlagMsg.text}
    </div>
  )}

  <section class="rounded-3xl border border-ink-200 bg-white p-6 dark:border-white/10 dark:bg-ink-900">
    <header class="flex flex-wrap items-start justify-between gap-4">
      <div>
        <div class="flex flex-wrap items-center gap-2">
          <h2 class="font-display text-2xl font-bold text-ink-900 dark:text-ink-50">
            {request.name}
          </h2>
          <span class={`rounded-full px-2.5 py-0.5 text-xs font-semibold ${statusChipClasses[request.status]}`}>
            {statusLabels[request.status]}
          </span>
          <span class="rounded-full bg-ink-100 px-2.5 py-0.5 text-xs text-ink-700 dark:bg-white/10 dark:text-ink-200">
            {topicLabels[request.topic] ?? request.topic}
          </span>
        </div>
        <p class="mt-1 text-xs text-ink-500 dark:text-ink-400">
          #{request.id} · eingegangen {formatDate(request.created_at)}
          {request.country && request.country !== "unknown" ? ` · ${request.country}` : ""}
          {request.ip && request.ip !== "unknown" ? ` · ${request.ip}` : ""}
        </p>
      </div>
      <div class="flex flex-wrap items-center gap-2 text-sm">
        <a
          href={`mailto:${request.email}`}
          class="rounded-full border border-ink-200 bg-white px-3 py-1.5 font-medium text-ink-800 hover:bg-ink-100 dark:border-white/10 dark:bg-white/5 dark:text-ink-100 dark:hover:bg-white/10"
        >
          {request.email}
        </a>
        {request.phone && (
          <a
            href={`tel:${request.phone}`}
            class="rounded-full border border-ink-200 bg-white px-3 py-1.5 font-medium text-ink-800 hover:bg-ink-100 dark:border-white/10 dark:bg-white/5 dark:text-ink-100 dark:hover:bg-white/10"
          >
            {request.phone}
          </a>
        )}
      </div>
    </header>

    <article class="mt-5 rounded-2xl bg-ink-50 p-5 dark:bg-white/5">
      <p class="text-xs font-semibold uppercase tracking-wider text-ink-500 dark:text-ink-400">
        Nachricht des Kunden
      </p>
      <p class="mt-2 whitespace-pre-line text-sm leading-relaxed text-ink-800 dark:text-ink-100">
        {request.message}
      </p>
    </article>

    <footer class="mt-5 flex flex-wrap items-center gap-2 border-t border-ink-200/70 pt-4 dark:border-white/10">
      {(["new", "in_progress", "done", "archived"] as ContactStatus[])
        .filter((s) => s !== request.status)
        .map((s) => (
          <form method="POST" action="/api/admin/anfragen" class="inline">
            <input type="hidden" name="id" value={request.id} />
            <input type="hidden" name="action" value="status" />
            <input type="hidden" name="status" value={s} />
            <input type="hidden" name="redirect" value={redirectPath} />
            <button
              type="submit"
              class="rounded-full border border-ink-200 bg-white px-3 py-1.5 text-xs font-medium text-ink-700 hover:bg-ink-100 dark:border-white/10 dark:bg-white/5 dark:text-ink-200 dark:hover:bg-white/10"
            >
              Status → {statusLabels[s]}
            </button>
          </form>
        ))}
    </footer>
  </section>

  <section class="rounded-3xl border border-ink-200 bg-white p-6 dark:border-white/10 dark:bg-ink-900">
    <h3 class="font-display text-xl font-bold text-ink-900 dark:text-ink-50">Termin</h3>
    {terminFlag && terminFlags[terminFlag] && (
      <p class="mt-3 rounded-xl border border-brand-200 bg-brand-50 px-4 py-3 text-sm text-brand-800 dark:border-brand-400/30 dark:bg-brand-500/10 dark:text-brand-100">
        {terminFlags[terminFlag]}
      </p>
    )}
    {booking ? (
      <div class="mt-4 text-sm text-ink-700 dark:text-ink-200">
        <p class="font-semibold text-ink-900 dark:text-ink-50">{formatSlot(booking.starts_at, booking.ends_at)}</p>
        <p class="mt-1">{booking.first_name} {booking.last_name}</p>
        <p>{formatAddress(booking)}</p>
        <form method="POST" action="/api/admin/termine" class="mt-4">
          <input type="hidden" name="action" value="cancel" />
          <input type="hidden" name="id" value={booking.id} />
          <input type="hidden" name="redirect" value={redirectPath} />
          <button type="submit" class="rounded-full border border-rose-200 px-4 py-2 text-sm font-semibold text-rose-700 dark:border-rose-400/30 dark:text-rose-200">
            Termin stornieren
          </button>
        </form>
      </div>
    ) : (
      <form method="POST" action="/api/admin/termin-link" class="mt-4 space-y-3">
        <input type="hidden" name="request_id" value={request.id} />
        <input type="hidden" name="redirect" value={redirectPath} />
        <p class="text-sm text-ink-600 dark:text-ink-300">
          Schickt {request.email} einen Link. Dort trägt die Person Vorname, Nachname und Straße ein
          und wählt eine der {openSlotCount} freien Zeiten. Die Buchung bleibt an dieser Anfrage.
        </p>
        <button type="submit" class="btn-primary" disabled={openSlotCount === 0}>
          Terminlink per E-Mail senden
        </button>
        {openSlotCount === 0 && (
          <p class="text-sm text-amber-700 dark:text-amber-200">
            Zuerst unter <a class="underline" href="/admin/termine">Termine</a> freie Zeiten eintragen.
          </p>
        )}
      </form>
    )}
  </section>

  <!-- Antwort-Formular -->
  <section class="rounded-3xl border border-ink-200 bg-white p-6 dark:border-white/10 dark:bg-ink-900">
    <div class="flex items-start justify-between gap-4">
      <div>
        <h3 class="font-display text-xl font-bold text-ink-900 dark:text-ink-50">
          Antwort schreiben
        </h3>
        <p class="mt-1 text-sm text-ink-600 dark:text-ink-300">
          Wird an <strong>{request.email}</strong> gesendet
          {env?.EMAIL
            ? ` (Cloudflare Email Sending aktiv)`
            : env?.RESEND_API_KEY
              ? ` (Resend-Fallback aktiv)`
              : ` (kein E-Mail-Transport – Antwort wird nur gespeichert)`}.
          Antworten des Kunden auf diese E-Mail erscheinen hier im Verlauf.
        </p>
      </div>
      <span class="rounded-full bg-brand-50 px-3 py-1 text-xs font-semibold text-brand-700 dark:bg-brand-500/15 dark:text-brand-200">
        Vorlage mit Logo & Brand
      </span>
    </div>

    <form id="reply-form" method="POST" action="/api/admin/reply" enctype="multipart/form-data" class="mt-5 grid gap-4">
      <input type="hidden" name="request_id" value={request.id} />
      <input type="hidden" name="redirect" value={redirectPath} />
      <input type="hidden" name="body_html" id="reply-body-html" />
      <input type="file" id="reply-images" name="images" class="hidden" multiple />
      <input type="file" id="reply-documents" name="documents" class="hidden" multiple />

      <div>
        <label class="label" for="reply_subject">Betreff</label>
        <input
          class="input"
          id="reply_subject"
          name="subject"
          type="text"
          required
          minlength="3"
          maxlength="200"
          value={defaultSubject}
        />
      </div>

      <div>
        <label class="label" for="reply-editor">Nachricht</label>
        <div id="reply-toolbar" class="mt-1 flex flex-wrap gap-1 rounded-t-xl border border-b-0 border-ink-200 bg-ink-50 p-2 dark:border-white/10 dark:bg-white/5">
          <button type="button" class="reply-tool" data-command="bold">Fett</button>
          <button type="button" class="reply-tool" data-command="italic">Kursiv</button>
          <button type="button" class="reply-tool" data-command="underline">Unterstrichen</button>
          <button type="button" class="reply-tool" data-command="insertUnorderedList">Liste</button>
          <button type="button" class="reply-tool" data-command="createLink">Link</button>
          <button type="button" class="reply-tool" id="reply-add-image">Bild</button>
          <button type="button" class="reply-tool" id="reply-add-document">Dokument</button>
        </div>
        <div
          id="reply-editor"
          class="input min-h-[220px] max-h-[28rem] overflow-auto rounded-t-none font-sans leading-relaxed [&_img]:mt-2 [&_img]:max-h-64 [&_img]:max-w-full [&_img]:rounded-lg [&_ul]:my-2 [&_ul]:list-disc [&_ul]:pl-5 [&_ol]:my-2 [&_ol]:list-decimal [&_ol]:pl-5"
          contenteditable="true"
          role="textbox"
          aria-multiline="true"
          spellcheck="true"
          set:html={defaultHtml}
        />
        <input id="reply-image-picker" type="file" accept="image/jpeg,image/png,image/gif,image/webp" class="hidden" />
        <input id="reply-document-picker" type="file" accept=".pdf,.doc,.docx,.xls,.xlsx,.txt,application/pdf" multiple class="hidden" />
        <ul id="reply-document-list" class="mt-2 space-y-1 text-sm text-ink-700 dark:text-ink-200"></ul>
        <p id="reply-editor-error" class="mt-1 hidden text-xs text-rose-600 dark:text-rose-300"></p>
        <p class="mt-1 text-xs text-ink-500 dark:text-ink-400">
          Fett, Kursiv, Listen und Links werden in der Mail übernommen. Bilder erscheinen im Text,
          PDF, Word, Excel und Textdateien als Anhang. Höchstens 3 MB je Datei und 3 MB für alle
          Anhänge zusammen. Die Signatur „Mit freundlichen Grüßen“ plus Vor- und Nachname hängt automatisch an.
        </p>
      </div>

      <label class="inline-flex items-center gap-2 text-sm text-ink-700 dark:text-ink-200">
        <input type="checkbox" name="mark_done" class="h-4 w-4 rounded border-ink-300 text-brand-600 focus:ring-brand-500" />
        Nach dem Senden auf <strong>Erledigt</strong> setzen
      </label>

      <div class="flex items-center gap-3">
        <button type="submit" class="btn-primary">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4">
            <line x1="22" y1="2" x2="11" y2="13" />
            <polygon points="22 2 15 22 11 13 2 9 22 2" />
          </svg>
          Antwort senden
        </button>
        <span class="text-xs text-ink-500 dark:text-ink-400">
          Alle Antworten werden protokolliert und sind unten in diesem Thread sichtbar.
        </span>
      </div>
    </form>
  </section>

  <!-- Reply-Thread -->
  {replies.length > 0 && (
    <section class="space-y-3">
      <h3 class="font-display text-lg font-bold text-ink-900 dark:text-ink-50">
        Verlauf ({replies.length})
      </h3>
      {replies.map((r) => (
        <article
          class:list={[
            "rounded-2xl border p-5",
            r.direction === "inbound"
              ? "border-brand-200 bg-brand-50/70 dark:border-brand-400/30 dark:bg-brand-500/10"
              : "border-ink-200 bg-white dark:border-white/10 dark:bg-ink-900",
          ]}
        >
          <header class="flex flex-wrap items-start justify-between gap-3">
            <div>
              <p class="text-sm font-semibold text-ink-900 dark:text-ink-50">
                {r.subject}
              </p>
              <p class="mt-0.5 text-xs text-ink-500 dark:text-ink-400">
                von <strong>{r.author_name}</strong>
                {r.from_email ? ` · ${r.from_email}` : ""} · {formatDate(r.created_at)}
              </p>
            </div>
            <div class="flex flex-col items-end gap-1">
              {r.direction === "inbound" ? (
                <span class="inline-flex items-center gap-1.5 rounded-full bg-brand-100 px-2.5 py-0.5 text-xs font-semibold text-brand-800 dark:bg-brand-500/20 dark:text-brand-100">
                  <span class="h-1.5 w-1.5 rounded-full bg-brand-500" />
                  Per E-Mail eingegangen
                </span>
              ) : r.email_sent_at ? (
                <span class="inline-flex items-center gap-1.5 rounded-full bg-emerald-50 px-2.5 py-0.5 text-xs font-semibold text-emerald-700 dark:bg-emerald-500/15 dark:text-emerald-200">
                  <span class="h-1.5 w-1.5 rounded-full bg-emerald-500" />
                  per E-Mail gesendet
                </span>
              ) : r.email_status?.startsWith("skipped") ? (
                <span class="inline-flex items-center gap-1.5 rounded-full bg-amber-50 px-2.5 py-0.5 text-xs font-semibold text-amber-800 dark:bg-amber-500/15 dark:text-amber-200">
                  <span class="h-1.5 w-1.5 rounded-full bg-amber-500" />
                  nur gespeichert (kein E-Mail-Transport)
                </span>
              ) : (
                <span class="inline-flex items-center gap-1.5 rounded-full bg-rose-50 px-2.5 py-0.5 text-xs font-semibold text-rose-700 dark:bg-rose-500/15 dark:text-rose-200">
                  <span class="h-1.5 w-1.5 rounded-full bg-rose-500" />
                  E-Mail fehlgeschlagen
                </span>
              )}
              {r.email_error && (
                <p class="text-right text-[11px] text-rose-600 dark:text-rose-300 max-w-xs break-words">
                  {r.email_error}
                </p>
              )}
            </div>
          </header>
          {r.direction === "outbound" && /<\/?[a-z][\s>]/i.test(r.body) ? (
            <div
              class="mt-3 text-sm leading-relaxed text-ink-700 dark:text-ink-200 [&_p]:mb-2 [&_ul]:list-disc [&_ul]:pl-5 [&_a]:underline"
              set:html={sanitizeMailHtml(r.body)}
            />
          ) : (
            <p class="mt-3 whitespace-pre-line text-sm leading-relaxed text-ink-700 dark:text-ink-200">
              {r.body}
            </p>
          )}
        </article>
      ))}
    </section>
  )}
</AdminLayout>

<style>
  .reply-tool {
    border-radius: 0.5rem;
    border: 1px solid rgb(226 232 240);
    background: white;
    padding: 0.25rem 0.65rem;
    font-size: 0.75rem;
    font-weight: 600;
    color: rgb(30 41 59);
  }
  .reply-tool:hover {
    border-color: rgb(147 197 253);
    color: rgb(29 78 216);
  }
  :where(.dark, [data-theme="dark"]) .reply-tool {
    border-color: rgb(255 255 255 / 0.1);
    background: rgb(15 23 42);
    color: rgb(241 245 249);
  }
</style>

<script>
  import { MAX_FILE_BYTES, MAX_FILES, MAX_TOTAL_BYTES } from "../../../lib/mail-files";

  const form = document.getElementById("reply-form");
  const editor = document.getElementById("reply-editor");
  const toolbar = document.getElementById("reply-toolbar");
  const bodyField = document.getElementById("reply-body-html");
  const imageInput = document.getElementById("reply-images");
  const documentInput = document.getElementById("reply-documents");
  const imagePicker = document.getElementById("reply-image-picker");
  const documentPicker = document.getElementById("reply-document-picker");
  const documentList = document.getElementById("reply-document-list");
  const errorEl = document.getElementById("reply-editor-error");
  const submitButton = form?.querySelector('button[type="submit"]');

  if (
    form instanceof HTMLFormElement &&
    editor instanceof HTMLElement &&
    toolbar instanceof HTMLElement &&
    bodyField instanceof HTMLInputElement &&
    imageInput instanceof HTMLInputElement &&
    documentInput instanceof HTMLInputElement &&
    imagePicker instanceof HTMLInputElement &&
    documentPicker instanceof HTMLInputElement &&
    documentList instanceof HTMLElement &&
    errorEl instanceof HTMLElement &&
    submitButton instanceof HTMLButtonElement
  ) {
    const images = new Map<string, File>();
    const documents: File[] = [];
    const imageTypes = new Set(["image/jpeg", "image/png", "image/gif", "image/webp"]);
    const imageExt = new Set(["jpg", "jpeg", "png", "gif", "webp"]);
    const documentExt = new Set(["pdf", "doc", "docx", "xls", "xlsx", "txt"]);
    let sending = false;

    const showError = (message: string) => {
      errorEl.textContent = message;
      errorEl.classList.remove("hidden");
    };
    const clearError = () => {
      errorEl.textContent = "";
      errorEl.classList.add("hidden");
    };
    const extensionOf = (name: string) => {
      const match = /\.([a-z0-9]{1,8})$/i.exec(name);
      return match?.[1]?.toLowerCase() ?? "";
    };
    const formatSize = (bytes: number) => {
      if (bytes < 1024) return `${bytes} B`;
      if (bytes < 1024 * 1024) return `${Math.ceil(bytes / 1024)} KB`;
      return `${(bytes / (1024 * 1024)).toFixed(1)} MB`;
    };
    const escapeText = (value: string) =>
      value.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
    const escapeAttr = (value: string) =>
      escapeText(value).replace(/"/g, "&quot;");

    const currentUsage = () => {
      let total = 0;
      let count = 0;
      const seen = new Set<string>();
      editor.querySelectorAll("img[data-upload-id]").forEach((img) => {
        const id = img.getAttribute("data-upload-id") ?? "";
        const file = images.get(id);
        if (!file || seen.has(id)) return;
        seen.add(id);
        total += file.size;
        count += 1;
      });
      for (const file of documents) {
        total += file.size;
        count += 1;
      }
      return { total, count };
    };

    const quotaError = (extra: File) => {
      if (extra.size > MAX_FILE_BYTES) return "Die Datei ist größer als 3 MB.";
      const usage = currentUsage();
      if (usage.count + 1 > MAX_FILES) return "Höchstens 6 Dateien pro Antwort.";
      if (usage.total + extra.size > MAX_TOTAL_BYTES) {
        return "Alle Anhänge zusammen dürfen höchstens 3 MB groß sein.";
      }
      return null;
    };

    const imageFile = (file: File) => {
      const ext = extensionOf(file.name);
      if (imageExt.has(ext)) return file;
      const fallback =
        file.type === "image/jpeg"
          ? "bild.jpg"
          : file.type === "image/png"
            ? "bild.png"
            : file.type === "image/gif"
              ? "bild.gif"
              : file.type === "image/webp"
                ? "bild.webp"
                : "";
      return fallback ? new File([file], fallback, { type: file.type }) : file;
    };

    const addImage = (raw: File) => {
      const file = imageFile(raw);
      const ext = extensionOf(file.name);
      if (
        !imageExt.has(ext) ||
        (file.type !== "" && file.type !== "application/octet-stream" && !imageTypes.has(file.type))
      ) {
        showError("Bilder dürfen JPEG, PNG, GIF oder WebP sein.");
        return;
      }
      const problem = quotaError(file);
      if (problem) {
        showError(problem);
        return;
      }
      const bytes = new Uint8Array(6);
      crypto.getRandomValues(bytes);
      const id = `img${[...bytes].map((byte) => byte.toString(16).padStart(2, "0")).join("")}`;
      images.set(id, file);
      const alt = escapeAttr(file.name);
      editor.focus();
      placeCaret();
      document.execCommand(
        "insertHTML",
        false,
        `<img data-upload-id="${id}" src="${URL.createObjectURL(file)}" alt="${alt}">`,
      );
      clearError();
    };

    const renderDocuments = () => {
      documentList.replaceChildren();
      documents.forEach((file, index) => {
        const item = document.createElement("li");
        item.className =
          "flex items-center justify-between gap-3 rounded-lg border border-ink-200 px-3 py-2 dark:border-white/10";
        const name = document.createElement("span");
        name.textContent = `${file.name} · ${formatSize(file.size)}`;
        const remove = document.createElement("button");
        remove.type = "button";
        remove.className = "text-xs font-semibold text-rose-700 dark:text-rose-300";
        remove.textContent = "Entfernen";
        remove.addEventListener("click", () => {
          documents.splice(index, 1);
          renderDocuments();
        });
        item.appendChild(name);
        item.appendChild(remove);
        documentList.appendChild(item);
      });
    };

    const addDocument = (file: File) => {
      if (!documentExt.has(extensionOf(file.name))) {
        showError("Dokumente dürfen PDF, Word, Excel oder Textdateien sein.");
        return;
      }
      const problem = quotaError(file);
      if (problem) {
        showError(problem);
        return;
      }
      documents.push(file);
      renderDocuments();
      clearError();
    };

    const serializeChildren = (node: Node): string => {
      let html = "";
      node.childNodes.forEach((child) => {
        html += serializeNode(child);
      });
      return html;
    };

    const serializeNode = (node: Node): string => {
      if (node.nodeType === Node.TEXT_NODE) {
        return escapeText(node.textContent ?? "").replace(/\u00a0/g, " ");
      }
      if (!(node instanceof HTMLElement)) return "";
      const name = node.tagName.toLowerCase();
      if (name === "br") return "<br>";
      if (name === "img") {
        const id = node.getAttribute("data-upload-id") ?? "";
        if (!/^[a-z0-9]{4,32}$/.test(id) || !images.has(id)) return "";
        const alt = (node.getAttribute("alt") ?? "").slice(0, 120);
        return `<img data-upload-id="${id}" alt="${escapeAttr(alt)}">`;
      }
      const inner = serializeChildren(node);
      if (name === "strong" || name === "b") return inner ? `<strong>${inner}</strong>` : "";
      if (name === "em" || name === "i") return inner ? `<em>${inner}</em>` : "";
      if (name === "u") return inner ? `<u>${inner}</u>` : "";
      if (name === "a") {
        const href = node.getAttribute("href") ?? "";
        if (!/^https:\/\/[^\s<>"]+$/i.test(href) && !/^mailto:[^\s<>"]+$/i.test(href)) return inner;
        return `<a href="${escapeAttr(href)}">${inner}</a>`;
      }
      if (name === "ul" || name === "ol") return `<${name}>${inner}</${name}>`;
      if (name === "li") return `<li>${inner}</li>`;
      if (name === "blockquote") return `<blockquote>${inner}</blockquote>`;
      if (name === "span") {
        let styled = inner;
        const weight = node.style.fontWeight;
        if (node.style.fontStyle === "italic") styled = `<em>${styled}</em>`;
        if (node.style.textDecoration.includes("underline") || node.style.textDecorationLine.includes("underline")) {
          styled = `<u>${styled}</u>`;
        }
        if (weight === "bold" || Number(weight) >= 600) styled = `<strong>${styled}</strong>`;
        return styled;
      }
      if (name === "div" || name === "p") {
        if (/^<(ul|ol|blockquote)>/.test(inner)) return inner;
        if (!inner.replace(/<br>/g, "").trim()) return inner.includes("<br>") ? "<p><br></p>" : "";
        return `<p>${inner}</p>`;
      }
      return inner;
    };

    const placeCaret = () => {
      const selection = window.getSelection();
      if (selection && editor.contains(selection.anchorNode)) return;
      const range = document.createRange();
      range.selectNodeContents(editor);
      range.collapse(false);
      selection?.removeAllRanges();
      selection?.addRange(range);
    };

    toolbar.addEventListener("mousedown", (event) => {
      if (event.target instanceof Element && event.target.closest("button")) {
        event.preventDefault();
      }
    });

    toolbar.addEventListener("click", (event) => {
      const button = event.target instanceof Element ? event.target.closest("button") : null;
      const command = button?.getAttribute("data-command");
      if (!command) return;
      editor.focus();
      placeCaret();
      if (command === "createLink") {
        const raw = window.prompt("Linkadresse (https://… oder mailto:…)");
        if (!raw) return;
        const url = raw.trim();
        if (!/^https:\/\/[^\s<>"]+$/i.test(url) && !/^mailto:[^\s<>"]+$/i.test(url)) {
          showError("Nur Links mit https:// oder mailto: sind erlaubt.");
          return;
        }
        document.execCommand("createLink", false, url);
        clearError();
        return;
      }
      document.execCommand(command, false);
    });

    document.getElementById("reply-add-image")?.addEventListener("click", () => imagePicker.click());
    document.getElementById("reply-add-document")?.addEventListener("click", () => documentPicker.click());

    imagePicker.addEventListener("change", () => {
      for (const file of imagePicker.files ?? []) addImage(file);
      imagePicker.value = "";
    });
    documentPicker.addEventListener("change", () => {
      for (const file of documentPicker.files ?? []) addDocument(file);
      documentPicker.value = "";
    });

    const takeFiles = (list: FileList, event: Event) => {
      const files = [...list];
      if (files.length === 0) return;
      event.preventDefault();
      for (const file of files) {
        const ext = extensionOf(file.name);
        if (imageExt.has(ext) || imageTypes.has(file.type)) addImage(file);
        else addDocument(file);
      }
    };

    editor.addEventListener("paste", (event) => {
      const files = event.clipboardData?.files;
      if (files && files.length > 0) takeFiles(files, event);
    });
    editor.addEventListener("dragover", (event) => {
      if (event.dataTransfer?.types.includes("Files")) event.preventDefault();
    });
    editor.addEventListener("drop", (event) => {
      const files = event.dataTransfer?.files;
      if (files) takeFiles(files, event);
    });

    form.addEventListener("submit", (event) => {
      if (sending) {
        event.preventDefault();
        return;
      }
      const html = serializeChildren(editor).trim();
      const plain = html
        .replace(/<br>/g, " ")
        .replace(/<[^>]+>/g, " ")
        .replace(/&nbsp;/g, " ")
        .replace(/\s+/g, " ")
        .trim();
      const used = new Set<string>();
      for (const match of html.matchAll(/data-upload-id="([a-z0-9]{4,32})"/g)) {
        if (match[1]) used.add(match[1]);
      }
      if (plain.length < 5 && used.size === 0 && documents.length === 0) {
        event.preventDefault();
        showError("Die Nachricht ist zu kurz.");
        return;
      }
      if (html.length > 60_000) {
        event.preventDefault();
        showError("Die Nachricht ist zu lang.");
        return;
      }
      const imageTransfer = new DataTransfer();
      for (const id of used) {
        const file = images.get(id);
        if (!file) continue;
        const safe =
          file.name.replace(/[^\w.\- ()äöüÄÖÜß]+/g, "_").replace(/^\.+/, "").slice(0, 80) || "bild";
        imageTransfer.items.add(new File([file], `${id}--${safe}`, { type: file.type }));
      }
      const documentTransfer = new DataTransfer();
      for (const file of documents) documentTransfer.items.add(file);
      imageInput.files = imageTransfer.files;
      documentInput.files = documentTransfer.files;
      bodyField.value = html;
      sending = true;
      submitButton.textContent = "Wird gesendet…";
    });
  }
</script>
