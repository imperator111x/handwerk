---
import MailEditor from "../../../components/MailEditor.astro";
import MailFiles from "../../../components/MailFiles.astro";
import SalutationSelect from "../../../components/SalutationSelect.astro";
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { requireSession } from "../../../lib/auth";
import { blockedKinds, isOwnMailboxEmail, normalizeBlockEmail } from "../../../lib/blocks";
import { formatAddress, formatSlot, getBookingForRequest, listOpenSlots } from "../../../lib/appointments";
import {
  getContactRequest,
  getDb,
  listReplies,
  type ContactReplyRow,
  type ContactStatus,
} from "../../../lib/db";
import { listFilesForRequest, refreshPendingFiles, type MailFileRow } from "../../../lib/mail-files";
import { decodeHtmlEntities } from "../../../lib/html-entities";
import { sanitizeMailHtml } from "../../../lib/mail-html";
import { formatBerlin } from "../../../lib/time";
import { findCustomerByEmail } from "../../../lib/customers";
import { berlinTodayIso, listQuotes } from "../../../lib/offers";
import {
  OFFER_BANK_LINES,
  OFFER_PAYMENT_TERMS,
  OFFER_SCOPE_NOTE,
  OFFER_UNIT_LABELS,
  OFFER_UNITS,
  formatEuro,
  formatQuantity,
  lineTotalCents,
  offerNumber,
  readStoredOffer,
} from "../../../lib/quote";
import { cfEnv } from "../../../lib/cf";

export const prerender = false;

const sessionOrRedirect = await requireSession(Astro);
if (sessionOrRedirect instanceof Response) return sessionOrRedirect;
const session = sessionOrRedirect;

const idParam = Astro.params.id;
const id = Number.parseInt(idParam ?? "", 10);
if (!Number.isFinite(id) || id <= 0) {
  return Astro.redirect("/admin/anfragen");
}

const db = getDb(Astro);
const env = cfEnv();

const request = db ? await getContactRequest(db, id) : null;
if (!request) {
  return Astro.redirect("/admin/anfragen");
}

const replies: ContactReplyRow[] = db ? await listReplies(db, id) : [];
const senderBlock = db ? await blockedKinds(db, { email: request.email, ip: request.ip }) : { email: false, ip: false };
const blockEmail = normalizeBlockEmail(request.email);
const blockIp = request.ip && request.ip !== "unknown" ? request.ip : "";
const ownEmail = Boolean(blockEmail && isOwnMailboxEmail(blockEmail, env?.REPLY_DOMAIN || "zeus-service.de"));
const canBlockEmail = Boolean(blockEmail) && !ownEmail && !senderBlock.email;
const canBlockIp = Boolean(blockIp) && !senderBlock.ip;
const replyIds = replies.map((reply) => reply.id);
let attachedFiles: MailFileRow[] = db ? await listFilesForRequest(db, id, replyIds) : [];
if (env && attachedFiles.some((file) => file.scan_status === "pending" || file.scan_status === "error")) {
  await refreshPendingFiles(env, attachedFiles);
  attachedFiles = db ? await listFilesForRequest(db, id, replyIds) : [];
}
const customerFiles = attachedFiles.filter((file) => file.reply_id == null);
const filesForReply = (replyId: number) => attachedFiles.filter((file) => file.reply_id === replyId);
const virusTotalReady = Boolean(env?.VIRUSTOTAL_API_KEY);
const quotes = db ? await listQuotes(db, id) : [];
const linkedCustomer = db ? await findCustomerByEmail(db, request.email) : null;
const offerUntil = new Date(Date.parse(`${berlinTodayIso()}T00:00:00Z`) + 14 * 86_400_000)
  .toISOString()
  .slice(0, 10);
const booking = db ? await getBookingForRequest(db, id) : null;
const openSlotCount = db && !booking ? (await listOpenSlots(db)).length : 0;

const statusLabels: Record<ContactStatus, string> = {
  new: "Neu",
  in_progress: "In Bearbeitung",
  done: "Erledigt",
  archived: "Archiv",
};

const statusChipClasses: Record<ContactStatus, string> = {
  new: "bg-brand-50 text-brand-700 dark:bg-brand-500/15 dark:text-brand-200",
  in_progress: "bg-amber-50 text-amber-700 dark:bg-amber-500/15 dark:text-amber-200",
  done: "bg-emerald-50 text-emerald-700 dark:bg-emerald-500/15 dark:text-emerald-200",
  archived: "bg-ink-100 text-ink-600 dark:bg-white/10 dark:text-ink-300",
};

const topicLabels: Record<string, string> = {
  reparatur: "Reparatur",
  reinigung: "Reinigung",
  wartung: "Wartung",
  gartenpflege: "Gartenpflege",
  winterdienst: "Winterdienst",
  objektbetreuung: "Objektbetreuung",
  sonstiges: "Sonstiges",
};

const formatDate = (ts: number) => formatBerlin(ts);

const customerName = decodeHtmlEntities(request.name);
const customerMessage = decodeHtmlEntities(request.message);
const siteName = env?.SITE_NAME ?? "Zeus-Service";
const defaultSubject = `Ihre Anfrage bei ${siteName} – ${topicLabels[request.topic] ?? request.topic}`;
const defaultBody = `vielen Dank für Ihre Anfrage. Gerne gehen wir auf Ihr Anliegen ein:

[hier den Antworttext einfügen]

Falls Sie weitere Fragen haben, melden Sie sich einfach – wir sind für Sie da.`;
const escapeEditor = (value: string) =>
  value.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
const defaultHtml = defaultBody
  .trim()
  .split(/\n{2,}/)
  .map((block) => `<p>${escapeEditor(block).replace(/\n/g, "<br>")}</p>`)
  .join("");

const replyFlag = Astro.url.searchParams.get("reply");
const replyFlags: Record<string, { kind: "ok" | "warn" | "err"; text: string }> = {
  sent: { kind: "ok", text: "Antwort gespeichert und per E-Mail verschickt." },
  saved_no_email: {
    kind: "warn",
    text: "Antwort gespeichert. E-Mail nicht verschickt – kein E-Mail-Transport verbunden.",
  },
  saved_email_failed: {
    kind: "err",
    text: "Antwort gespeichert, aber E-Mail-Versand ist fehlgeschlagen (Details in den Logs).",
  },
  bad_id: { kind: "err", text: "Ungültige Anfrage-ID." },
  bad_subject: { kind: "err", text: "Betreff muss zwischen 3 und 200 Zeichen haben." },
  bad_body: { kind: "err", text: "Die Nachricht ist zu kurz oder zu lang." },
  bad_file: {
    kind: "err",
    text: "Eine Datei ist zu groß oder nicht erlaubt. Bilder, PDF, Word, Excel und Text, je Datei und zusammen höchstens 3 MB.",
  },
  not_found: { kind: "err", text: "Anfrage nicht gefunden." },
  db_error: { kind: "err", text: "Fehler beim Speichern der Antwort." },
};
const replyFlagMsg = replyFlag ? replyFlags[replyFlag] : null;
const angebotFlag = Astro.url.searchParams.get("angebot");
const angebotFlags: Record<string, { kind: "ok" | "warn" | "err"; text: string }> = {
  sent: { kind: "ok", text: "Das Angebot ist als PDF verschickt." },
  saved: { kind: "warn", text: "Das Angebot ist gespeichert, aber nicht per E-Mail verschickt. Das PDF können Sie hier öffnen." },
  failed: { kind: "err", text: "Das Angebot ist gespeichert, der Versand ist aber fehlgeschlagen. Das PDF können Sie hier öffnen." },
  bad: { kind: "err", text: "Bitte Position, Menge, Einzelpreis und Gültigkeit prüfen." },
  db: { kind: "err", text: "Das Angebot konnte nicht gespeichert werden." },
};
const angebotMessage = angebotFlag ? angebotFlags[angebotFlag] : null;
const sperreFlag = Astro.url.searchParams.get("sperre");
const sperreFlags: Record<string, { kind: "ok" | "err"; text: string }> = {
  saved: {
    kind: "ok",
    text: "Der Absender ist gesperrt. Neue Mails und Anfragen von dieser E-Mail und IP kommen nicht mehr an.",
  },
  lifted: { kind: "ok", text: "Die Sperre ist aufgehoben." },
  own: { kind: "err", text: "Adressen von zeus-service.de lassen sich nicht sperren." },
  empty: { kind: "err", text: "Es gibt keine E-Mail oder IP zum Sperren." },
  db: { kind: "err", text: "Die Sperre konnte nicht gespeichert werden." },
};
const sperreMessage = sperreFlag ? sperreFlags[sperreFlag] : null;
const verlaufDeleted = Astro.url.searchParams.get("verlauf") === "deleted";
const terminFlag = Astro.url.searchParams.get("termin");
const terminFlags: Record<string, string> = {
  sent: "Der Terminlink wurde per E-Mail verschickt.",
  saved: "Der Terminlink wurde gespeichert, aber nicht per E-Mail verschickt.",
  failed: "Der Terminlink konnte nicht per E-Mail verschickt werden.",
  no_slots: "Es gibt noch keine freien Termine. Tragen Sie zuerst welche unter Termine ein.",
  booked: "Für diese Anfrage ist bereits ein Termin gebucht.",
  cancelled: "Der Termin wurde storniert. Die Zeit ist wieder frei, der Kunde kann neu buchen.",
};

const redirectPath = Astro.url.pathname;
---

<AdminLayout title={`Anfrage #${request.id}`} session={session}>
  <nav class="text-sm">
    <a
      href="/admin/anfragen"
      class="inline-flex items-center gap-1.5 text-ink-600 hover:text-ink-900 dark:text-ink-300 dark:hover:text-ink-50"
    >
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4">
        <line x1="19" y1="12" x2="5" y2="12" />
        <polyline points="12 19 5 12 12 5" />
      </svg>
      Zurück zur Liste
    </a>
  </nav>

  {verlaufDeleted && (
    <p class="rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-800 dark:border-emerald-400/20 dark:bg-emerald-500/10 dark:text-emerald-100">
      Der Mailverlauf ist gelöscht. Die Anfrage bleibt erhalten.
    </p>
  )}

  {sperreMessage && (
    <p
      class:list={[
        "rounded-xl border px-4 py-3 text-sm",
        sperreMessage.kind === "ok"
          ? "border-emerald-200 bg-emerald-50 text-emerald-800 dark:border-emerald-400/20 dark:bg-emerald-500/10 dark:text-emerald-100"
          : "border-rose-200 bg-rose-50 text-rose-800 dark:border-rose-400/20 dark:bg-rose-500/10 dark:text-rose-100",
      ]}
    >
      {sperreMessage.text}
    </p>
  )}

  {replyFlagMsg && (
    <div
      class={`rounded-xl border px-4 py-3 text-sm ${
        replyFlagMsg.kind === "ok"
          ? "border-emerald-200 bg-emerald-50 text-emerald-800 dark:border-emerald-400/20 dark:bg-emerald-500/10 dark:text-emerald-100"
          : replyFlagMsg.kind === "warn"
            ? "border-amber-200 bg-amber-50 text-amber-800 dark:border-amber-400/20 dark:bg-amber-500/10 dark:text-amber-100"
            : "border-rose-200 bg-rose-50 text-rose-800 dark:border-rose-400/20 dark:bg-rose-500/10 dark:text-rose-100"
      }`}
    >
      {replyFlagMsg.text}
    </div>
  )}

  <section class="rounded-3xl border border-ink-200 bg-white p-6 dark:border-white/10 dark:bg-ink-900">
    <header class="flex flex-wrap items-start justify-between gap-4">
      <div>
        <div class="flex flex-wrap items-center gap-2">
          <h2 class="font-display text-2xl font-bold text-ink-900 dark:text-ink-50">
            {customerName}
          </h2>
          <span class={`rounded-full px-2.5 py-0.5 text-xs font-semibold ${statusChipClasses[request.status]}`}>
            {statusLabels[request.status]}
          </span>
          <span class="rounded-full bg-ink-100 px-2.5 py-0.5 text-xs text-ink-700 dark:bg-white/10 dark:text-ink-200">
            {topicLabels[request.topic] ?? request.topic}
          </span>
        </div>
        <p class="mt-1 text-xs text-ink-500 dark:text-ink-400">
          #{request.id} · eingegangen {formatDate(request.created_at)}
          {request.country && request.country !== "unknown" ? ` · ${request.country}` : ""}
          {request.ip && request.ip !== "unknown" ? ` · ${request.ip}` : ""}
        </p>
      </div>
      <div class="flex flex-wrap items-center gap-2 text-sm">
        {linkedCustomer && (
          <a
            href={`/admin/kunden/${linkedCustomer.id}`}
            class="rounded-full border border-ink-200 bg-white px-3 py-1.5 font-medium text-ink-800 hover:bg-ink-100 dark:border-white/10 dark:bg-white/5 dark:text-ink-100 dark:hover:bg-white/10"
          >
            Zum Kunden
          </a>
        )}
        <a
          href={`mailto:${request.email}`}
          class="rounded-full border border-ink-200 bg-white px-3 py-1.5 font-medium text-ink-800 hover:bg-ink-100 dark:border-white/10 dark:bg-white/5 dark:text-ink-100 dark:hover:bg-white/10"
        >
          {request.email}
        </a>
        {request.phone && (
          <a
            href={`tel:${request.phone}`}
            class="rounded-full border border-ink-200 bg-white px-3 py-1.5 font-medium text-ink-800 hover:bg-ink-100 dark:border-white/10 dark:bg-white/5 dark:text-ink-100 dark:hover:bg-white/10"
          >
            {request.phone}
          </a>
        )}
        {(canBlockEmail || canBlockIp) && (
          <form method="POST" action="/api/admin/sperren" class="inline">
            <input type="hidden" name="action" value="block" />
            <input type="hidden" name="email" value={canBlockEmail ? request.email : ""} />
            <input type="hidden" name="ip" value={canBlockIp ? blockIp : ""} />
            <input type="hidden" name="note" value={`Anfrage #${request.id}`} />
            <input type="hidden" name="redirect" value={redirectPath} />
            <button
              type="submit"
              class="rounded-full border border-rose-200 bg-rose-50 px-3 py-1.5 font-medium text-rose-800 hover:bg-rose-100 dark:border-rose-400/30 dark:bg-rose-500/10 dark:text-rose-100"
            >
              {canBlockEmail && canBlockIp ? "E-Mail und IP sperren" : canBlockEmail ? "E-Mail sperren" : "IP sperren"}
            </button>
          </form>
        )}
        {(senderBlock.email || senderBlock.ip) && (
          <a href="/admin/sperren" class="text-sm font-medium text-ink-500 underline dark:text-ink-400">
            {senderBlock.email && senderBlock.ip
              ? "E-Mail und IP sind gesperrt"
              : senderBlock.email
                ? "E-Mail ist gesperrt"
                : "IP ist gesperrt"}
          </a>
        )}
      </div>
    </header>

    <article class="mt-5 rounded-2xl bg-ink-50 p-5 dark:bg-white/5">
      <p class="text-xs font-semibold uppercase tracking-wider text-ink-500 dark:text-ink-400">
        Nachricht des Kunden
      </p>
      <p class="mt-2 whitespace-pre-line text-sm leading-relaxed text-ink-800 dark:text-ink-100">
        {customerMessage}
      </p>
      <MailFiles files={customerFiles} redirect={`/admin/anfragen/${request.id}`} ready={virusTotalReady} />
    </article>

    <footer class="mt-5 flex flex-wrap items-center gap-2 border-t border-ink-200/70 pt-4 dark:border-white/10">
      {(["new", "in_progress", "done", "archived"] as ContactStatus[])
        .filter((s) => s !== request.status)
        .map((s) => (
          <form method="POST" action="/api/admin/anfragen" class="inline">
            <input type="hidden" name="id" value={request.id} />
            <input type="hidden" name="action" value="status" />
            <input type="hidden" name="status" value={s} />
            <input type="hidden" name="redirect" value={redirectPath} />
            <button
              type="submit"
              class="rounded-full border border-ink-200 bg-white px-3 py-1.5 text-xs font-medium text-ink-700 hover:bg-ink-100 dark:border-white/10 dark:bg-white/5 dark:text-ink-200 dark:hover:bg-white/10"
            >
              Status → {statusLabels[s]}
            </button>
          </form>
        ))}
    </footer>
  </section>

  <section class="rounded-3xl border border-ink-200 bg-white p-6 dark:border-white/10 dark:bg-ink-900">
    <h3 class="font-display text-xl font-bold text-ink-900 dark:text-ink-50">Festpreis-Angebot</h3>
    {angebotMessage && (
      <p
        class:list={[
          "mt-3 rounded-xl border px-4 py-3 text-sm",
          angebotMessage.kind === "ok"
            ? "border-emerald-200 bg-emerald-50 text-emerald-800 dark:border-emerald-400/30 dark:bg-emerald-500/10 dark:text-emerald-100"
            : angebotMessage.kind === "warn"
              ? "border-amber-200 bg-amber-50 text-amber-800 dark:border-amber-400/30 dark:bg-amber-500/10 dark:text-amber-100"
              : "border-rose-200 bg-rose-50 text-rose-800 dark:border-rose-400/30 dark:bg-rose-500/10 dark:text-rose-100",
        ]}
      >
        {angebotMessage.text}
      </p>
    )}
    {quotes.length > 0 && (
      <ul class="mt-4 space-y-3">
        {quotes.map((quote) => {
          const stored = readStoredOffer(quote.lines_json, quote.body);
          return (
            <li class="rounded-2xl bg-ink-50 px-4 py-3 text-sm dark:bg-white/5">
              <div class="flex flex-wrap items-start justify-between gap-2">
                <p class="font-semibold text-ink-900 dark:text-ink-50">
                  {offerNumber(quote.id, quote.created_at)} · {quote.title}
                </p>
                <span class="flex gap-3">
                  <a href={`/admin/angebote/${quote.id}`} class="font-semibold text-brand-700 underline dark:text-brand-200">
                    Bearbeiten
                  </a>
                  <a href={`/api/admin/angebot-pdf?id=${quote.id}`} class="font-semibold text-brand-700 underline dark:text-brand-200" target="_blank">
                    PDF öffnen
                  </a>
                </span>
              </div>
              <p class="mt-1 text-ink-600 dark:text-ink-300">Gültig bis {quote.valid_until.split("-").reverse().join(".")}</p>
              {stored.lines.length > 0 ? (
                <ul class="mt-2 space-y-1 text-ink-800 dark:text-ink-100">
                  {stored.lines.map((line) => (
                    <li>
                      {line.label}: {formatQuantity(line.quantity)} {OFFER_UNIT_LABELS[line.unit]} × {formatEuro(line.unitCents)} = {formatEuro(lineTotalCents(line))}
                    </li>
                  ))}
                </ul>
              ) : (
                <p class="mt-2 whitespace-pre-line text-ink-800 dark:text-ink-100">{quote.body}</p>
              )}
              <p class="mt-2 font-semibold text-ink-900 dark:text-ink-50">Festpreis {formatEuro(quote.price_cents)}</p>
              <p class="mt-1 text-ink-600 dark:text-ink-300">{OFFER_PAYMENT_TERMS}</p>
              <p class="mt-1 text-ink-600 dark:text-ink-300">{OFFER_BANK_LINES.join(" · ")}</p>
            </li>
          );
        })}
      </ul>
    )}
    <form id="offer-form" method="POST" action="/api/admin/angebot" class="mt-4 grid gap-4">
      <input type="hidden" name="request_id" value={request.id} />
      <div>
        <label class="label" for="offer-title">Betreff</label>
        <input class="input" id="offer-title" name="title" required minlength="3" maxlength="120" value={topicLabels[request.topic] ?? request.topic} />
      </div>
      <div class="flex flex-wrap gap-2">
        <button type="button" data-preset="stunde" class="rounded-full border border-ink-200 bg-white px-3 py-1.5 text-xs font-semibold text-ink-800 dark:border-white/10 dark:bg-white/5 dark:text-ink-100">Stundenlohn</button>
        <button type="button" data-preset="km" class="rounded-full border border-ink-200 bg-white px-3 py-1.5 text-xs font-semibold text-ink-800 dark:border-white/10 dark:bg-white/5 dark:text-ink-100">Preis pro km</button>
        <button type="button" data-preset="anfahrt" class="rounded-full border border-ink-200 bg-white px-3 py-1.5 text-xs font-semibold text-ink-800 dark:border-white/10 dark:bg-white/5 dark:text-ink-100">Anfahrt</button>
        <button type="button" data-preset="material" class="rounded-full border border-ink-200 bg-white px-3 py-1.5 text-xs font-semibold text-ink-800 dark:border-white/10 dark:bg-white/5 dark:text-ink-100">Material</button>
        <button type="button" id="offer-add" class="rounded-full border border-ink-200 bg-white px-3 py-1.5 text-xs font-semibold text-ink-800 dark:border-white/10 dark:bg-white/5 dark:text-ink-100">Weitere Position</button>
      </div>
      <div id="offer-lines" class="grid gap-3">
        <div data-line class="grid gap-2 rounded-2xl border border-ink-200 p-3 sm:grid-cols-12 dark:border-white/10">
          <div class="sm:col-span-4">
            <label class="label">Position</label>
            <input class="input" name="line_label" maxlength="120" value="Stundenlohn" />
          </div>
          <div class="sm:col-span-2">
            <label class="label">Menge</label>
            <input class="input" name="line_qty" data-qty inputmode="decimal" placeholder="2" />
          </div>
          <div class="sm:col-span-2">
            <label class="label">Einheit</label>
            <select class="input" name="line_unit" data-unit>
              {OFFER_UNITS.map((unit) => <option value={unit} selected={unit === "stunde"}>{OFFER_UNIT_LABELS[unit]}</option>)}
            </select>
          </div>
          <div class="sm:col-span-2">
            <label class="label">Einzelpreis</label>
            <input class="input" name="line_price" data-price inputmode="decimal" placeholder="45,00" />
          </div>
          <div class="flex items-end justify-between gap-2 sm:col-span-2">
            <p data-line-total class="pb-2 text-sm font-semibold text-ink-900 dark:text-ink-50">–</p>
            <button type="button" data-remove class="pb-2 text-xs font-semibold text-ink-500">Entfernen</button>
          </div>
        </div>
        <div data-line class="grid gap-2 rounded-2xl border border-ink-200 p-3 sm:grid-cols-12 dark:border-white/10">
          <div class="sm:col-span-4">
            <label class="label">Position</label>
            <input class="input" name="line_label" maxlength="120" value="Preis pro km" />
          </div>
          <div class="sm:col-span-2">
            <label class="label">Menge</label>
            <input class="input" name="line_qty" data-qty inputmode="decimal" placeholder="12" />
          </div>
          <div class="sm:col-span-2">
            <label class="label">Einheit</label>
            <select class="input" name="line_unit" data-unit>
              {OFFER_UNITS.map((unit) => <option value={unit} selected={unit === "km"}>{OFFER_UNIT_LABELS[unit]}</option>)}
            </select>
          </div>
          <div class="sm:col-span-2">
            <label class="label">Einzelpreis</label>
            <input class="input" name="line_price" data-price inputmode="decimal" placeholder="0,70" />
          </div>
          <div class="flex items-end justify-between gap-2 sm:col-span-2">
            <p data-line-total class="pb-2 text-sm font-semibold text-ink-900 dark:text-ink-50">–</p>
            <button type="button" data-remove class="pb-2 text-xs font-semibold text-ink-500">Entfernen</button>
          </div>
        </div>
      </div>
      <p class="text-sm text-ink-800 dark:text-ink-100">Festpreis <strong id="offer-total">0,00 €</strong></p>
      <p class="text-sm text-ink-600 dark:text-ink-300">{OFFER_PAYMENT_TERMS} {OFFER_SCOPE_NOTE}</p>
      <p class="text-sm text-ink-800 dark:text-ink-100">{OFFER_BANK_LINES.join(" · ")}</p>
      <div class="grid gap-3 sm:grid-cols-2">
        <div>
          <label class="label" for="offer-until">Gültig bis</label>
          <input class="input" id="offer-until" name="valid_until" type="date" required value={offerUntil} />
        </div>
        <SalutationSelect name={customerName} id="salutation-offer" />
      </div>
      <div>
        <label class="label" for="offer-intro">Anschreiben</label>
        <textarea class="input" id="offer-intro" name="intro" maxlength="2000" rows="3" placeholder="für die besprochene Leistung bieten wir Ihnen folgende Positionen zum Festpreis an."></textarea>
      </div>
      <div class="flex flex-wrap gap-2">
        <button type="submit" class="btn-primary">Angebot als PDF senden</button>
        <button type="submit" name="preview" value="1" formtarget="_blank" class="rounded-full border border-ink-200 bg-white px-4 py-2 text-sm font-semibold text-ink-800 dark:border-white/10 dark:bg-white/5 dark:text-ink-100">PDF ansehen</button>
      </div>
    </form>
    <template id="offer-line-template">
      <div data-line class="grid gap-2 rounded-2xl border border-ink-200 p-3 sm:grid-cols-12 dark:border-white/10">
        <div class="sm:col-span-4">
          <label class="label">Position</label>
          <input class="input" name="line_label" maxlength="120" />
        </div>
        <div class="sm:col-span-2">
          <label class="label">Menge</label>
          <input class="input" name="line_qty" data-qty inputmode="decimal" />
        </div>
        <div class="sm:col-span-2">
          <label class="label">Einheit</label>
          <select class="input" name="line_unit" data-unit>
            {OFFER_UNITS.map((unit) => <option value={unit}>{OFFER_UNIT_LABELS[unit]}</option>)}
          </select>
        </div>
        <div class="sm:col-span-2">
          <label class="label">Einzelpreis</label>
          <input class="input" name="line_price" data-price inputmode="decimal" />
        </div>
        <div class="flex items-end justify-between gap-2 sm:col-span-2">
          <p data-line-total class="pb-2 text-sm font-semibold text-ink-900 dark:text-ink-50">–</p>
          <button type="button" data-remove class="pb-2 text-xs font-semibold text-ink-500">Entfernen</button>
        </div>
      </div>
    </template>
  </section>

  <section class="rounded-3xl border border-ink-200 bg-white p-6 dark:border-white/10 dark:bg-ink-900">
    <h3 class="font-display text-xl font-bold text-ink-900 dark:text-ink-50">Termin</h3>
    {terminFlag && terminFlags[terminFlag] && (
      <p class="mt-3 rounded-xl border border-brand-200 bg-brand-50 px-4 py-3 text-sm text-brand-800 dark:border-brand-400/30 dark:bg-brand-500/10 dark:text-brand-100">
        {terminFlags[terminFlag]}
      </p>
    )}
    {booking ? (
      <div class="mt-4 text-sm text-ink-700 dark:text-ink-200">
        <p class="font-semibold text-ink-900 dark:text-ink-50">{formatSlot(booking.starts_at, booking.ends_at)}</p>
        <p class="mt-1">{booking.first_name} {booking.last_name}</p>
        <p>{formatAddress(booking)}</p>
        <form method="POST" action="/api/admin/termine" class="mt-4">
          <input type="hidden" name="action" value="cancel" />
          <input type="hidden" name="id" value={booking.id} />
          <input type="hidden" name="redirect" value={redirectPath} />
          <button type="submit" class="rounded-full border border-rose-200 px-4 py-2 text-sm font-semibold text-rose-700 dark:border-rose-400/30 dark:text-rose-200">
            Termin stornieren
          </button>
        </form>
      </div>
    ) : (
      <form method="POST" action="/api/admin/termin-link" class="mt-4 space-y-3">
        <input type="hidden" name="request_id" value={request.id} />
        <input type="hidden" name="redirect" value={redirectPath} />
        <p class="text-sm text-ink-600 dark:text-ink-300">
          Schickt {request.email} einen Link. Dort trägt die Person Vorname, Nachname und Straße ein
          und wählt eine der {openSlotCount} freien Zeiten. Die Buchung bleibt an dieser Anfrage.
        </p>
        <SalutationSelect name={customerName} id="salutation-termin" />
        <button type="submit" class="btn-primary" disabled={openSlotCount === 0}>
          Terminlink per E-Mail senden
        </button>
        {openSlotCount === 0 && (
          <p class="text-sm text-amber-700 dark:text-amber-200">
            Zuerst unter <a class="underline" href="/admin/termine">Termine</a> freie Zeiten eintragen.
          </p>
        )}
      </form>
    )}
  </section>

  <!-- Antwort-Formular -->
  <section class="rounded-3xl border border-ink-200 bg-white p-6 dark:border-white/10 dark:bg-ink-900">
    <div class="flex items-start justify-between gap-4">
      <div>
        <h3 class="font-display text-xl font-bold text-ink-900 dark:text-ink-50">
          Antwort schreiben
        </h3>
        <p class="mt-1 text-sm text-ink-600 dark:text-ink-300">
          Wird an <strong>{request.email}</strong> gesendet
          {env?.EMAIL
            ? ` (Cloudflare Email Sending aktiv)`
            : env?.RESEND_API_KEY
              ? ` (Resend-Fallback aktiv)`
              : ` (kein E-Mail-Transport – Antwort wird nur gespeichert)`}.
          Antworten des Kunden auf diese E-Mail erscheinen hier im Verlauf.
        </p>
      </div>
      <span class="rounded-full bg-brand-50 px-3 py-1 text-xs font-semibold text-brand-700 dark:bg-brand-500/15 dark:text-brand-200">
        Vorlage mit Logo & Brand
      </span>
    </div>

    <form id="reply-form" method="POST" action="/api/admin/reply" enctype="multipart/form-data" class="mt-5 grid gap-4">
      <input type="hidden" name="request_id" value={request.id} />
      <input type="hidden" name="redirect" value={redirectPath} />
      <input type="hidden" name="body_html" id="reply-body-html" />
      <input type="file" id="reply-images" name="images" class="hidden" multiple />
      <input type="file" id="reply-documents" name="documents" class="hidden" multiple />

      <div>
        <label class="label" for="reply_subject">Betreff</label>
        <input
          class="input"
          id="reply_subject"
          name="subject"
          type="text"
          required
          minlength="3"
          maxlength="200"
          value={defaultSubject}
        />
      </div>

      <SalutationSelect name={customerName} id="salutation-reply" />

      <MailEditor defaultHtml={defaultHtml} />

      <label class="inline-flex items-center gap-2 text-sm text-ink-700 dark:text-ink-200">
        <input type="checkbox" name="mark_done" class="h-4 w-4 rounded border-ink-300 text-brand-600 focus:ring-brand-500" />
        Nach dem Senden auf <strong>Erledigt</strong> setzen
      </label>

      <div class="flex items-center gap-3">
        <button type="submit" class="btn-primary">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4">
            <line x1="22" y1="2" x2="11" y2="13" />
            <polygon points="22 2 15 22 11 13 2 9 22 2" />
          </svg>
          Antwort senden
        </button>
        <span class="text-xs text-ink-500 dark:text-ink-400">
          Alle Antworten werden protokolliert und sind unten in diesem Thread sichtbar.
        </span>
      </div>
    </form>
  </section>

  <!-- Reply-Thread -->
  {replies.length > 0 && (
    <section class="space-y-3">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <h3 class="font-display text-lg font-bold text-ink-900 dark:text-ink-50">
          Verlauf ({replies.length})
        </h3>
        <form method="POST" action="/api/admin/anfragen" onsubmit="return confirm('Diesen Mailverlauf wirklich löschen? Die Anfrage bleibt erhalten.')">
          <input type="hidden" name="id" value={request.id} />
          <input type="hidden" name="action" value="delete_history" />
          <input type="hidden" name="redirect" value={redirectPath} />
          <button
            type="submit"
            class="rounded-full border border-rose-200 bg-white px-3 py-1.5 text-xs font-medium text-rose-700 hover:bg-rose-50 dark:border-rose-400/30 dark:bg-rose-500/5 dark:text-rose-200"
          >
            Verlauf löschen
          </button>
        </form>
      </div>
      {replies.map((r) => (
        <article
          class:list={[
            "rounded-2xl border p-5",
            r.direction === "inbound"
              ? "border-brand-200 bg-brand-50/70 dark:border-brand-400/30 dark:bg-brand-500/10"
              : "border-ink-200 bg-white dark:border-white/10 dark:bg-ink-900",
          ]}
        >
          <header class="flex flex-wrap items-start justify-between gap-3">
            <div>
              <p class="text-sm font-semibold text-ink-900 dark:text-ink-50">
                {decodeHtmlEntities(r.subject)}
              </p>
              <p class="mt-0.5 text-xs text-ink-500 dark:text-ink-400">
                von <strong>{r.author_name}</strong>
                {r.from_email ? ` · ${r.from_email}` : ""} · {formatDate(r.created_at)}
              </p>
            </div>
            <div class="flex flex-col items-end gap-1">
              {r.direction === "inbound" ? (
                <span class="inline-flex items-center gap-1.5 rounded-full bg-brand-100 px-2.5 py-0.5 text-xs font-semibold text-brand-800 dark:bg-brand-500/20 dark:text-brand-100">
                  <span class="h-1.5 w-1.5 rounded-full bg-brand-500" />
                  Per E-Mail eingegangen
                </span>
              ) : r.email_sent_at ? (
                <span class="inline-flex items-center gap-1.5 rounded-full bg-emerald-50 px-2.5 py-0.5 text-xs font-semibold text-emerald-700 dark:bg-emerald-500/15 dark:text-emerald-200">
                  <span class="h-1.5 w-1.5 rounded-full bg-emerald-500" />
                  per E-Mail gesendet
                </span>
              ) : r.email_status?.startsWith("skipped") ? (
                <span class="inline-flex items-center gap-1.5 rounded-full bg-amber-50 px-2.5 py-0.5 text-xs font-semibold text-amber-800 dark:bg-amber-500/15 dark:text-amber-200">
                  <span class="h-1.5 w-1.5 rounded-full bg-amber-500" />
                  nur gespeichert (kein E-Mail-Transport)
                </span>
              ) : (
                <span class="inline-flex items-center gap-1.5 rounded-full bg-rose-50 px-2.5 py-0.5 text-xs font-semibold text-rose-700 dark:bg-rose-500/15 dark:text-rose-200">
                  <span class="h-1.5 w-1.5 rounded-full bg-rose-500" />
                  E-Mail fehlgeschlagen
                </span>
              )}
              {r.email_error && (
                <p class="text-right text-[11px] text-rose-600 dark:text-rose-300 max-w-xs break-words">
                  {r.email_error}
                </p>
              )}
            </div>
          </header>
          {r.direction === "outbound" && /<\/?[a-z][\s>]/i.test(r.body) ? (
            <div
              class="mt-3 text-sm leading-relaxed text-ink-700 dark:text-ink-200 [&_p]:mb-2 [&_ul]:list-disc [&_ul]:pl-5 [&_a]:underline"
              set:html={sanitizeMailHtml(r.body)}
            />
          ) : (
            <p class="mt-3 whitespace-pre-line text-sm leading-relaxed text-ink-700 dark:text-ink-200">
              {decodeHtmlEntities(r.body)}
            </p>
          )}
          <MailFiles files={filesForReply(r.id)} redirect={`/admin/anfragen/${request.id}`} ready={virusTotalReady} />
        </article>
      ))}
    </section>
  )}
</AdminLayout>

<script data-astro-rerun>
  const form = document.getElementById("offer-form");
  const root = document.getElementById("offer-lines");
  const template = document.getElementById("offer-line-template");
  const total = document.getElementById("offer-total");
  if (form instanceof HTMLFormElement && root && template instanceof HTMLTemplateElement && total && form.dataset.ready !== "1") {
    form.dataset.ready = "1";
    const presets = {
      stunde: ["Stundenlohn", "stunde", "", ""],
      km: ["Preis pro km", "km", "", ""],
      anfahrt: ["Anfahrt", "pauschal", "1", ""],
      material: ["Material", "pauschal", "1", ""],
    };
    const centsOf = (raw) => {
      const cleaned = String(raw || "").trim().replace(/\s/g, "").replace("€", "");
      if (!/^\d{1,6}([.,]\d{1,2})?$/.test(cleaned)) return 0;
      return Math.round(Number(cleaned.replace(",", ".")) * 100);
    };
    const qtyOf = (raw) => {
      const cleaned = String(raw || "").trim().replace(/\s/g, "").replace(",", ".");
      if (!/^\d{1,5}(\.\d{1,2})?$/.test(cleaned)) return 0;
      return Number(cleaned);
    };
    const money = (cents) => (cents / 100).toLocaleString("de-DE", { style: "currency", currency: "EUR" });
    const refresh = () => {
      let sum = 0;
      root.querySelectorAll("[data-line]").forEach((row) => {
        const qty = qtyOf(row.querySelector("[data-qty]")?.value);
        const price = centsOf(row.querySelector("[data-price]")?.value);
        const line = Math.round(qty * price);
        if (qty > 0 && price > 0) sum += line;
        const out = row.querySelector("[data-line-total]");
        if (out) out.textContent = qty > 0 && price > 0 ? money(line) : "–";
      });
      total.textContent = money(sum);
    };
    const bind = (row) => {
      row.querySelector("[data-remove]")?.addEventListener("click", () => {
        if (root.querySelectorAll("[data-line]").length <= 1) return;
        row.remove();
        refresh();
      });
      row.addEventListener("input", refresh);
    };
    const addLine = (preset) => {
      if (root.querySelectorAll("[data-line]").length >= 12) return;
      const node = template.content.firstElementChild?.cloneNode(true);
      if (!(node instanceof HTMLElement)) return;
      const values = presets[preset] || ["", "pauschal", "", ""];
      const label = node.querySelector("[name='line_label']");
      const unit = node.querySelector("[data-unit]");
      const qty = node.querySelector("[data-qty]");
      const price = node.querySelector("[data-price]");
      if (label instanceof HTMLInputElement) label.value = values[0];
      if (unit instanceof HTMLSelectElement) unit.value = values[1];
      if (qty instanceof HTMLInputElement) qty.value = values[2];
      if (price instanceof HTMLInputElement) price.value = values[3];
      root.appendChild(node);
      bind(node);
      refresh();
    };
    root.querySelectorAll("[data-line]").forEach(bind);
    document.getElementById("offer-add")?.addEventListener("click", () => addLine(""));
    document.querySelectorAll("[data-preset]").forEach((button) => {
      button.addEventListener("click", () => addLine(button.getAttribute("data-preset") || ""));
    });
    refresh();
  }
</script>
