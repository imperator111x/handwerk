---
import AdminLayout from "../../layouts/AdminLayout.astro";
import { requireSession } from "../../lib/auth";
import { countContactRequestsByStatus, countRequestsAwaitingReply, getDb } from "../../lib/db";

export const prerender = false;

const sessionOrRedirect = await requireSession(Astro);
if (sessionOrRedirect instanceof Response) return sessionOrRedirect;
const session = sessionOrRedirect;

const env = Astro.locals.runtime?.env;
const dbReady = Boolean(env?.DB);
const kvReady = Boolean(env?.SESSIONS);
const cloudflareMail = Boolean(env?.EMAIL);
const resendMail = Boolean(env?.RESEND_API_KEY);
const mailReady = cloudflareMail || resendMail;
const fromEmail = env?.CONTACT_FROM_EMAIL ?? "website@zeus-service.de";

const db = getDb(Astro);
const stats = db
  ? await countContactRequestsByStatus(db).catch(() => null)
  : null;
const awaitingReply = db ? await countRequestsAwaitingReply(db).catch(() => 0) : 0;
const totalStats = stats
  ? stats.new + stats.in_progress + stats.done + stats.archived
  : 0;

const cards = [
  {
    label: "Datenbank (D1)",
    status: dbReady ? "verbunden" : "nicht konfiguriert",
    ok: dbReady,
    hint: dbReady
      ? "D1-Datenbank ist gebunden – bereit für Nutzer/Inhalte."
      : "Erstellen Sie eine D1-Datenbank und aktivieren Sie den Binding in wrangler.jsonc.",
  },
  {
    label: "Session-Store (KV)",
    status: kvReady ? "verbunden" : "nicht konfiguriert",
    ok: kvReady,
    hint: kvReady
      ? "KV-Namespace SESSIONS ist gebunden – Sessions persistieren weltweit."
      : "Ohne KV werden Sessions nur im Worker-Speicher gehalten (Entwicklung).",
  },
  {
    label: cloudflareMail ? "E-Mail (Cloudflare)" : "E-Mail",
    status: mailReady ? "aktiv" : "nicht konfiguriert",
    ok: mailReady,
    hint: cloudflareMail
      ? `Versand läuft über Cloudflare. Antworten und Terminmails gehen von ${fromEmail} raus. Neue Anfragen landen hier im Panel.`
      : resendMail
        ? "Versand läuft über Resend."
        : "Kein E-Mail-Transport verbunden. Antworten werden nur im Panel gespeichert.",
  },
];
---

<AdminLayout title="Übersicht" session={session}>
  <section class="rounded-3xl border border-ink-200 bg-white p-8 dark:border-white/10 dark:bg-ink-900">
    <p class="text-sm font-semibold text-brand-600 uppercase tracking-widest dark:text-brand-300">
      Willkommen zurück
    </p>
    <h2 class="font-display text-3xl font-bold text-ink-900 mt-2 dark:text-ink-50">
      Hallo {session.username}
    </h2>
    <p class="text-ink-600 mt-2 max-w-2xl dark:text-ink-300">
      Hier läuft das Admin-Panel von Zeus-Service. Von hier aus steuerst du
      Anfragen, Leistungen und Einstellungen.
    </p>
  </section>

  {
    stats && (
      <section>
        {awaitingReply > 0 && (
          <a
            href="/admin/anfragen"
            class="mb-4 flex items-center justify-between gap-3 rounded-2xl border border-brand-200 bg-brand-50 px-5 py-4 text-sm font-semibold text-brand-800 dark:border-brand-400/30 dark:bg-brand-500/10 dark:text-brand-100"
          >
            <span>{awaitingReply === 1 ? "1 Kunde hat geantwortet" : `${awaitingReply} Kunden haben geantwortet`}</span>
            <span>Verlauf öffnen</span>
          </a>
        )}
        <h3 class="font-display text-xl font-bold text-ink-900 mb-4 dark:text-ink-50">
          Anfragen
        </h3>
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
          <a
            href="/admin/anfragen?status=new"
            class="group rounded-2xl border border-ink-200 bg-white p-6 transition hover:-translate-y-0.5 hover:shadow-[var(--shadow-soft)] dark:border-white/10 dark:bg-ink-900"
          >
            <p class="text-xs font-semibold uppercase tracking-widest text-brand-600 dark:text-brand-300">
              Neu
            </p>
            <p class="mt-2 text-3xl font-extrabold text-ink-900 dark:text-ink-50">
              {stats.new}
            </p>
            <p class="mt-1 text-xs text-ink-500 dark:text-ink-400">
              offene Anfragen
            </p>
          </a>
          <a
            href="/admin/anfragen?status=in_progress"
            class="group rounded-2xl border border-ink-200 bg-white p-6 transition hover:-translate-y-0.5 hover:shadow-[var(--shadow-soft)] dark:border-white/10 dark:bg-ink-900"
          >
            <p class="text-xs font-semibold uppercase tracking-widest text-amber-600 dark:text-amber-300">
              In Bearbeitung
            </p>
            <p class="mt-2 text-3xl font-extrabold text-ink-900 dark:text-ink-50">
              {stats.in_progress}
            </p>
          </a>
          <a
            href="/admin/anfragen?status=done"
            class="group rounded-2xl border border-ink-200 bg-white p-6 transition hover:-translate-y-0.5 hover:shadow-[var(--shadow-soft)] dark:border-white/10 dark:bg-ink-900"
          >
            <p class="text-xs font-semibold uppercase tracking-widest text-emerald-600 dark:text-emerald-300">
              Erledigt
            </p>
            <p class="mt-2 text-3xl font-extrabold text-ink-900 dark:text-ink-50">
              {stats.done}
            </p>
          </a>
          <a
            href="/admin/anfragen"
            class="group rounded-2xl border border-ink-200 bg-white p-6 transition hover:-translate-y-0.5 hover:shadow-[var(--shadow-soft)] dark:border-white/10 dark:bg-ink-900"
          >
            <p class="text-xs font-semibold uppercase tracking-widest text-ink-500 dark:text-ink-400">
              Insgesamt
            </p>
            <p class="mt-2 text-3xl font-extrabold text-ink-900 dark:text-ink-50">
              {totalStats}
            </p>
          </a>
        </div>
      </section>
    )
  }

  <section>
    <h3 class="font-display text-xl font-bold text-ink-900 mb-4 dark:text-ink-50">
      Systemstatus
    </h3>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        cards.map((c) => (
          <article class="rounded-2xl border border-ink-200 bg-white p-6 dark:border-white/10 dark:bg-ink-900">
            <div class="flex items-center justify-between">
              <span class="text-sm font-semibold text-ink-800 dark:text-ink-100">
                {c.label}
              </span>
              <span
                class={`inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 text-xs font-semibold ${
                  c.ok
                    ? "bg-emerald-50 text-emerald-700 dark:bg-emerald-500/15 dark:text-emerald-200"
                    : "bg-amber-50 text-amber-700 dark:bg-amber-500/15 dark:text-amber-200"
                }`}
              >
                <span
                  class={`h-1.5 w-1.5 rounded-full ${
                    c.ok ? "bg-emerald-500" : "bg-amber-500"
                  }`}
                />
                {c.status}
              </span>
            </div>
            <p class="mt-3 text-sm text-ink-600 leading-relaxed dark:text-ink-300">
              {c.hint}
            </p>
          </article>
        ))
      }
    </div>
  </section>

  <section
    class="rounded-3xl border border-dashed border-ink-300 bg-white p-8 space-y-4 dark:border-white/15 dark:bg-ink-900"
  >
    <h3 class="font-display text-xl font-bold text-ink-900 dark:text-ink-50">
      Nächste Schritte
    </h3>
    <ol class="list-decimal pl-5 space-y-2 text-sm text-ink-700 dark:text-ink-200">
      <li>
        D1-Datenbank anlegen und Migrations-Skript ausführen:
        <code class="rounded bg-ink-100 px-1.5 py-0.5 dark:bg-white/10 dark:text-ink-100">
          npx wrangler d1 create zeus-service-db
        </code>
      </li>
      <li>
        KV-Namespace erzeugen:
        <code class="rounded bg-ink-100 px-1.5 py-0.5 dark:bg-white/10 dark:text-ink-100">
          npx wrangler kv namespace create SESSIONS
        </code>
      </li>
      <li>
        Beide Bindings in
        <code class="rounded bg-ink-100 px-1.5 py-0.5 dark:bg-white/10 dark:text-ink-100">wrangler.jsonc</code>
        aktivieren und
        <code class="rounded bg-ink-100 px-1.5 py-0.5 dark:bg-white/10 dark:text-ink-100">npm run cf:types</code>
        ausführen.
      </li>
      <li>
        Erste Admin-Seite (Anfragen) an D1 anbinden – siehe
        <code class="rounded bg-ink-100 px-1.5 py-0.5 dark:bg-white/10 dark:text-ink-100">src/pages/admin/anfragen.astro</code>.
      </li>
    </ol>
  </section>
</AdminLayout>
