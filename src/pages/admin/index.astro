---
import AdminLayout from "../../layouts/AdminLayout.astro";
import { requireSession } from "../../lib/auth";

export const prerender = false;

const sessionOrRedirect = await requireSession(Astro);
if (sessionOrRedirect instanceof Response) return sessionOrRedirect;
const session = sessionOrRedirect;

const env = Astro.locals.runtime?.env;
const dbReady = Boolean(env?.DB);
const kvReady = Boolean(env?.SESSIONS);
const mailReady = Boolean(env?.RESEND_API_KEY && env?.CONTACT_TO_EMAIL);

const cards = [
  {
    label: "Datenbank (D1)",
    status: dbReady ? "verbunden" : "nicht konfiguriert",
    ok: dbReady,
    hint: dbReady
      ? "D1-Datenbank ist gebunden – bereit für Nutzer/Inhalte."
      : "Erstellen Sie eine D1-Datenbank und aktivieren Sie den Binding in wrangler.jsonc.",
  },
  {
    label: "Session-Store (KV)",
    status: kvReady ? "verbunden" : "nicht konfiguriert",
    ok: kvReady,
    hint: kvReady
      ? "KV-Namespace SESSIONS ist gebunden – Sessions persistieren weltweit."
      : "Ohne KV werden Sessions nur im Worker-Speicher gehalten (Entwicklung).",
  },
  {
    label: "E-Mail (Resend)",
    status: mailReady ? "aktiv" : "nicht konfiguriert",
    ok: mailReady,
    hint: mailReady
      ? "Kontaktanfragen werden per E-Mail weitergeleitet."
      : "Setze Secrets RESEND_API_KEY und CONTACT_TO_EMAIL, um E-Mails zu versenden.",
  },
];
---

<AdminLayout title="Übersicht" session={session}>
  <section class="rounded-3xl border border-ink-200 bg-white p-8">
    <p class="text-sm font-semibold text-brand-600 uppercase tracking-widest">
      Willkommen zurück
    </p>
    <h2 class="font-display text-3xl font-bold text-ink-900 mt-2">
      Hallo {session.username}
    </h2>
    <p class="text-ink-600 mt-2 max-w-2xl">
      Hier läuft das Admin-Panel von Zeus-Service. Von hier aus steuerst du
      später Anfragen, Leistungen und Einstellungen. Der Login- und
      Session-Layer ist einsatzbereit, Datenbank-Modelle folgen in den
      nächsten Iterationen.
    </p>
  </section>

  <section>
    <h3 class="font-display text-xl font-bold text-ink-900 mb-4">
      Systemstatus
    </h3>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        cards.map((c) => (
          <article class="rounded-2xl border border-ink-200 bg-white p-6">
            <div class="flex items-center justify-between">
              <span class="text-sm font-semibold text-ink-800">
                {c.label}
              </span>
              <span
                class={`inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 text-xs font-semibold ${
                  c.ok
                    ? "bg-emerald-50 text-emerald-700"
                    : "bg-amber-50 text-amber-700"
                }`}
              >
                <span
                  class={`h-1.5 w-1.5 rounded-full ${
                    c.ok ? "bg-emerald-500" : "bg-amber-500"
                  }`}
                />
                {c.status}
              </span>
            </div>
            <p class="mt-3 text-sm text-ink-600 leading-relaxed">{c.hint}</p>
          </article>
        ))
      }
    </div>
  </section>

  <section
    class="rounded-3xl border border-dashed border-ink-300 bg-white p-8 space-y-4"
  >
    <h3 class="font-display text-xl font-bold text-ink-900">
      Nächste Schritte
    </h3>
    <ol class="list-decimal pl-5 space-y-2 text-sm text-ink-700">
      <li>
        D1-Datenbank anlegen und Migrations-Skript ausführen:
        <code class="rounded bg-ink-100 px-1.5 py-0.5">
          npx wrangler d1 create zeus-service-db
        </code>
      </li>
      <li>
        KV-Namespace erzeugen:
        <code class="rounded bg-ink-100 px-1.5 py-0.5">
          npx wrangler kv namespace create SESSIONS
        </code>
      </li>
      <li>
        Beide Bindings in
        <code class="rounded bg-ink-100 px-1.5 py-0.5">wrangler.jsonc</code>
        aktivieren und
        <code class="rounded bg-ink-100 px-1.5 py-0.5">npm run cf:types</code>
        ausführen.
      </li>
      <li>
        Erste Admin-Seite (Anfragen) an D1 anbinden – siehe
        <code class="rounded bg-ink-100 px-1.5 py-0.5">src/pages/admin/anfragen.astro</code>.
      </li>
    </ol>
  </section>
</AdminLayout>
