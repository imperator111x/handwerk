---
import AdminLayout from "../../layouts/AdminLayout.astro";
import { requireSession } from "../../lib/auth";
import { catalogEuroField, listCatalogItems } from "../../lib/catalog";
import { getDb } from "../../lib/db";
import { OFFER_UNIT_LABELS, OFFER_UNITS, formatEuro } from "../../lib/quote";

export const prerender = false;

const sessionOrRedirect = await requireSession(Astro);
if (sessionOrRedirect instanceof Response) return sessionOrRedirect;
const session = sessionOrRedirect;
const db = getDb(Astro);
const items = db ? await listCatalogItems(db) : [];
const editId = Number.parseInt(Astro.url.searchParams.get("edit") ?? "", 10);
const editing = Number.isFinite(editId) ? items.find((item) => item.id === editId) : null;
const flag = Astro.url.searchParams.get("katalog");
const messages: Record<string, string> = {
  created: "Leistung angelegt.",
  saved: "Leistung gespeichert.",
  deleted: "Leistung gelöscht.",
  bad: "Bitte Bezeichnung, Einheit und Preis prüfen.",
  missing: "Leistung nicht gefunden.",
  db: "Datenbank nicht verbunden.",
};
---

<AdminLayout title="Leistungskatalog" session={session}>
  <section class="rounded-3xl border border-ink-200 bg-white p-6 dark:border-white/10 dark:bg-ink-900">
    <p class="text-xs font-semibold uppercase tracking-wider text-ink-500 dark:text-ink-400">Katalog</p>
    <h2 class="mt-1 font-display text-2xl font-bold text-ink-900 dark:text-ink-50">Leistungen</h2>
    <p class="mt-1 text-sm text-ink-600 dark:text-ink-300">
      Diese Positionen kannst du in Angebot und Rechnung mit einem Klick übernehmen. Preise werden dabei festgeschrieben.
    </p>
    {flag && messages[flag] && (
      <p class="mt-4 rounded-xl border border-ink-200 bg-ink-50 px-4 py-3 text-sm text-ink-800 dark:border-white/10 dark:bg-white/5 dark:text-ink-100">{messages[flag]}</p>
    )}

    <form method="POST" action="/api/admin/leistungen" class="mt-6 grid gap-3 rounded-2xl border border-ink-200 p-4 dark:border-white/10">
      <input type="hidden" name="action" value="save" />
      {editing && <input type="hidden" name="id" value={editing.id} />}
      <p class="text-sm font-semibold text-ink-900 dark:text-ink-50">{editing ? "Leistung bearbeiten" : "Neue Leistung"}</p>
      <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
        <div class="lg:col-span-2">
          <label class="label" for="cat-label">Bezeichnung</label>
          <input class="input" id="cat-label" name="label" required minlength="2" maxlength="120" value={editing?.label ?? ""} />
        </div>
        <div>
          <label class="label" for="cat-unit">Einheit</label>
          <select class="input" id="cat-unit" name="unit">
            {OFFER_UNITS.map((unit) => (
              <option value={unit} selected={unit === (editing?.unit ?? "pauschal")}>{OFFER_UNIT_LABELS[unit]}</option>
            ))}
          </select>
        </div>
        <div>
          <label class="label" for="cat-price">Einzelpreis</label>
          <input class="input" id="cat-price" name="price" inputmode="decimal" placeholder="45,00" value={editing ? catalogEuroField(editing.unit_cents) : ""} />
        </div>
        <div>
          <label class="label" for="cat-sort">Reihenfolge</label>
          <input class="input" id="cat-sort" name="sort_order" type="number" value={editing?.sort_order ?? 100} />
        </div>
        <div>
          <label class="label" for="cat-active">Status</label>
          <select class="input" id="cat-active" name="active">
            <option value="1" selected={!editing || editing.active === 1}>Aktiv</option>
            <option value="0" selected={editing?.active === 0}>Aus</option>
          </select>
        </div>
      </div>
      <div class="flex flex-wrap gap-2">
        <button type="submit" class="btn-primary">{editing ? "Speichern" : "Anlegen"}</button>
        {editing && (
          <a href="/admin/leistungen" class="rounded-full border border-ink-200 bg-white px-4 py-2 text-sm font-semibold text-ink-800 dark:border-white/10 dark:bg-white/5 dark:text-ink-100">Abbrechen</a>
        )}
      </div>
    </form>

    {items.length === 0 ? (
      <p class="mt-6 text-sm text-ink-600 dark:text-ink-300">Noch keine Leistungen im Katalog.</p>
    ) : (
      <ul class="mt-6 divide-y divide-ink-100 dark:divide-white/10">
        {items.map((item) => (
          <li class="flex flex-wrap items-center justify-between gap-3 py-4">
            <div>
              <p class="font-semibold text-ink-900 dark:text-ink-50">
                {item.label}
                {item.active !== 1 && <span class="ml-2 text-xs font-semibold text-ink-500">aus</span>}
              </p>
              <p class="mt-1 text-sm text-ink-600 dark:text-ink-300">
                {OFFER_UNIT_LABELS[item.unit]} · {item.unit_cents > 0 ? formatEuro(item.unit_cents) : "Preis offen"}
              </p>
            </div>
            <div class="flex flex-wrap gap-2">
              <a href={`/admin/leistungen?edit=${item.id}`} class="rounded-full border border-ink-200 bg-white px-4 py-2 text-sm font-semibold text-ink-800 dark:border-white/10 dark:bg-white/5 dark:text-ink-100">Bearbeiten</a>
              <form method="POST" action="/api/admin/leistungen" onsubmit="return confirm('Leistung löschen?')">
                <input type="hidden" name="action" value="delete" />
                <input type="hidden" name="id" value={item.id} />
                <button type="submit" class="rounded-full border border-rose-200 bg-white px-4 py-2 text-sm font-semibold text-rose-700 dark:border-rose-400/30 dark:bg-rose-500/5 dark:text-rose-200">Löschen</button>
              </form>
            </div>
          </li>
        ))}
      </ul>
    )}
  </section>
</AdminLayout>
