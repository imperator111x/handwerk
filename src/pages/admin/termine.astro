---
import AdminLayout from "../../layouts/AdminLayout.astro";
import { requireSession } from "../../lib/auth";
import { formatAddress, formatSlot, listUpcomingSlots } from "../../lib/appointments";
import { getDb } from "../../lib/db";

export const prerender = false;

const sessionOrRedirect = await requireSession(Astro);
if (sessionOrRedirect instanceof Response) return sessionOrRedirect;
const session = sessionOrRedirect;

const db = getDb(Astro);
const slots = db ? await listUpcomingSlots(db) : [];
const flag = Astro.url.searchParams.get("termin");
const messages: Record<string, string> = {
  created: "Termin ist eingetragen.",
  deleted: "Freier Termin wurde entfernt.",
  cancelled: "Buchung wurde gelöst. Der Termin ist wieder frei.",
  busy: "Dieser Termin ist schon vergeben und bleibt stehen.",
  bad_time: "Beginn und Ende prüfen. Ein Termin darf höchstens acht Stunden dauern.",
  past: "Der Termin liegt in der Vergangenheit.",
  db: "Die Datenbank ist gerade nicht erreichbar.",
  missing: "Der Eintrag wurde nicht gefunden.",
};
const message = flag ? messages[flag] : "";
const today = new Intl.DateTimeFormat("en-CA", {
  timeZone: "Europe/Berlin",
  year: "numeric",
  month: "2-digit",
  day: "2-digit",
}).format(new Date());
---

<AdminLayout title="Termine" session={session}>
  <section class="rounded-3xl border border-ink-200 bg-white p-6 sm:p-8 dark:border-white/10 dark:bg-ink-900">
    <h2 class="font-display text-2xl font-bold text-ink-900 dark:text-ink-50">
      Freie Termine
    </h2>
    <p class="mt-2 max-w-2xl text-sm text-ink-600 dark:text-ink-300">
      Diese Zeiten kann ein Kunde über den Link aus seiner Anfrage buchen.
      Zeiten sind in Europe/Berlin.
    </p>

    {message && (
      <p class="mt-4 rounded-xl border border-brand-200 bg-brand-50 px-4 py-3 text-sm text-brand-800 dark:border-brand-400/30 dark:bg-brand-500/10 dark:text-brand-100">
        {message}
      </p>
    )}

    <form method="POST" action="/api/admin/termine" class="mt-6 grid gap-4 sm:grid-cols-4">
      <input type="hidden" name="action" value="create" />
      <input type="hidden" name="redirect" value="/admin/termine" />
      <div>
        <label class="label" for="slot-date">Datum</label>
        <input class="input" id="slot-date" name="date" type="date" required min={today} value={today} />
      </div>
      <div>
        <label class="label" for="slot-start">Von</label>
        <input class="input" id="slot-start" name="start" type="time" required value="09:00" />
      </div>
      <div>
        <label class="label" for="slot-end">Bis</label>
        <input class="input" id="slot-end" name="end" type="time" required value="10:00" />
      </div>
      <div>
        <label class="label" for="slot-note">Notiz</label>
        <input class="input" id="slot-note" name="note" type="text" maxlength="120" placeholder="optional" />
      </div>
      <div class="sm:col-span-4">
        <button type="submit" class="btn-primary">Termin eintragen</button>
      </div>
    </form>
  </section>

  <section class="space-y-3">
    {slots.length === 0 ? (
      <p class="rounded-2xl border border-dashed border-ink-300 px-5 py-8 text-sm text-ink-600 dark:border-white/15 dark:text-ink-300">
        Noch keine kommenden Termine.
      </p>
    ) : (
      slots.map((slot) => (
        <article class="rounded-2xl border border-ink-200 bg-white p-5 dark:border-white/10 dark:bg-ink-900">
          <div class="flex flex-wrap items-start justify-between gap-3">
            <div>
              <h3 class="font-semibold text-ink-900 dark:text-ink-50">
                {formatSlot(slot.starts_at, slot.ends_at)}
              </h3>
              {slot.note && (
                <p class="mt-1 text-sm text-ink-500 dark:text-ink-400">{slot.note}</p>
              )}
              {slot.booking_id ? (
                <p class="mt-2 text-sm text-ink-700 dark:text-ink-200">
                  Gebucht von {slot.first_name} {slot.last_name}
                  {slot.street ? ` · ${formatAddress({ street: slot.street, postal_code: slot.postal_code, city: slot.city })}` : ""}
                  {slot.request_id ? (
                    <>
                      {" "}
                      · <a class="text-brand-700 underline dark:text-brand-200" href={`/admin/anfragen/${slot.request_id}`}>Anfrage #{slot.request_id}</a>
                    </>
                  ) : null}
                </p>
              ) : (
                <p class="mt-2 text-sm text-emerald-700 dark:text-emerald-300">Frei</p>
              )}
            </div>
            {slot.booking_id ? (
              <form method="POST" action="/api/admin/termine">
                <input type="hidden" name="action" value="cancel" />
                <input type="hidden" name="id" value={slot.booking_id} />
                <input type="hidden" name="redirect" value="/admin/termine" />
                <button type="submit" class="rounded-full border border-ink-200 px-3 py-1.5 text-xs font-medium text-ink-700 dark:border-white/10 dark:text-ink-200">
                  Buchung lösen
                </button>
              </form>
            ) : (
              <form method="POST" action="/api/admin/termine">
                <input type="hidden" name="action" value="delete" />
                <input type="hidden" name="id" value={slot.id} />
                <input type="hidden" name="redirect" value="/admin/termine" />
                <button type="submit" class="rounded-full border border-ink-200 px-3 py-1.5 text-xs font-medium text-ink-700 dark:border-white/10 dark:text-ink-200">
                  Entfernen
                </button>
              </form>
            )}
          </div>
        </article>
      ))
    )}
  </section>
</AdminLayout>
