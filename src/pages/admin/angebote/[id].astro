---
import SalutationSelect from "../../../components/SalutationSelect.astro";
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { requireSession } from "../../../lib/auth";
import { getDb } from "../../../lib/db";
import { berlinTodayIso, getQuote, offerValidity, quoteParty } from "../../../lib/offers";
import {
  OFFER_BANK_LINES,
  OFFER_PAYMENT_TERMS,
  OFFER_SCOPE_NOTE,
  OFFER_TAX_NOTE,
  OFFER_UNIT_LABELS,
  OFFER_UNITS,
  formatEuro,
  formatOfferDate,
  formatQuantity,
  offerNumber,
  readStoredOffer,
  type OfferLine,
} from "../../../lib/quote";
import { salutationFromGreeting } from "../../../lib/salutation";

export const prerender = false;

const sessionOrRedirect = await requireSession(Astro);
if (sessionOrRedirect instanceof Response) return sessionOrRedirect;
const session = sessionOrRedirect;

const id = Number.parseInt(Astro.params.id ?? "", 10);
if (!Number.isFinite(id) || id <= 0) return Astro.redirect("/admin/angebote");

const db = getDb(Astro);
const quote = db ? await getQuote(db, id) : null;
if (!quote) return Astro.redirect("/admin/angebote?angebot=missing");
const party = db ? await quoteParty(db, quote) : null;
if (!party) return Astro.redirect("/admin/angebote?angebot=missing");

const customerName = party.name;
const stored = readStoredOffer(quote.lines_json, quote.body);
const lines: OfferLine[] = stored.lines.length
  ? stored.lines
  : [{ label: quote.title, quantity: 1, unit: "pauschal", unitCents: quote.price_cents }];
const salutation = salutationFromGreeting(stored.greeting, customerName);
const today = berlinTodayIso();
const validity = offerValidity(quote.valid_until, today);
const number = offerNumber(quote.id, quote.created_at);
const bad = Astro.url.searchParams.get("angebot") === "bad";

const euroField = (cents: number) =>
  new Intl.NumberFormat("de-DE", { minimumFractionDigits: 2, maximumFractionDigits: 2 }).format(cents / 100);
---

<AdminLayout title={`Angebot ${number}`} session={session}>
  <section class="rounded-3xl border border-ink-200 bg-white p-6 dark:border-white/10 dark:bg-ink-900">
    <div class="flex flex-wrap items-start justify-between gap-3">
      <div>
        <p class="text-xs font-semibold uppercase tracking-wider text-ink-500 dark:text-ink-400">Angebot</p>
        <h2 class="mt-1 font-display text-2xl font-bold text-ink-900 dark:text-ink-50">{number}</h2>
        <p class="mt-1 text-sm text-ink-600 dark:text-ink-300">
          {customerName} · {party.email}
          {party.phone ? ` · ${party.phone}` : ""}
        </p>
      </div>
      <span
        class={`rounded-full px-3 py-1 text-xs font-semibold ${
          validity === "gueltig"
            ? "bg-emerald-50 text-emerald-700 dark:bg-emerald-500/15 dark:text-emerald-200"
            : "bg-ink-100 text-ink-600 dark:bg-white/10 dark:text-ink-300"
        }`}
      >
        {validity === "gueltig" ? `Gültig bis ${formatOfferDate(quote.valid_until)}` : `Abgelaufen am ${formatOfferDate(quote.valid_until)}`}
      </span>
    </div>

    {bad && (
      <p class="mt-4 rounded-xl border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-800 dark:border-rose-400/30 dark:bg-rose-500/10 dark:text-rose-100">
        Bitte Positionen, Preise und das Datum prüfen. Das Datum darf höchstens ein Jahr vor oder nach heute liegen.
      </p>
    )}
    {validity === "abgelaufen" && (
      <p class="mt-4 rounded-xl border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-800 dark:border-amber-400/30 dark:bg-amber-500/10 dark:text-amber-100">
        Dieses Angebot ist abgelaufen. Ein neues Datum unter „Gültig bis“ macht es wieder gültig.
      </p>
    )}

    <form id="offer-form" method="POST" action="/api/admin/angebote" class="mt-5 grid gap-4">
      <input type="hidden" name="id" value={quote.id} />
      <div>
        <label class="label" for="offer-title">Betreff</label>
        <input class="input" id="offer-title" name="title" required minlength="3" maxlength="120" value={quote.title} />
      </div>
      <div class="flex flex-wrap gap-2">
        <button type="button" data-preset="stunde" class="rounded-full border border-ink-200 bg-white px-3 py-1.5 text-xs font-semibold text-ink-800 dark:border-white/10 dark:bg-white/5 dark:text-ink-100">Stundenlohn</button>
        <button type="button" data-preset="km" class="rounded-full border border-ink-200 bg-white px-3 py-1.5 text-xs font-semibold text-ink-800 dark:border-white/10 dark:bg-white/5 dark:text-ink-100">Preis pro km</button>
        <button type="button" data-preset="anfahrt" class="rounded-full border border-ink-200 bg-white px-3 py-1.5 text-xs font-semibold text-ink-800 dark:border-white/10 dark:bg-white/5 dark:text-ink-100">Anfahrt</button>
        <button type="button" data-preset="material" class="rounded-full border border-ink-200 bg-white px-3 py-1.5 text-xs font-semibold text-ink-800 dark:border-white/10 dark:bg-white/5 dark:text-ink-100">Material</button>
        <button type="button" id="offer-add" class="rounded-full border border-ink-200 bg-white px-3 py-1.5 text-xs font-semibold text-ink-800 dark:border-white/10 dark:bg-white/5 dark:text-ink-100">Weitere Position</button>
      </div>
      <div id="offer-lines" class="grid gap-3">
        {lines.map((line) => (
          <div data-line class="grid gap-2 rounded-2xl border border-ink-200 p-3 sm:grid-cols-12 dark:border-white/10">
            <div class="sm:col-span-4">
              <label class="label">Position</label>
              <input class="input" name="line_label" maxlength="120" value={line.label} />
            </div>
            <div class="sm:col-span-2">
              <label class="label">Menge</label>
              <input class="input" name="line_qty" data-qty inputmode="decimal" value={formatQuantity(line.quantity)} />
            </div>
            <div class="sm:col-span-2">
              <label class="label">Einheit</label>
              <select class="input" name="line_unit" data-unit>
                {OFFER_UNITS.map((unit) => (
                  <option value={unit} selected={unit === line.unit}>{OFFER_UNIT_LABELS[unit]}</option>
                ))}
              </select>
            </div>
            <div class="sm:col-span-2">
              <label class="label">Einzelpreis</label>
              <input class="input" name="line_price" data-price inputmode="decimal" value={euroField(line.unitCents)} />
            </div>
            <div class="flex items-end justify-between gap-2 sm:col-span-2">
              <p data-line-total class="pb-2 text-sm font-semibold text-ink-900 dark:text-ink-50">{formatEuro(Math.round(line.quantity * line.unitCents))}</p>
              <button type="button" data-remove class="pb-2 text-xs font-semibold text-ink-500">Entfernen</button>
            </div>
          </div>
        ))}
      </div>
      <p class="text-sm text-ink-800 dark:text-ink-100">Festpreis <strong id="offer-total">{formatEuro(quote.price_cents)}</strong></p>
      <p class="text-sm text-ink-600 dark:text-ink-300">{OFFER_TAX_NOTE}</p>
      <p class="text-sm text-ink-600 dark:text-ink-300">{OFFER_PAYMENT_TERMS} {OFFER_SCOPE_NOTE}</p>
      <p class="text-sm text-ink-800 dark:text-ink-100">{OFFER_BANK_LINES.join(" · ")}</p>
      <div class="grid gap-3 sm:grid-cols-2">
        <div>
          <label class="label" for="offer-until">Gültig bis</label>
          <input class="input" id="offer-until" name="valid_until" type="date" required value={quote.valid_until} />
        </div>
        <SalutationSelect name={customerName} id="salutation-offer" selected={salutation} />
      </div>
      <div>
        <label class="label" for="offer-intro">Anschreiben</label>
        <textarea class="input" id="offer-intro" name="intro" maxlength="2000" rows="3">{stored.intro}</textarea>
      </div>
      <div class="flex flex-wrap gap-2">
        <button type="submit" name="action" value="save" class="btn-primary">Speichern</button>
        <button type="submit" name="action" value="resend" class="btn-primary">Speichern und erneut senden</button>
        <a
          href={`/api/admin/angebot-pdf?id=${quote.id}`}
          target="_blank"
          class="rounded-full border border-ink-200 bg-white px-4 py-2 text-sm font-semibold text-ink-800 dark:border-white/10 dark:bg-white/5 dark:text-ink-100"
        >
          PDF ansehen
        </a>
        <a href="/admin/angebote" class="rounded-full px-4 py-2 text-sm font-semibold text-ink-600 underline dark:text-ink-300">
          Zurück zur Liste
        </a>
      </div>
    </form>
    <template id="offer-line-template">
      <div data-line class="grid gap-2 rounded-2xl border border-ink-200 p-3 sm:grid-cols-12 dark:border-white/10">
        <div class="sm:col-span-4">
          <label class="label">Position</label>
          <input class="input" name="line_label" maxlength="120" />
        </div>
        <div class="sm:col-span-2">
          <label class="label">Menge</label>
          <input class="input" name="line_qty" data-qty inputmode="decimal" />
        </div>
        <div class="sm:col-span-2">
          <label class="label">Einheit</label>
          <select class="input" name="line_unit" data-unit>
            {OFFER_UNITS.map((unit) => <option value={unit}>{OFFER_UNIT_LABELS[unit]}</option>)}
          </select>
        </div>
        <div class="sm:col-span-2">
          <label class="label">Einzelpreis</label>
          <input class="input" name="line_price" data-price inputmode="decimal" />
        </div>
        <div class="flex items-end justify-between gap-2 sm:col-span-2">
          <p data-line-total class="pb-2 text-sm font-semibold text-ink-900 dark:text-ink-50">–</p>
          <button type="button" data-remove class="pb-2 text-xs font-semibold text-ink-500">Entfernen</button>
        </div>
      </div>
    </template>
  </section>
</AdminLayout>

<script data-astro-rerun>
  const form = document.getElementById("offer-form");
  const root = document.getElementById("offer-lines");
  const template = document.getElementById("offer-line-template");
  const total = document.getElementById("offer-total");
  if (form instanceof HTMLFormElement && root && template instanceof HTMLTemplateElement && total && form.dataset.ready !== "1") {
    form.dataset.ready = "1";
    const presets = {
      stunde: ["Stundenlohn", "stunde", "", ""],
      km: ["Preis pro km", "km", "", ""],
      anfahrt: ["Anfahrt", "pauschal", "1", ""],
      material: ["Material", "pauschal", "1", ""],
    };
    const centsOf = (raw) => {
      const cleaned = String(raw || "").trim().replace(/\s/g, "").replace("€", "");
      if (!/^\d{1,6}([.,]\d{1,2})?$/.test(cleaned)) return 0;
      return Math.round(Number(cleaned.replace(",", ".")) * 100);
    };
    const qtyOf = (raw) => {
      const cleaned = String(raw || "").trim().replace(/\s/g, "").replace(",", ".");
      if (!/^\d{1,5}(\.\d{1,2})?$/.test(cleaned)) return 0;
      return Number(cleaned);
    };
    const money = (cents) => (cents / 100).toLocaleString("de-DE", { style: "currency", currency: "EUR" });
    const refresh = () => {
      let sum = 0;
      root.querySelectorAll("[data-line]").forEach((row) => {
        const qty = qtyOf(row.querySelector("[data-qty]")?.value);
        const price = centsOf(row.querySelector("[data-price]")?.value);
        const line = Math.round(qty * price);
        if (qty > 0 && price > 0) sum += line;
        const out = row.querySelector("[data-line-total]");
        if (out) out.textContent = qty > 0 && price > 0 ? money(line) : "–";
      });
      total.textContent = money(sum);
    };
    const bind = (row) => {
      row.querySelector("[data-remove]")?.addEventListener("click", () => {
        if (root.querySelectorAll("[data-line]").length <= 1) return;
        row.remove();
        refresh();
      });
      row.addEventListener("input", refresh);
    };
    const addLine = (preset) => {
      if (root.querySelectorAll("[data-line]").length >= 12) return;
      const node = template.content.firstElementChild?.cloneNode(true);
      if (!(node instanceof HTMLElement)) return;
      const values = presets[preset] || ["", "pauschal", "", ""];
      const label = node.querySelector("[name='line_label']");
      const unit = node.querySelector("[data-unit]");
      const qty = node.querySelector("[data-qty]");
      const price = node.querySelector("[data-price]");
      if (label instanceof HTMLInputElement) label.value = values[0];
      if (unit instanceof HTMLSelectElement) unit.value = values[1];
      if (qty instanceof HTMLInputElement) qty.value = values[2];
      if (price instanceof HTMLInputElement) price.value = values[3];
      root.appendChild(node);
      bind(node);
      refresh();
    };
    root.querySelectorAll("[data-line]").forEach(bind);
    document.getElementById("offer-add")?.addEventListener("click", () => addLine(""));
    document.querySelectorAll("[data-preset]").forEach((button) => {
      button.addEventListener("click", () => addLine(button.getAttribute("data-preset") || ""));
    });
    refresh();
  }
</script>
