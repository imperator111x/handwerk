---
import OfferComposer from "../../../components/OfferComposer.astro";
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { requireSession } from "../../../lib/auth";
import { getDb } from "../../../lib/db";
import { berlinTodayIso, getQuote, offerValidity, quoteParty } from "../../../lib/offers";
import {
  formatOfferDate,
  formatQuantity,
  offerNumber,
  readStoredOffer,
  type OfferLine,
} from "../../../lib/quote";
import { salutationFromGreeting } from "../../../lib/salutation";

export const prerender = false;

const sessionOrRedirect = await requireSession(Astro);
if (sessionOrRedirect instanceof Response) return sessionOrRedirect;
const session = sessionOrRedirect;

const id = Number.parseInt(Astro.params.id ?? "", 10);
if (!Number.isFinite(id) || id <= 0) return Astro.redirect("/admin/angebote");

const db = getDb(Astro);
const quote = db ? await getQuote(db, id) : null;
if (!quote) return Astro.redirect("/admin/angebote?angebot=missing");
const party = db ? await quoteParty(db, quote) : null;
if (!party) return Astro.redirect("/admin/angebote?angebot=missing");

const customerName = party.name;
const stored = readStoredOffer(quote.lines_json, quote.body);
const lines: OfferLine[] = stored.lines.length
  ? stored.lines
  : [{ label: quote.title, quantity: 1, unit: "pauschal", unitCents: quote.price_cents }];
const salutation = salutationFromGreeting(stored.greeting, customerName);
const today = berlinTodayIso();
const validity = offerValidity(quote.valid_until, today);
const number = offerNumber(quote.id, quote.created_at);
const angebotFlag = Astro.url.searchParams.get("angebot");
const bad = angebotFlag === "bad";
const hours = angebotFlag === "hours";

const euroField = (cents: number) =>
  new Intl.NumberFormat("de-DE", { minimumFractionDigits: 2, maximumFractionDigits: 2 }).format(cents / 100);
---

<AdminLayout title={`Angebot ${number}`} session={session}>
  <section class="rounded-3xl border border-ink-200 bg-white p-6 dark:border-white/10 dark:bg-ink-900">
    <div class="flex flex-wrap items-start justify-between gap-3">
      <div>
        <p class="text-xs font-semibold uppercase tracking-wider text-ink-500 dark:text-ink-400">Angebot</p>
        <h2 class="mt-1 font-display text-2xl font-bold text-ink-900 dark:text-ink-50">{number}</h2>
        <p class="mt-1 text-sm text-ink-600 dark:text-ink-300">
          {customerName} · {party.email}
          {party.phone ? ` · ${party.phone}` : ""}
        </p>
      </div>
      <span
        class={`rounded-full px-3 py-1 text-xs font-semibold ${
          validity === "gueltig"
            ? "bg-emerald-50 text-emerald-700 dark:bg-emerald-500/15 dark:text-emerald-200"
            : "bg-ink-100 text-ink-600 dark:bg-white/10 dark:text-ink-300"
        }`}
      >
        {validity === "gueltig" ? `Gültig bis ${formatOfferDate(quote.valid_until)}` : `Abgelaufen am ${formatOfferDate(quote.valid_until)}`}
      </span>
    </div>

    {bad && (
      <p class="mt-4 rounded-xl border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-800 dark:border-rose-400/30 dark:bg-rose-500/10 dark:text-rose-100">
        Bitte Positionen, Preise und das Datum prüfen. Das Datum darf höchstens ein Jahr vor oder nach heute liegen.
      </p>
    )}
    {hours && (
      <p class="mt-4 rounded-xl border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-800 dark:border-rose-400/30 dark:bg-rose-500/10 dark:text-rose-100">
        Beim Angebot nach Stunden braucht der Arbeitslohn Stunden und einen Stundensatz.
      </p>
    )}
    {validity === "abgelaufen" && (
      <p class="mt-4 rounded-xl border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-800 dark:border-amber-400/30 dark:bg-amber-500/10 dark:text-amber-100">
        Dieses Angebot ist abgelaufen. Ein neues Datum unter „Gültig bis“ macht es wieder gültig.
      </p>
    )}

    <div class="mt-5">
      <OfferComposer
        customerName={customerName}
        title={quote.title}
        validUntil={quote.valid_until}
        action="/api/admin/angebote"
        billing={stored.billing}
        intro={stored.intro}
        salutation={salutation}
        hidden={[{ name: "id", value: String(quote.id) }]}
        lines={lines.map((line) => ({
          label: line.label,
          quantity: formatQuantity(line.quantity),
          unit: line.unit,
          price: euroField(line.unitCents),
        }))}
      >
        <div slot="actions" class="flex flex-wrap gap-2">
          <button type="submit" name="action" value="save" class="btn-primary">Speichern</button>
          <button type="submit" name="action" value="resend" class="btn-primary">Speichern und erneut senden</button>
          <a href={`/api/admin/angebot-pdf?id=${quote.id}`} target="_blank" class="rounded-full border border-ink-200 bg-white px-4 py-2 text-sm font-semibold text-ink-800 dark:border-white/10 dark:bg-white/5 dark:text-ink-100">PDF ansehen</a>
          <a href={`/admin/rechnungen/neu?angebot=${quote.id}`} class="rounded-full border border-ink-200 bg-white px-4 py-2 text-sm font-semibold text-ink-800 dark:border-white/10 dark:bg-white/5 dark:text-ink-100">Als Rechnung übernehmen</a>
          <a href="/admin/angebote" class="rounded-full px-4 py-2 text-sm font-semibold text-ink-600 underline dark:text-ink-300">Zurück zur Liste</a>
        </div>
      </OfferComposer>
    </div>
  </section>
</AdminLayout>

