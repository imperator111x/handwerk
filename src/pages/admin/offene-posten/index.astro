---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { requireSession } from "../../../lib/auth";
import { getDb } from "../../../lib/db";
import {
  canSendPaymentReminder,
  invoiceNumber,
  nextReminderLevel,
  reminderActionLabel,
  reminderStageLabel,
} from "../../../lib/invoice";
import { listInvoices } from "../../../lib/invoices";
import { berlinTodayIso } from "../../../lib/offers";
import { formatEuro, formatOfferDate } from "../../../lib/quote";
import { invoiceStatusLabel } from "../../../lib/stripe-pay";
import { formatBerlin } from "../../../lib/time";

export const prerender = false;

const sessionOrRedirect = await requireSession(Astro);
if (sessionOrRedirect instanceof Response) return sessionOrRedirect;
const session = sessionOrRedirect;

const db = getDb(Astro);
const today = berlinTodayIso();
const all = db ? await listInvoices(db) : [];
const overdue = all.filter(
  (row) =>
    row.document_kind !== "storno" &&
    (row.payment_status === "offen" || row.payment_status === "test") &&
    Boolean(row.sent_at) &&
    row.due_date <= today,
);
const stage = (row: (typeof overdue)[number]) => Number(row.reminder_level ?? (row.reminded_at ? 1 : 0));
const counts = {
  alle: overdue.length,
  ohne: overdue.filter((row) => stage(row) === 0).length,
  erinnerung: overdue.filter((row) => stage(row) === 1).length,
  mahnung: overdue.filter((row) => stage(row) === 2).length,
  inkasso: overdue.filter((row) => stage(row) >= 3).length,
};
const filter = Astro.url.searchParams.get("stufe");
const rows =
  filter === "ohne"
    ? overdue.filter((row) => stage(row) === 0)
    : filter === "erinnerung"
      ? overdue.filter((row) => stage(row) === 1)
      : filter === "mahnung"
        ? overdue.filter((row) => stage(row) === 2)
        : filter === "inkasso"
          ? overdue.filter((row) => stage(row) >= 3)
          : overdue;

const tabs = [
  { id: "alle", label: "Alle überfällig", count: counts.alle },
  { id: "ohne", label: "Noch ohne Mahnung", count: counts.ohne },
  { id: "erinnerung", label: "1. Erinnerung", count: counts.erinnerung },
  { id: "mahnung", label: "2. Mahnung", count: counts.mahnung },
  { id: "inkasso", label: "3. Mahnung", count: counts.inkasso },
] as const;
---

<AdminLayout title="Offene Posten" session={session}>
  <section class="rounded-3xl border border-ink-200 bg-white p-6 dark:border-white/10 dark:bg-ink-900">
    <h2 class="font-display text-2xl font-bold text-ink-900 dark:text-ink-50">Offene Posten</h2>
    <p class="mt-1 text-sm text-ink-600 dark:text-ink-300">
      Überfällige Rechnungen mit Mahnstufe: Zahlungserinnerung, 2. Mahnung, dann 3. Mahnung mit Inkasso-Hinweis.
    </p>

    <div class="mt-5 flex flex-wrap gap-2">
      {tabs.map((tab) => (
        <a
          href={tab.id === "alle" ? "/admin/offene-posten" : `/admin/offene-posten?stufe=${tab.id}`}
          class:list={[
            "rounded-full px-3 py-1.5 text-sm font-semibold",
            (filter ?? "alle") === tab.id
              ? "bg-brand-600 text-white dark:bg-brand-500 dark:text-ink-950"
              : "border border-ink-200 bg-white text-ink-700 dark:border-white/10 dark:bg-white/5 dark:text-ink-200",
          ]}
        >
          {tab.label} ({tab.count})
        </a>
      ))}
    </div>

    {rows.length === 0 ? (
      <p class="mt-6 text-sm text-ink-600 dark:text-ink-300">Keine überfälligen Posten in dieser Ansicht.</p>
    ) : (
      <ul class="mt-6 divide-y divide-ink-100 dark:divide-white/10">
        {rows.map((row) => {
          const level = stage(row);
          const can = canSendPaymentReminder(row, today);
          const next = nextReminderLevel(row);
          return (
            <li class="py-4">
              <div class="flex flex-wrap items-start justify-between gap-3">
                <div class="min-w-0">
                  <a href={`/admin/rechnungen/${row.id}`} class="font-semibold text-ink-900 underline dark:text-ink-50">
                    {invoiceNumber(row.id, row.invoice_date)} · {row.title}
                  </a>
                  <p class="mt-1 text-sm text-ink-600 dark:text-ink-300">
                    {row.buyer_name}
                    {row.customer_id ? (
                      <>
                        {" · "}
                        <a class="underline" href={`/admin/kunden/${row.customer_id}`}>Kundenakte</a>
                      </>
                    ) : null}
                    {" · "}
                    {formatEuro(row.price_cents)} · fällig {formatOfferDate(row.due_date)} ·{" "}
                    {invoiceStatusLabel(row.payment_status, row.document_kind)}
                  </p>
                  <p class="mt-1 text-xs text-ink-500 dark:text-ink-400">
                    Stufe: {reminderStageLabel(level)}
                    {row.reminded_at ? ` · zuletzt ${formatBerlin(row.reminded_at)}` : ""}
                  </p>
                </div>
                <span class="rounded-full bg-amber-50 px-2.5 py-1 text-xs font-semibold text-amber-800 dark:bg-amber-500/15 dark:text-amber-100">
                  Überfällig
                </span>
              </div>
              {can && (
                <form method="POST" action="/api/admin/rechnung" class="mt-3">
                  <input type="hidden" name="id" value={row.id} />
                  <input type="hidden" name="action" value="erinnerung" />
                  <button
                    type="submit"
                    class="rounded-full border border-amber-300 bg-amber-50 px-3 py-1.5 text-xs font-semibold text-amber-900 dark:border-amber-400/40 dark:bg-amber-500/15 dark:text-amber-100"
                  >
                    {reminderActionLabel(next)}
                  </button>
                </form>
              )}
            </li>
          );
        })}
      </ul>
    )}
  </section>
</AdminLayout>
