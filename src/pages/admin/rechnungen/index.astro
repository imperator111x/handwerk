---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { requireSession } from "../../../lib/auth";
import { getDb } from "../../../lib/db";
import { invoiceNumber } from "../../../lib/invoice";
import { listInvoices } from "../../../lib/invoices";
import { paymentStatusLabel } from "../../../lib/stripe-pay";
import { formatEuro, formatOfferDate } from "../../../lib/quote";
import { formatBerlin } from "../../../lib/time";

export const prerender = false;

const sessionOrRedirect = await requireSession(Astro);
if (sessionOrRedirect instanceof Response) return sessionOrRedirect;
const session = sessionOrRedirect;
const db = getDb(Astro);
const rows = db ? await listInvoices(db) : [];
const notice = Astro.url.searchParams.get("rechnung");
const notices: Record<string, string> = {
  missing: "Die Rechnung wurde nicht gefunden.",
  db: "Die Rechnung konnte nicht geladen werden.",
};
---

<AdminLayout title="Rechnungen" session={session}>
  <section class="rounded-3xl border border-ink-200 bg-white p-6 dark:border-white/10 dark:bg-ink-900">
    <div class="flex flex-wrap items-start justify-between gap-3">
      <div>
        <p class="text-xs font-semibold uppercase tracking-wider text-ink-500 dark:text-ink-400">Festgeschrieben</p>
        <h2 class="mt-1 font-display text-2xl font-bold text-ink-900 dark:text-ink-50">Rechnungen</h2>
        <p class="mt-1 text-sm text-ink-600 dark:text-ink-300">ZUGFeRD-PDF, unveränderbar nach dem Festschreiben.</p>
      </div>
      <a href="/admin/rechnungen/neu" class="btn-primary">Neue Rechnung</a>
    </div>
    {notice && notices[notice] && (
      <p class="mt-4 rounded-xl border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-800 dark:border-rose-400/30 dark:bg-rose-500/10 dark:text-rose-100">
        {notices[notice]}
      </p>
    )}
    {rows.length === 0 ? (
      <p class="mt-6 text-sm text-ink-600 dark:text-ink-300">Noch keine Rechnung festgeschrieben.</p>
    ) : (
      <ul class="mt-6 divide-y divide-ink-100 dark:divide-white/10">
        {rows.map((row) => (
          <li class="flex flex-wrap items-center justify-between gap-3 py-4">
            <div>
              <a href={`/admin/rechnungen/${row.id}`} class="font-semibold text-ink-900 underline dark:text-ink-50">
                {invoiceNumber(row.id, row.invoice_date)} · {row.title}
              </a>
              <p class="mt-1 text-sm text-ink-600 dark:text-ink-300">
                {`${row.buyer_name} · ${formatOfferDate(row.invoice_date)} · ${formatEuro(row.price_cents)} · ${paymentStatusLabel(row.payment_status)}${row.payment_method ? ` per ${row.payment_method}` : ""}${row.sent_at ? ` · Gesendet ${formatBerlin(row.sent_at)}` : ""}`}
              </p>
            </div>
            <a href={`/api/admin/rechnung-pdf?id=${row.id}`} target="_blank" class="text-sm font-semibold text-brand-700 underline dark:text-brand-200">PDF</a>
          </li>
        ))}
      </ul>
    )}
  </section>
</AdminLayout>
