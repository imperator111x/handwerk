---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { requireSession } from "../../../lib/auth";
import { getCustomer } from "../../../lib/customers";
import { getDb } from "../../../lib/db";
import { decodeHtmlEntities } from "../../../lib/html-entities";
import { INVOICE_DEFAULT_INTRO, invoiceFromQuoteLines } from "../../../lib/invoice";
import { getTaxNumber } from "../../../lib/invoices";
import { berlinTodayIso, getQuote, quoteStatus } from "../../../lib/offers";
import { formatEuro, formatOfferDate, offerNumber, readStoredOffer } from "../../../lib/quote";

export const prerender = false;

const sessionOrRedirect = await requireSession(Astro);
if (sessionOrRedirect instanceof Response) return sessionOrRedirect;
const session = sessionOrRedirect;

const quoteId = Number.parseInt(Astro.url.searchParams.get("angebot") ?? "", 10);
if (!Number.isFinite(quoteId) || quoteId <= 0) return Astro.redirect("/admin/auftraege");

const db = getDb(Astro);
const quote = db ? await getQuote(db, quoteId) : null;
if (!quote?.customer_id) return Astro.redirect("/admin/auftraege?auftrag=missing");
const status = quoteStatus(quote.status);
if (status === "abgerechnet") {
  return Astro.redirect(`/admin/angebote/${quote.id}?angebot=locked`);
}
if (status === "offen") {
  return Astro.redirect(`/admin/angebote/${quote.id}`);
}

const customer = await getCustomer(db!, quote.customer_id);
if (!customer) return Astro.redirect("/admin/auftraege?auftrag=missing");

const taxNumber = await getTaxNumber(db!);
const street = customer.street?.trim() ?? "";
const postalCode = customer.postal_code?.trim() ?? "";
const city = customer.city?.trim() ?? "";
const addressOk = Boolean(street && postalCode && city);
const stored = readStoredOffer(quote.lines_json, "");
const today = berlinTodayIso();
const invoice = invoiceFromQuoteLines({
  title: quote.title,
  intro: stored.intro || INVOICE_DEFAULT_INTRO,
  lines: stored.lines,
  today,
  dueDays: Number(customer.default_due_days ?? 14),
  billingKind: "voll",
});
const canSend = Boolean(taxNumber && addressOk && invoice);
const number = offerNumber(quote.id, quote.created_at);
const buyerName = decodeHtmlEntities(customer.name);
const previewUrl = `/api/admin/rechnung-vorschau?id=${quote.id}`;
---

<AdminLayout title="Rechnung Vorschau" session={session}>
  <section class="rounded-3xl border border-ink-200 bg-white p-6 dark:border-white/10 dark:bg-ink-900">
    <div class="flex flex-wrap items-start justify-between gap-3">
      <div>
        <p class="text-xs font-semibold uppercase tracking-wider text-ink-500 dark:text-ink-400">PDF-Vorschau</p>
        <h2 class="mt-1 font-display text-2xl font-bold text-ink-900 dark:text-ink-50">Rechnung prüfen</h2>
        <p class="mt-1 text-sm text-ink-600 dark:text-ink-300">
          {number} · {buyerName} · {formatEuro(quote.price_cents)}
        </p>
      </div>
      <a href={`/admin/angebote/${quote.id}`} class="text-sm font-semibold text-ink-600 underline dark:text-ink-300">
        Zum Auftrag
      </a>
    </div>

    {!taxNumber && (
      <p class="mt-4 rounded-xl border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-800 dark:border-rose-400/30 dark:bg-rose-500/10 dark:text-rose-100">
        Bitte zuerst die Steuernummer unter Einstellungen hinterlegen.
      </p>
    )}
    {!addressOk && (
      <p class="mt-4 rounded-xl border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-800 dark:border-rose-400/30 dark:bg-rose-500/10 dark:text-rose-100">
        Kundenadresse unvollständig.
        <a class="font-semibold underline" href={`/admin/kunden/${customer.id}`}>In der Kundenakte ergänzen</a>
      </p>
    )}
    {!invoice && (
      <p class="mt-4 rounded-xl border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-800 dark:border-rose-400/30 dark:bg-rose-500/10 dark:text-rose-100">
        Positionen oder Betrag sind ungültig. Bitte das Angebot prüfen.
      </p>
    )}

    {canSend && invoice && (
      <>
        <dl class="mt-5 grid gap-3 text-sm sm:grid-cols-3">
          <div>
            <dt class="text-ink-500 dark:text-ink-400">Rechnungsdatum</dt>
            <dd class="font-semibold text-ink-900 dark:text-ink-50">{formatOfferDate(invoice.invoiceDate)}</dd>
          </div>
          <div>
            <dt class="text-ink-500 dark:text-ink-400">Fällig am</dt>
            <dd class="font-semibold text-ink-900 dark:text-ink-50">{formatOfferDate(invoice.dueDate)}</dd>
          </div>
          <div>
            <dt class="text-ink-500 dark:text-ink-400">Gesamt</dt>
            <dd class="font-semibold text-ink-900 dark:text-ink-50">{formatEuro(invoice.priceCents)}</dd>
          </div>
        </dl>

        <div class="mt-5 overflow-hidden rounded-2xl border border-ink-200 dark:border-white/10">
          <iframe title="Rechnung PDF Vorschau" src={previewUrl} class="h-[70vh] w-full bg-ink-100 dark:bg-ink-950"></iframe>
        </div>

        <div class="mt-5 flex flex-wrap gap-2">
          <form method="POST" action="/api/admin/rechnung">
            <input type="hidden" name="action" value="from-quote" />
            <input type="hidden" name="quote_id" value={quote.id} />
            <button type="submit" class="btn-primary">
              Festschreiben und senden
            </button>
          </form>
          <a
            href={previewUrl}
            target="_blank"
            class="rounded-full border border-ink-200 bg-white px-4 py-2 text-sm font-semibold text-ink-800 dark:border-white/10 dark:bg-white/5 dark:text-ink-100"
          >
            PDF in neuem Tab
          </a>
          <a
            href={`/admin/rechnungen/neu?angebot=${quote.id}`}
            class="rounded-full border border-ink-200 bg-white px-4 py-2 text-sm font-semibold text-ink-800 dark:border-white/10 dark:bg-white/5 dark:text-ink-100"
          >
            Bearbeiten
          </a>
        </div>
        <p class="mt-3 text-xs text-ink-500 dark:text-ink-400">
          Nach dem Bestätigen wird die Rechnung festgeschrieben, per E-Mail verschickt und der Auftrag als abgerechnet markiert.
        </p>
      </>
    )}
  </section>
</AdminLayout>
