---
import InvoiceNotes from "../../../components/InvoiceNotes.astro";
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { requireSession } from "../../../lib/auth";
import { getDb } from "../../../lib/db";
import { cfEnv } from "../../../lib/cf";
import { openAmountCents, siteAddressLabel } from "../../../lib/billing";
import {
  canSendPaymentReminder,
  invoiceNumber,
  nextReminderLevel,
  reminderActionLabel,
  reminderStageLabel,
} from "../../../lib/invoice";
import { getInvoice, listRelatedInvoices, sumCreditsForInvoice } from "../../../lib/invoices";
import { berlinTodayIso } from "../../../lib/offers";
import { invoiceStatusLabel, paymentLinkForMail, stripeKeyMode, stripePaymentsReady, transferPayment } from "../../../lib/stripe-pay";
import { OFFER_BANK_LINES, OFFER_UNIT_LABELS, formatEuro, formatOfferDate, formatQuantity, lineTotalCents, readStoredOffer } from "../../../lib/quote";
import { formatBerlin } from "../../../lib/time";

export const prerender = false;

const sessionOrRedirect = await requireSession(Astro);
if (sessionOrRedirect instanceof Response) return sessionOrRedirect;
const session = sessionOrRedirect;
const id = Number.parseInt(Astro.params.id ?? "", 10);
if (!Number.isFinite(id) || id <= 0) return Astro.redirect("/admin/rechnungen");
const db = getDb(Astro);
const row = db ? await getInvoice(db, id) : null;
if (!row) return Astro.redirect("/admin/rechnungen?rechnung=missing");
const related = db ? await listRelatedInvoices(db, row.id) : [];
const stornoDoc = related.find((entry) => entry.document_kind === "storno");
const replacement = related.find((entry) => entry.document_kind !== "storno");
const stored = readStoredOffer(row.lines_json, "");
const number = invoiceNumber(row.id, row.invoice_date);
const flag = Astro.url.searchParams.get("rechnung");
const notices: Record<string, { kind: "ok" | "bad"; text: string }> = {
  sent: { kind: "ok", text: "Die Rechnung ist als ZUGFeRD-PDF verschickt. In der Mail steht „Jetzt bezahlen“." },
  "sent-ohne-link": { kind: "bad", text: "Die Rechnung ist verschickt. Der Zahlungslink fehlt in der Mail." },
  saved: { kind: "ok", text: "Die Rechnung ist festgeschrieben. Der Versand ist nicht bestätigt." },
  failed: { kind: "bad", text: "Die Rechnung ist festgeschrieben, der Versand ist aber fehlgeschlagen." },
  transfer: { kind: "ok", text: "Die Überweisung ist gespeichert. Der Zahlungslink ist geschlossen." },
  "transfer-clear": { kind: "ok", text: "Die Rechnung steht wieder auf offen." },
  "transfer-kept": { kind: "bad", text: "Der Zahlungsstatus blieb unverändert." },
  storniert: { kind: "ok", text: "Die Rechnung ist storniert. Die Stornorechnung ist verschickt." },
  angepasst: { kind: "ok", text: "Die alte Rechnung ist storniert. Diese Rechnung ist mit dem Knopf „Jetzt bezahlen“ verschickt." },
  "angepasst-ohne-link": { kind: "bad", text: "Die alte Rechnung ist storniert. Diese Rechnung ist verschickt, der Zahlungslink fehlt aber noch." },
  "angepasst-offen": { kind: "bad", text: "Die alte Rechnung ist storniert. Diese Rechnung ist gespeichert, der Versand ist aber fehlgeschlagen." },
  "storno-kept": { kind: "bad", text: "Diese Rechnung ist bereits storniert." },
  erinnerung: { kind: "ok", text: "Die Zahlungserinnerung ist verschickt. In der Mail steht „Jetzt bezahlen“." },
  "erinnerung-ohne-link": { kind: "bad", text: "Die Zahlungserinnerung ist verschickt. Der Zahlungslink fehlt in der Mail." },
  "erinnerung-fail": { kind: "bad", text: "Die Zahlungserinnerung ließ sich nicht senden." },
  mahnung: { kind: "ok", text: "Die 2. Mahnung ist verschickt. In der Mail steht „Jetzt bezahlen“." },
  "mahnung-ohne-link": { kind: "bad", text: "Die 2. Mahnung ist verschickt. Der Zahlungslink fehlt in der Mail." },
  "mahnung-fail": { kind: "bad", text: "Die 2. Mahnung ließ sich nicht senden." },
  inkasso: {
    kind: "ok",
    text: "Die 3. Mahnung (Inkasso-Hinweis) ist verschickt. In der Mail steht „Jetzt bezahlen“.",
  },
  "inkasso-ohne-link": {
    kind: "bad",
    text: "Die 3. Mahnung (Inkasso-Hinweis) ist verschickt. Der Zahlungslink fehlt in der Mail.",
  },
  "inkasso-fail": { kind: "bad", text: "Die 3. Mahnung (Inkasso-Hinweis) ließ sich nicht senden." },
  draft: { kind: "ok", text: "Entwurfsrechnung aus wiederkehrender Leistung angelegt." },
  "erinnerung-frueh": {
    kind: "bad",
    text: "Zahlungserinnerung erst nach Fälligkeit und wenn die Rechnung schon einmal verschickt wurde.",
  },
  "transfer-partial": { kind: "ok", text: "Teilzahlung per Überweisung erfasst." },
  gutschrift: { kind: "ok", text: "Die Gutschrift ist festgeschrieben und verschickt." },
  "gutschrift-bad": { kind: "bad", text: "Gutschrift prüfen: Positionen und Betrag." },
  "gutschrift-kept": { kind: "bad", text: "Gutschrift nicht möglich (Betrag oder Status)." },
};
const stripeEnv = cfEnv();
const stripeReady = stripePaymentsReady(stripeEnv);
const stripeMode = stripeKeyMode(stripeEnv.STRIPE_SECRET_KEY);
const payUrl = row.payment_url ? paymentLinkForMail(row.payment_url, row.buyer_email) : "";
const cancelled =
  row.payment_status === "storniert" ||
  row.document_kind === "storno" ||
  row.document_kind === "gutschrift";
const paid = row.payment_status === "bezahlt" || row.payment_status === "erstattet";
const canCorrect =
  row.document_kind === "rechnung" && row.payment_status !== "storniert";
const canRemind = canSendPaymentReminder(row, berlinTodayIso());
const remindLevel = nextReminderLevel(row);
const credited = db ? await sumCreditsForInvoice(db, row.id) : 0;
const openCents = openAmountCents(row, credited);
const siteLabel = siteAddressLabel(row);
const notice = flag ? notices[flag] : undefined;
const openEuro = formatEuro(openCents).replace("€", "").trim();
---

<AdminLayout title={`Rechnung ${number}`} session={session}>
  <section class="rounded-3xl border border-ink-200 bg-white p-6 dark:border-white/10 dark:bg-ink-900">
    <div class="flex flex-wrap items-start justify-between gap-3">
      <div>
        <p class="text-xs font-semibold uppercase tracking-wider text-ink-500 dark:text-ink-400">
          {row.document_kind === "storno"
            ? "Stornorechnung"
            : row.document_kind === "gutschrift"
              ? "Gutschrift"
              : "Festgeschrieben"}
        </p>
        <h2 class="mt-1 font-display text-2xl font-bold text-ink-900 dark:text-ink-50">{number}</h2>
        <p class="mt-1 text-sm text-ink-600 dark:text-ink-300">
          {row.buyer_name} · {row.buyer_street}, {row.buyer_postal_code} {row.buyer_city} · {row.buyer_email}
        </p>
        {siteLabel && (
          <p class="mt-1 text-sm text-ink-600 dark:text-ink-300">Baustelle: {siteLabel}</p>
        )}
      </div>
      <div class="flex flex-wrap gap-2">
        <span
          class:list={[
            "rounded-full px-3 py-1 text-xs font-semibold",
            row.payment_status === "bezahlt"
              ? "bg-emerald-50 text-emerald-800 dark:bg-emerald-500/15 dark:text-emerald-100"
              : row.payment_status === "erstattet" ||
                  row.payment_status === "test" ||
                  row.payment_status === "teilbezahlt" ||
                  row.payment_status === "storniert" ||
                  row.document_kind === "storno" ||
                  row.document_kind === "gutschrift"
                ? "bg-amber-50 text-amber-800 dark:bg-amber-500/15 dark:text-amber-100"
                : "bg-ink-100 text-ink-700 dark:bg-white/10 dark:text-ink-200",
          ]}
        >
          {invoiceStatusLabel(row.payment_status, row.document_kind, row.billing_kind)}
          {row.payment_method ? ` · ${row.payment_method}` : ""}
          {row.paid_at ? ` · ${formatBerlin(row.paid_at)}` : ""}
        </span>
        <span class="rounded-full bg-ink-100 px-3 py-1 text-xs font-semibold text-ink-700 dark:bg-white/10 dark:text-ink-200">
          {row.sent_at ? `Gesendet ${formatBerlin(row.sent_at)}` : "Noch nicht gesendet"}
        </span>
        {(row.reminded_at || Number(row.reminder_level ?? 0) > 0) && (
          <span class="rounded-full bg-amber-50 px-3 py-1 text-xs font-semibold text-amber-800 dark:bg-amber-500/15 dark:text-amber-100">
            {reminderStageLabel(row.reminder_level)}
            {row.reminded_at ? ` · ${formatBerlin(row.reminded_at)}` : ""}
          </span>
        )}
      </div>
    </div>
    {notice && (
      <p
        class:list={[
          "mt-4 rounded-xl border px-4 py-3 text-sm",
          notice.kind === "ok"
            ? "border-emerald-200 bg-emerald-50 text-emerald-800 dark:border-emerald-400/30 dark:bg-emerald-500/10 dark:text-emerald-100"
            : "border-rose-200 bg-rose-50 text-rose-800 dark:border-rose-400/30 dark:bg-rose-500/10 dark:text-rose-100",
        ]}
      >
        {notice.text}
      </p>
    )}
    <dl class="mt-5 grid gap-3 text-sm sm:grid-cols-2">
      <div>
        <dt class="text-ink-500 dark:text-ink-400">Betreff</dt>
        <dd class="font-semibold text-ink-900 dark:text-ink-50">{row.title}</dd>
      </div>
      <div>
        <dt class="text-ink-500 dark:text-ink-400">Steuernummer</dt>
        <dd class="font-semibold text-ink-900 dark:text-ink-50">{row.tax_number}</dd>
      </div>
      <div>
        <dt class="text-ink-500 dark:text-ink-400">Rechnungsdatum</dt>
        <dd class="font-semibold text-ink-900 dark:text-ink-50">{formatOfferDate(row.invoice_date)}</dd>
      </div>
      <div>
        <dt class="text-ink-500 dark:text-ink-400">Leistungsdatum</dt>
        <dd class="font-semibold text-ink-900 dark:text-ink-50">{formatOfferDate(row.service_date)}</dd>
      </div>
      <div>
        <dt class="text-ink-500 dark:text-ink-400">Fällig am</dt>
        <dd class="font-semibold text-ink-900 dark:text-ink-50">{formatOfferDate(row.due_date)}</dd>
      </div>
    </dl>
    {stored.greeting && <p class="mt-5 text-sm text-ink-800 dark:text-ink-100">{stored.greeting}</p>}
    {stored.intro && <p class="mt-2 whitespace-pre-line text-sm text-ink-800 dark:text-ink-100">{stored.intro}</p>}
    <ul class="mt-4 space-y-2 text-sm text-ink-800 dark:text-ink-100">
      {stored.lines.map((line) => (
        <li>
          {line.label}: {formatQuantity(line.quantity)} {OFFER_UNIT_LABELS[line.unit]} × {formatEuro(line.unitCents)} = {formatEuro(lineTotalCents(line))}
        </li>
      ))}
    </ul>
    <p class="mt-4 text-sm font-semibold text-ink-900 dark:text-ink-50">
      Rechnungsbetrag {formatEuro(row.price_cents)}
      {Number(row.amount_paid_cents ?? 0) > 0 ? ` · gezahlt ${formatEuro(Number(row.amount_paid_cents))}` : ""}
      {credited > 0 ? ` · Gutschriften ${formatEuro(credited)}` : ""}
      {row.document_kind === "rechnung" && openCents !== row.price_cents ? ` · offen ${formatEuro(openCents)}` : ""}
    </p>
    <p class="mt-1 text-xs text-ink-500 dark:text-ink-400">
      Zahlungsziel: {row.payment_terms || `innerhalb von ${Number(row.due_days ?? 14)} Tagen`} · fällig {formatOfferDate(row.due_date)}
    </p>
    {row.payment_note && (
      <p class="mt-3 rounded-xl border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-900 dark:border-amber-400/30 dark:bg-amber-500/10 dark:text-amber-100">
        {row.payment_note}
      </p>
    )}
    {stornoDoc && (
      <p class="mt-3 text-sm text-ink-700 dark:text-ink-200">
        Stornorechnung:
        <a class="font-semibold text-brand-700 underline dark:text-brand-200" href={`/admin/rechnungen/${stornoDoc.id}`}>{invoiceNumber(stornoDoc.id, stornoDoc.invoice_date)}</a>
      </p>
    )}
    {replacement && (
      <p class="mt-3 text-sm text-ink-700 dark:text-ink-200">
        Neue Rechnung:
        <a class="font-semibold text-brand-700 underline dark:text-brand-200" href={`/admin/rechnungen/${replacement.id}`}>{invoiceNumber(replacement.id, replacement.invoice_date)}</a>
      </p>
    )}
    {row.document_kind === "storno" && row.related_invoice_id && (
      <p class="mt-3 text-sm text-ink-700 dark:text-ink-200">
        <a class="font-semibold text-brand-700 underline dark:text-brand-200" href={`/admin/rechnungen/${row.related_invoice_id}`}>Zur aufgehobenen Rechnung</a>
      </p>
    )}
    {stripeMode === "test" && !paid && !cancelled && (
      <p class="mt-3 rounded-xl border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-900 dark:border-amber-400/30 dark:bg-amber-500/10 dark:text-amber-100">
        Testmodus: Der Zahlungslink bucht kein echtes Geld ab. Eine Übung erscheint als Testzahlung.
      </p>
    )}
    {!paid && !cancelled && payUrl && (
      <p class="mt-3 text-sm text-ink-700 dark:text-ink-200">
        In der Mail steht der Knopf „Jetzt bezahlen“:
        <a href={payUrl} target="_blank" class="font-semibold text-brand-700 underline dark:text-brand-200">Zahlungslink</a>
      </p>
    )}
    {!paid && !cancelled && !payUrl && (
      <p class="mt-3 text-sm text-ink-600 dark:text-ink-300">
        {stripeReady
          ? "Der Zahlungslink entsteht beim nächsten Senden."
          : "Der Zahlungslink erscheint in der Mail, sobald Stripe unter Einstellungen verbunden ist."}
      </p>
    )}
    <InvoiceNotes />
    <p class="mt-3 text-sm text-ink-800 dark:text-ink-100">{OFFER_BANK_LINES.join(" · ")}</p>
    <div class="mt-5 flex flex-wrap gap-2">
      <a href={`/api/admin/rechnung-pdf?id=${row.id}`} target="_blank" class="btn-primary">PDF ansehen</a>
      {row.document_kind !== "storno" && (
        <a
          href={`/api/admin/rechnung-gericht?id=${row.id}`}
          class="rounded-full border border-ink-200 bg-white px-4 py-2 text-sm font-semibold text-ink-800 dark:border-white/10 dark:bg-white/5 dark:text-ink-100"
          title="ZIP mit Mahnverfahren-Daten und Rechnungs-PDF"
        >
          Für Gericht / Mahnverfahren
        </a>
      )}
      {canCorrect && (
        <a href={`/admin/rechnungen/bearbeiten?id=${row.id}`} class="rounded-full border border-ink-200 bg-white px-4 py-2 text-sm font-semibold text-ink-800 dark:border-white/10 dark:bg-white/5 dark:text-ink-100">Anpassen</a>
      )}
      {canCorrect && (
        <form method="POST" action="/api/admin/rechnung" onsubmit="return confirm('Diese Rechnung stornieren? Der Zahlungslink wird geschlossen und der Kunde erhält die Stornorechnung.')">
          <input type="hidden" name="action" value="storno" />
          <input type="hidden" name="id" value={row.id} />
          <button type="submit" class="rounded-full border border-ink-200 bg-white px-4 py-2 text-sm font-semibold text-ink-800 dark:border-white/10 dark:bg-white/5 dark:text-ink-100">Stornieren</button>
        </form>
      )}
      {!cancelled && (
        <form method="POST" action="/api/admin/rechnung">
          <input type="hidden" name="action" value="resend" />
          <input type="hidden" name="id" value={row.id} />
          <button type="submit" class="rounded-full border border-ink-200 bg-white px-4 py-2 text-sm font-semibold text-ink-800 dark:border-white/10 dark:bg-white/5 dark:text-ink-100">Erneut senden</button>
        </form>
      )}
      {canRemind && (
        <form method="POST" action="/api/admin/rechnung">
          <input type="hidden" name="action" value="erinnerung" />
          <input type="hidden" name="id" value={row.id} />
          <button type="submit" class="rounded-full border border-amber-300 bg-amber-50 px-4 py-2 text-sm font-semibold text-amber-900 dark:border-amber-400/40 dark:bg-amber-500/15 dark:text-amber-100">
            {reminderActionLabel(remindLevel)}
          </button>
        </form>
      )}
      {row.document_kind === "storno" && (
        <form method="POST" action="/api/admin/rechnung">
          <input type="hidden" name="action" value="resend" />
          <input type="hidden" name="id" value={row.id} />
          <button type="submit" class="rounded-full border border-ink-200 bg-white px-4 py-2 text-sm font-semibold text-ink-800 dark:border-white/10 dark:bg-white/5 dark:text-ink-100">Stornorechnung erneut senden</button>
        </form>
      )}
      {(row.payment_status === "offen" || row.payment_status === "teilbezahlt" || row.payment_status === "test") &&
        row.document_kind === "rechnung" &&
        openCents > 0 && (
          <form method="POST" action="/api/admin/rechnung" class="flex flex-wrap items-end gap-2">
            <input type="hidden" name="action" value="transfer" />
            <input type="hidden" name="id" value={row.id} />
            <div>
              <label class="label" for="pay-amount">Teil-/Zahlung (€)</label>
              <input class="input w-28" id="pay-amount" name="amount" inputmode="decimal" value={openEuro} />
            </div>
            <button type="submit" class="rounded-full border border-ink-200 bg-white px-4 py-2 text-sm font-semibold text-ink-800 dark:border-white/10 dark:bg-white/5 dark:text-ink-100">
              Überweisung erfassen
            </button>
          </form>
        )}
      {transferPayment({
        priceCents: row.price_cents,
        status: row.payment_status,
        reference: row.payment_reference,
        method: row.payment_method,
        paidAt: row.paid_at,
        note: row.payment_note,
      }) && (
        <form method="POST" action="/api/admin/rechnung">
          <input type="hidden" name="action" value="transfer-clear" />
          <input type="hidden" name="id" value={row.id} />
          <button type="submit" class="rounded-full border border-ink-200 bg-white px-4 py-2 text-sm font-semibold text-ink-800 dark:border-white/10 dark:bg-white/5 dark:text-ink-100">Überweisung zurücknehmen</button>
        </form>
      )}
      {canCorrect && openCents > 0 && (
        <a
          href={`/admin/rechnungen/gutschrift?id=${row.id}`}
          class="rounded-full border border-ink-200 bg-white px-4 py-2 text-sm font-semibold text-ink-800 dark:border-white/10 dark:bg-white/5 dark:text-ink-100"
        >
          Teilgutschrift
        </a>
      )}
      {row.customer_id && (
        <a href={`/admin/kunden/${row.customer_id}`} class="rounded-full px-4 py-2 text-sm font-semibold text-ink-600 underline dark:text-ink-300">Zum Kunden</a>
      )}
      <a href="/admin/rechnungen" class="rounded-full px-4 py-2 text-sm font-semibold text-ink-600 underline dark:text-ink-300">Zurück zur Liste</a>
    </div>
  </section>
</AdminLayout>
