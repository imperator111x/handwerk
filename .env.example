# Lokale Entwicklung mit Wrangler: Werte in `.dev.vars` eintragen (gitignored),
# NICHT in `.env`. Dies ist nur ein Hinweis, welche Secrets erwartet werden.

# Pflicht für Admin-Login (hash via `src/lib/auth.ts -> hashPassword` erzeugen)
ADMIN_PASSWORD_HASH=pbkdf2$210000$<salt-hex>$<hash-hex>

# Optional: Session-Signing (noch nicht aktiv genutzt, reserviert)
SESSION_SECRET=change-me

# Optional: Kontaktformular per E-Mail (Resend)
RESEND_API_KEY=re_xxx
CONTACT_TO_EMAIL=info@zeus-service.de
