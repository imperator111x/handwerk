/**
 * Wrangler-Konfiguration für die Zeus-Service-Website.
 *
 * Dokumentation:
 *   https://developers.cloudflare.com/workers/wrangler/configuration/
 *
 * Deployment:
 *   npm run build && npx wrangler deploy
 *
 * Secrets (Produktion) setzen:
 *   npx wrangler secret put ADMIN_PASSWORD_HASH
 *   npx wrangler secret put SESSION_SECRET
 *   npx wrangler secret put CONTACT_TO_EMAIL
 *   npx wrangler secret put RESEND_API_KEY   # optional, nur falls E-Mail-Versand genutzt wird
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zeus-service-web",
  "main": "./dist/_worker.js/index.js",
  "compatibility_date": "2026-10-19",
  "compatibility_flags": ["nodejs_compat"],

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },

  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true
    }
  },

  "vars": {
    "SITE_NAME": "Zeus-Service",
    "SITE_URL": "https://zeus-service.de",
    "ADMIN_USERNAME": "admin",
    "CONTACT_FROM_EMAIL": "website@zeus-service.de"
  }

  // Nach dem Anlegen über `npx wrangler d1 create zeus-service-db` einkommentieren:
  // "d1_databases": [
  //   {
  //     "binding": "DB",
  //     "database_name": "zeus-service-db",
  //     "database_id": "<AUTO-GENERATED-ID>"
  //   }
  // ],

  // Nach `npx wrangler kv namespace create SESSIONS` einkommentieren:
  // "kv_namespaces": [
  //   {
  //     "binding": "SESSIONS",
  //     "id": "<AUTO-GENERATED-ID>"
  //   }
  // ]
}
