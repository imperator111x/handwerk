/**
 * Wrangler-Konfiguration für die Zeus-Service-Website.
 *
 * Dokumentation:
 *   https://developers.cloudflare.com/workers/wrangler/configuration/
 *
 * Deployment:
 *   npm run build && npx wrangler deploy
 *
 * Secrets (Produktion) setzen:
 *   npx wrangler secret put ADMIN_PASSWORD_HASH
 *   npx wrangler secret put SESSION_SECRET
 *   # Optional: Benachrichtigung bei neuen Formularanfragen, und Resend nur als Fallback.
 *   # npx wrangler secret put CONTACT_TO_EMAIL
 *   # npx wrangler secret put RESEND_API_KEY
 *   npx wrangler secret put VIRUSTOTAL_API_KEY
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zeus-service-web",
  "main": "./src/worker.ts",
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    { "pattern": "zeus-service.de", "custom_domain": true },
    { "pattern": "www.zeus-service.de", "custom_domain": true }
  ],
  "compatibility_date": "2026-10-19",
  "compatibility_flags": ["nodejs_compat"],

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },

  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true
    }
  },

  "vars": {
    "SITE_NAME": "Zeus-Service",
    "SITE_URL": "https://zeus-service.de",
    "ADMIN_USERNAME": "admin",
    "CONTACT_FROM_EMAIL": "website@zeus-service.de",
    // Signierte Antwortadressen: r+<id>.<sig>@zeus-service.de
    // Eingehende Post kommt über Email Routing auf der Apex an.
    "REPLY_DOMAIN": "zeus-service.de",
    "TURNSTILE_SITEKEY": "0x4AAAAAAFbQmcogsMf7jRJx",
    "TURNSTILE_PAGE_SITEKEY": "0x4AAAAAAFbUcfcsc327engw",
    "TURNSTILE_HOSTNAMES": "zeus-service.de,www.zeus-service.de,zeus-service-web.imperator111x.workers.dev",
    "VAPID_PUBLIC_KEY": "BJARykY_MvAoxehtBX-EZx64PoL9nzU0AccYvLx1_KPU-8ALxl-b7bNE-BPL6r1QIyPiC92JWTpbWiFNAx5K0bw"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "zeus-service-db",
      "database_id": "34213140-a7f1-4579-9c3f-33b7fe584028"
    }
  ],

  "kv_namespaces": [
    {
      "binding": "SESSIONS",
      "id": "bec99176f19f47fc93c548a378e7e0b2"
    },
    {
      "binding": "FILES",
      "id": "6b28115b487e4ccab5eb71d1be4c3b06"
    }
  ],

  // Cloudflare Email Sending – Binding für Antwortmails aus dem Admin-Panel.
  // Setzt eine im Account onboardete Absender-Domain voraus
  // (siehe `wrangler email sending enable zeus-service.de` oder Dashboard).
  "triggers": {
    "crons": ["*/15 * * * *"]
  },

  "send_email": [
    {
      "name": "EMAIL"
    }
  ]
}
